def InstanceType.ofWire (text : String) : Except String InstanceType :=
  match List.find? (·.1 == text) InstanceType.wireValues with
  | Option.some (_, x) => .ok x
  | Option.none => .error s!"InstanceType has no value {text}"

instance : Key InstanceType := ⟨InstanceType.wire, InstanceType.ofWire⟩

instance : Shape InstanceType where
  schema := .string
  toValue x := .string x.wire
  ofValue
    | .string text => InstanceType.ofWire text
    | _ => .error "expected a string"

inductive InstanceTypeHypervisor where
  | nitro
  | xen
deriving DecidableEq, Repr, Inhabited

def InstanceTypeHypervisor.wire : InstanceTypeHypervisor → String
  | .nitro => "nitro"
  | .xen => "xen"

def InstanceTypeHypervisor.wireValues : List (String × InstanceTypeHypervisor) := [
  ("nitro", .nitro),
  ("xen", .xen)]

def InstanceTypeHypervisor.ofWire (text : String) : Except String InstanceTypeHypervisor :=
  match List.find? (·.1 == text) InstanceTypeHypervisor.wireValues with
  | Option.some (_, x) => .ok x
  | Option.none => .error s!"InstanceTypeHypervisor has no value {text}"

instance : Key InstanceTypeHypervisor := ⟨InstanceTypeHypervisor.wire, InstanceTypeHypervisor.ofWire⟩

instance : Shape InstanceTypeHypervisor where
  schema := .string
  toValue x := .string x.wire
  ofValue
    | .string text => InstanceTypeHypervisor.ofWire text
    | _ => .error "expected a string"

/-- The list of instance types with the specified instance attributes. -/
structure InstanceTypeInfoFromInstanceRequirements where
  /-- The matching instance type. -/
  instanceType : Option String := none
deriving DecidableEq, Repr, Inhabited

instance : Shape InstanceTypeInfoFromInstanceRequirements where
  schema := .struct "InstanceTypeInfoFromInstanceRequirements" [({ name := "InstanceType", xmlName := some "instanceType", queryName := some "InstanceType" }, .string)]
  toValue x := record [putOpt "InstanceType" x.instanceType]
  ofValue v := do
    let instanceType ← v.opt "InstanceType"
    return { instanceType }

/-- An instance type name or wildcard pattern in an instance type specification. -/
