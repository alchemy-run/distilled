  Eff.ask (api := api) .purgeQueue input

/-- Retrieves one or more messages (up to 10), from the specified queue. -/
def receiveMessage {ε : Type} (input : ReceiveMessageRequest) : Eff api ε (Except ReceiveMessageError ReceiveMessageResult) :=
  Eff.ask (api := api) .receiveMessage input

/-- Revokes any permissions in the queue policy that matches the specified Label parameter. -/
def removePermission {ε : Type} (input : RemovePermissionRequest) : Eff api ε (Except RemovePermissionError Unit) :=
  Eff.ask (api := api) .removePermission input

/-- Delivers a message to the specified queue. -/
def sendMessage {ε : Type} (input : SendMessageRequest) : Eff api ε (Except SendMessageError SendMessageResult) :=
  Eff.ask (api := api) .sendMessage input

/-- You can use SendMessageBatch to send up to 10 messages to the specified queue by assigning either identical or different values to each message (or by not assigning values at all). -/
def sendMessageBatch {ε : Type} (input : SendMessageBatchRequest) : Eff api ε (Except SendMessageBatchError SendMessageBatchResult) :=
  Eff.ask (api := api) .sendMessageBatch input

/-- Sets the value of one or more queue attributes, like a policy. -/
def setQueueAttributes {ε : Type} (input : SetQueueAttributesRequest) : Eff api ε (Except SetQueueAttributesError Unit) :=
  Eff.ask (api := api) .setQueueAttributes input

/-- Starts an asynchronous task to move messages from a specified source queue to a specified destination queue. -/
def startMessageMoveTask {ε : Type} (input : StartMessageMoveTaskRequest) : Eff api ε (Except StartMessageMoveTaskError StartMessageMoveTaskResult) :=
  Eff.ask (api := api) .startMessageMoveTask input

