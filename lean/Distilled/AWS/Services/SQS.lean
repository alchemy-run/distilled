/-- Adds a permission to a queue for a specific principal . -/
def addPermission {ε : Type} (input : AddPermissionRequest) : Eff api ε (Except AddPermissionError Unit) :=
  Eff.ask (api := api) .addPermission input

/-- Cancels a specified message movement task. -/
def cancelMessageMoveTask {ε : Type} (input : CancelMessageMoveTaskRequest) : Eff api ε (Except CancelMessageMoveTaskError CancelMessageMoveTaskResult) :=
  Eff.ask (api := api) .cancelMessageMoveTask input

/-- Changes the visibility timeout of a specified message in a queue to a new value. -/
def changeMessageVisibility {ε : Type} (input : ChangeMessageVisibilityRequest) : Eff api ε (Except ChangeMessageVisibilityError Unit) :=
  Eff.ask (api := api) .changeMessageVisibility input

/-- Changes the visibility timeout of multiple messages. -/
def changeMessageVisibilityBatch {ε : Type} (input : ChangeMessageVisibilityBatchRequest) : Eff api ε (Except ChangeMessageVisibilityBatchError ChangeMessageVisibilityBatchResult) :=
  Eff.ask (api := api) .changeMessageVisibilityBatch input

