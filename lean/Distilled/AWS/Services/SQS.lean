    | .tagQueue => fun v => (Shape.ofValue v : Except String Unit)
    | .untagQueue => fun v => (Shape.ofValue v : Except String Unit)
)
  (fun op => match op with
    | .addPermission => AddPermissionError.ofWire
    | .cancelMessageMoveTask => CancelMessageMoveTaskError.ofWire
    | .changeMessageVisibility => ChangeMessageVisibilityError.ofWire
    | .changeMessageVisibilityBatch => ChangeMessageVisibilityBatchError.ofWire
