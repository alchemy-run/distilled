def createQueue {ε : Type} (input : CreateQueueRequest) : Eff api ε (Except CreateQueueError CreateQueueResult) :=
  Eff.ask (api := api) .createQueue input

/-- Deletes the specified message from the specified queue. -/
def deleteMessage {ε : Type} (input : DeleteMessageRequest) : Eff api ε (Except DeleteMessageError Unit) :=
  Eff.ask (api := api) .deleteMessage input

/-- Deletes up to ten messages from the specified queue. -/
def deleteMessageBatch {ε : Type} (input : DeleteMessageBatchRequest) : Eff api ε (Except DeleteMessageBatchError DeleteMessageBatchResult) :=
  Eff.ask (api := api) .deleteMessageBatch input

/-- Deletes the queue specified by the QueueUrl , regardless of the queue's contents. -/
def deleteQueue {ε : Type} (input : DeleteQueueRequest) : Eff api ε (Except DeleteQueueError Unit) :=
  Eff.ask (api := api) .deleteQueue input

/-- Gets attributes for the specified queue. -/
def getQueueAttributes {ε : Type} (input : GetQueueAttributesRequest) : Eff api ε (Except GetQueueAttributesError GetQueueAttributesResult) :=
  Eff.ask (api := api) .getQueueAttributes input

/-- The GetQueueUrl API returns the URL of an existing Amazon SQS queue. -/
def getQueueUrl {ε : Type} (input : GetQueueUrlRequest) : Eff api ε (Except GetQueueUrlError GetQueueUrlResult) :=
  Eff.ask (api := api) .getQueueUrl input

/-- Returns a list of your queues that have the RedrivePolicy queue attribute configured with a dead-letter queue. -/
def listDeadLetterSourceQueues {ε : Type} (input : ListDeadLetterSourceQueuesRequest) : Eff api ε (Except ListDeadLetterSourceQueuesError ListDeadLetterSourceQueuesResult) :=
  Eff.ask (api := api) .listDeadLetterSourceQueues input

/-- Gets the most recent message movement tasks (up to 10) under a specific source queue. -/
def listMessageMoveTasks {ε : Type} (input : ListMessageMoveTasksRequest) : Eff api ε (Except ListMessageMoveTasksError ListMessageMoveTasksResult) :=
  Eff.ask (api := api) .listMessageMoveTasks input

/-- List all cost allocation tags added to the specified Amazon SQS queue. -/
def listQueueTags {ε : Type} (input : ListQueueTagsRequest) : Eff api ε (Except ListQueueTagsError ListQueueTagsResult) :=
  Eff.ask (api := api) .listQueueTags input

/-- Returns a list of your queues in the current region. -/
