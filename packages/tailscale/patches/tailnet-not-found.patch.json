{
  "description": "Type a tailnet the credential cannot reach as TailnetNotFound, distinct from a missing object's NotFound. Operations under /tailnet/{tailnet}/ answer 404 'tailnet \"<id>\" not found' (live, 2026-10-03).",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.tailscale.api#TailnetNotFound",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "smithy.api#documentation": "The credential cannot reach this tailnet: the tailnet ID is wrong, or the tailnet is one the credential has no access to (HTTP 404, 'tailnet \"<id>\" not found'). A missing object in a tailnet the credential can reach is NotFound instead.",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404,
              "message": {
                "matches": "^tailnet \".*\" not found$"
              }
            }
          ]
        }
      }
    },
