      "path": "/shapes/com.tailscale.api#SetLogStreamingConfiguration/errors/-",
      "value": {
        "target": "com.tailscale.api#FeatureNotAvailable"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.tailscale.api#DisableLogStreaming/errors/-",
      "value": {
        "target": "com.tailscale.api#FeatureNotAvailable"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.tailscale.api#SetCustomDevicePostureAttributes/errors/-",
      "value": {
