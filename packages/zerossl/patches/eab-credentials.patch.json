{
  "description": "What the ZeroSSL reference does not state. The EAB endpoint fails with `invalid_access_key` on a bad key and is rate limited (a `rate_limit` error type with Retry-After), but acme/error-codes.md lists neither; `success` is a boolean on the wire, and the docs' `1` is normalised by the protocol; the EAB HMAC key is a secret.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.zerossl.api#RateLimitExceeded",
      "value": {
        "type": "structure",
        "members": {
          "retryAfter": {
            "target": "smithy.api#Document",
            "traits": {
              "smithy.api#documentation": "Retry-After header parsed as an Effect Duration by the protocol."
            }
          },
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#retryable": {
            "throttling": true
          },
          "com.distilled.openapi#errorMatchers": [
            {
              "message": {
                "includes": "rate_limit"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.zerossl.api#GenerateEabCredentials/errors/0",
      "value": {
        "target": "com.zerossl.api#InvalidAccessKey"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.zerossl.api#GenerateEabCredentials/errors/-",
      "value": {
        "target": "com.zerossl.api#RateLimitExceeded"
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.zerossl.api#EabCredentials/members/success/target",
      "value": "smithy.api#Boolean"
    },
    {
      "op": "add",
      "path": "/shapes/com.zerossl.api#EabCredentials/members/eab_hmac_key/traits/smithy.api#sensitive",
      "value": {}
    }
  ]
}
