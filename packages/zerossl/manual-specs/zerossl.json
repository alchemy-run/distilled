          }
        }
      },
      "traits": {}
    },
    "com.zerossl.api#GenerateEabCredentials": {
      "type": "operation",
      "input": {
        "target": "smithy.api#Unit"
      },
      "output": {
        "target": "com.zerossl.api#EabCredentials"
      },
      "traits": {
        "smithy.api#http": {
          "method": "POST",
          "uri": "/acme/eab-credentials",
          "code": 200
        },
        "smithy.api#documentation": "Mint ACME External Account Binding credentials for this account\n\nReturns an EAB key id and HMAC key to bind a new ACME account to this ZeroSSL account (`newAccount` with `externalAccountBinding`). EAB credentials are reusable; store the returned pair securely instead of minting one per issuance."
      },
      "errors": [
