  },
  "shapes": {
    "com.zerossl.api#EabCredentials": {
      "type": "structure",
      "members": {
        "success": {
          "target": "smithy.api#Boolean",
          "traits": {
            "smithy.api#required": {}
          }
        },
        "eab_kid": {
          "target": "smithy.api#String",
          "traits": {
            "smithy.api#documentation": "The EAB key id.",
