          "target": "com.zerossl.api#GenerateEabCredentials"
        }
      ],
      "traits": {
        "smithy.api#title": "ZeroSSL REST API",
        "smithy.api#documentation": "Hand-authored from https://zerossl.com/documentation/api/. Auth is the account's access key, sent in the `Authorization: ApiKey` header by the protocol (never modeled as an input). Failures come back as `{ success: false, error: { code, type, info } }`, usually with HTTP 200 \u2014 the protocol treats `success: false` as an error and matches on `error.type`."
      }
    },
