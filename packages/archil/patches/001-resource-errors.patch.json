      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "smithy.api#documentation": "`not_found`: the disk, branch, sandbox, image, port token or API token named by the request does not exist, or the API key cannot see it. The message names which.",
          "com.distilled.openapi#errorMatchers": [
            {
