{
  "description": "Type the 400 E2B returns when deleting a template that running sandboxes use: \"cannot delete template '<id>' because there are running sandboxes using it\". Observed live 2026-11-03.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.e2b.templates#TemplateInUse",
      "value": {
        "type": "structure",
        "members": {
          "code": { "target": "smithy.api#Integer" },
          "message": { "target": "smithy.api#String" }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 400,
          "com.distilled.openapi#errorMatchers": [
            { "status": 400, "message": { "includes": "running sandboxes using it" } }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.e2b.templates#DeleteTemplatesTemplateID/errors",
      "value": [{ "target": "com.e2b.templates#TemplateInUse" }]
    }
  ]
}
