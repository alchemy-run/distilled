{
  "description": "Tags for what a caller branches on, from responses of the ghcr.io/mlflow/mlflow:v3.1.1 image, read 2026-11-01. A taken experiment name: 400 `{ \"error_code\": \"RESOURCE_ALREADY_EXISTS\", \"message\": \"Experiment 'e1' already exists.\" }`. Logging a param's key again with another value: 400 `{ \"error_code\": \"INVALID_PARAMETER_VALUE\", \"message\": \"Changing param values is not allowed. Param with key='p' was already logged ...\" }`. STACKIT's own instances have not been probed.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.stackit.model_experiments_mlflow#ExperimentAlreadyExists",
      "value": {
        "type": "structure",
        "members": { "message": { "target": "smithy.api#String" } },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 400,
          "com.distilled.openapi#errorMatchers": [
            { "status": 400, "body": { "/error_code": "RESOURCE_ALREADY_EXISTS" } }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.stackit.model_experiments_mlflow#CreateExperiment/errors/-",
      "value": { "target": "com.stackit.model_experiments_mlflow#ExperimentAlreadyExists" }
    },
    {
      "op": "add",
      "path": "/shapes/com.stackit.model_experiments_mlflow#ParamValueConflict",
      "value": {
        "type": "structure",
        "members": { "message": { "target": "smithy.api#String" } },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 400,
          "com.distilled.openapi#errorMatchers": [
            { "status": 400, "message": { "includes": "Changing param values is not allowed" } }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.stackit.model_experiments_mlflow#LogParam/errors/-",
      "value": { "target": "com.stackit.model_experiments_mlflow#ParamValueConflict" }
    }
  ]
}
