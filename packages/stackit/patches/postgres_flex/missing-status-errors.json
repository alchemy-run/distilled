          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 423,
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 423
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.stackit.postgres_flex#PreconditionFailed",
