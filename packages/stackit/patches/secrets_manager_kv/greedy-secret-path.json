{
  "description": "Vault secret paths span path segments (`app1/mysecret`, in docs.stackit.cloud/products/security/secrets-manager/how-tos/cli-and-api, read 2026-11-01), and Vault's routes take them as one tail. OpenAPI can't express a label that keeps its `/`, so the trimmed spec declares a plain label and this makes it greedy, which keeps each segment encoded but not the separators.",
  "patches": [
    {
      "op": "replace",
      "path": "/shapes/com.stackit.secrets_manager_kv#GetSecret/traits/smithy.api#http/uri",
      "value": "/v1/{mount}/data/{secretPath+}"
    },
    {
      "op": "replace",
      "path": "/shapes/com.stackit.secrets_manager_kv#PutSecret/traits/smithy.api#http/uri",
      "value": "/v1/{mount}/data/{secretPath+}"
    },
    {
      "op": "replace",
      "path": "/shapes/com.stackit.secrets_manager_kv#DeleteLatestSecretVersion/traits/smithy.api#http/uri",
      "value": "/v1/{mount}/data/{secretPath+}"
    },
    {
      "op": "replace",
      "path": "/shapes/com.stackit.secrets_manager_kv#DeleteSecretVersions/traits/smithy.api#http/uri",
      "value": "/v1/{mount}/delete/{secretPath+}"
    },
    {
      "op": "replace",
      "path": "/shapes/com.stackit.secrets_manager_kv#UndeleteSecretVersions/traits/smithy.api#http/uri",
      "value": "/v1/{mount}/undelete/{secretPath+}"
    },
    {
      "op": "replace",
      "path": "/shapes/com.stackit.secrets_manager_kv#DestroySecretVersions/traits/smithy.api#http/uri",
      "value": "/v1/{mount}/destroy/{secretPath+}"
    },
    {
      "op": "replace",
      "path": "/shapes/com.stackit.secrets_manager_kv#GetSecretMetadata/traits/smithy.api#http/uri",
      "value": "/v1/{mount}/metadata/{secretPath+}"
    },
    {
      "op": "replace",
      "path": "/shapes/com.stackit.secrets_manager_kv#PutSecretMetadata/traits/smithy.api#http/uri",
      "value": "/v1/{mount}/metadata/{secretPath+}"
    },
    {
      "op": "replace",
      "path": "/shapes/com.stackit.secrets_manager_kv#DeleteSecretMetadata/traits/smithy.api#http/uri",
      "value": "/v1/{mount}/metadata/{secretPath+}"
    },
    {
      "op": "replace",
      "path": "/shapes/com.stackit.secrets_manager_kv#ListSecrets/traits/smithy.api#http/uri",
      "value": "/v1/{mount}/metadata/{secretPath+}/"
    }
  ]
}
