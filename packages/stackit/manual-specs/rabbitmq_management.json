          "product_version": {
            "type": "string"
          },
          "rabbitmq_version": {
            "type": "string"
          },
          "management_version": {
            "type": "string"
          },
          "erlang_version": {
            "type": "string"
          },
          "object_totals": {
            "$ref": "#/components/schemas/ObjectTotals"
          },
          "queue_totals": {
            "$ref": "#/components/schemas/QueueTotals"
          }
        }
      },
      "ObjectTotals": {
        "type": "object",
        "properties": {
          "channels": {
            "type": "integer"
          },
          "connections": {
            "type": "integer"
          },
          "consumers": {
            "type": "integer"
          },
          "exchanges": {
            "type": "integer"
          },
          "queues": {
            "type": "integer"
          }
        }
      },
      "QueueTotals": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "integer"
          },
          "messages_ready": {
            "type": "integer"
          },
          "messages_unacknowledged": {
            "type": "integer"
          }
        }
      },
      "Queue": {
        "type": "object",
        "required": ["name", "vhost"],
        "properties": {
          "name": {
            "type": "string"
          },
          "vhost": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "`classic`, `quorum` or `stream`."
          },
          "state": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "durable": {
            "type": "boolean"
          },
          "auto_delete": {
            "type": "boolean"
          },
          "exclusive": {
            "type": "boolean"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          },
          "messages": {
            "type": "integer",
            "description": "Absent until the broker's first stats sample of the queue."
          },
          "messages_ready": {
            "type": "integer"
          },
          "messages_unacknowledged": {
            "type": "integer"
          },
          "consumers": {
            "type": "integer"
          }
        }
      },
      "PutQueueRequest": {
        "type": "object",
        "properties": {
          "durable": {
            "type": "boolean"
          },
          "auto_delete": {
            "type": "boolean"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "GetMessagesRequest": {
        "type": "object",
        "required": ["count", "ackmode", "encoding"],
        "properties": {
          "count": {
            "type": "integer",
            "description": "Most messages to fetch. Fewer come back if the queue can't provide them immediately."
          },
          "ackmode": {
            "type": "string",
            "enum": [
              "ack_requeue_true",
              "reject_requeue_true",
              "ack_requeue_false",
              "reject_requeue_false"
            ],
            "description": "`*_requeue_true` puts the messages back; `*_requeue_false` removes them."
          },
          "encoding": {
            "type": "string",
            "enum": ["auto", "base64"],
            "description": "`auto` returns the payload as a string when it is valid UTF-8, else as base64."
          },
          "truncate": {
            "type": "integer",
            "description": "Cut payloads larger than this many bytes."
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "payload",
          "payload_encoding",
          "payload_bytes",
          "redelivered",
          "exchange",
          "routing_key",
          "message_count",
          "properties"
        ],
        "properties": {
          "payload": {
            "type": "string"
          },
          "payload_encoding": {
            "type": "string",
            "enum": ["string", "base64"]
          },
          "payload_bytes": {
            "type": "integer"
          },
          "redelivered": {
            "type": "boolean"
          },
          "exchange": {
            "type": "string"
          },
          "routing_key": {
            "type": "string"
          },
          "message_count": {
            "type": "integer",
            "description": "Messages left in the queue after this one."
          },
          "properties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "QueueBinding": {
        "type": "object",
        "required": [
          "source",
          "vhost",
          "destination",
          "destination_type",
          "routing_key",
          "properties_key"
        ],
        "properties": {
          "source": {
            "type": "string",
            "description": "Exchange; empty for the default exchange."
          },
          "vhost": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "destination_type": {
            "type": "string"
          },
          "routing_key": {
            "type": "string"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          },
          "properties_key": {
            "type": "string",
            "description": "Names this binding on delete."
          }
        }
      },
      "Exchange": {
        "type": "object",
        "required": ["name", "vhost", "type"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Empty for the default exchange."
          },
          "vhost": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "durable": {
            "type": "boolean"
          },
          "auto_delete": {
            "type": "boolean"
          },
          "internal": {
            "type": "boolean"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PutExchangeRequest": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "description": "`direct`, `fanout`, `topic`, `headers`, or a plugin's type."
          },
          "durable": {
            "type": "boolean"
          },
          "auto_delete": {
            "type": "boolean"
          },
          "internal": {
            "type": "boolean"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "PublishMessageRequest": {
        "type": "object",
        "required": ["properties", "routing_key", "payload", "payload_encoding"],
        "properties": {
          "properties": {
            "type": "object",
            "additionalProperties": true
          },
          "routing_key": {
            "type": "string"
          },
          "payload": {
            "type": "string"
          },
          "payload_encoding": {
            "type": "string",
            "enum": ["string", "base64"]
          }
        }
      },
      "PublishMessageResponse": {
        "type": "object",
        "required": ["routed"],
        "properties": {
          "routed": {
            "type": "boolean",
            "description": "Whether at least one queue took the message."
          }
        }
      },
      "CreateQueueBindingRequest": {
        "type": "object",
        "properties": {
          "routing_key": {
            "type": "string"
          },
          "arguments": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
