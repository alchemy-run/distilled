          "client_token": {
            "type": "string",
            "description": "The token, sent as `X-Vault-Token`."
          },
          "accessor": {
            "type": "string",
            "description": "Accessor of the token."
          },
          "lease_duration": {
            "type": "integer",
            "format": "int64",
            "description": "Lifetime of the token in seconds."
          },
          "renewable": {
            "type": "boolean",
            "description": "Whether the token can be renewed."
          },
          "policies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Policies attached to the token."
          }
        },
        "required": ["client_token", "lease_duration", "renewable"]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "auth": {
            "$ref": "#/components/schemas/LoginAuth"
          }
        },
        "required": ["auth"]
      },
      "SecretVersionMetadata": {
        "type": "object",
        "description": "Metadata of one secret version.",
        "properties": {
          "created_time": {
            "type": "string",
            "description": "When this version was created."
          },
          "custom_metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "User-provided key-value pairs of the secret, shared by its versions.",
            "nullable": true
          },
          "deletion_time": {
            "type": "string",
            "description": "When this version is or was deleted; empty when it isn't."
          },
          "destroyed": {
            "type": "boolean",
            "description": "Whether this version's data was permanently destroyed."
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "The version number."
          }
        },
        "required": ["version"]
      },
      "SecretData": {
        "type": "object",
        "description": "The key-value pairs of a secret version.",
        "additionalProperties": {}
      },
      "GetSecretData": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SecretData"
          },
          "metadata": {
            "$ref": "#/components/schemas/SecretVersionMetadata"
          }
        },
        "required": ["data", "metadata"]
      },
      "GetSecretResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/GetSecretData"
          }
        },
        "required": ["data"]
      },
      "PutSecretOptions": {
        "type": "object",
        "description": "Options of the write.",
        "properties": {
          "cas": {
            "type": "integer",
            "description": "Check-and-set. 0 writes only if the key doesn't exist; a non-zero value writes only if it is the key's current version."
          }
        }
      },
      "PutSecretRequest": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SecretData"
          },
          "options": {
            "$ref": "#/components/schemas/PutSecretOptions"
          }
        },
        "required": ["data"]
      },
      "PutSecretResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SecretVersionMetadata"
          }
        },
        "required": ["data"]
      },
      "SecretVersionsRequest": {
        "type": "object",
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "The versions to act on."
          }
        },
        "required": ["versions"]
      },
      "SecretMetadata": {
        "type": "object",
        "properties": {
          "cas_required": {
            "type": "boolean",
            "description": "Whether every write must set `cas`."
          },
          "created_time": {
            "type": "string",
            "description": "When the secret was created."
          },
          "current_version": {
            "type": "integer",
            "format": "int64",
            "description": "The latest version."
          },
          "custom_metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "User-provided key-value pairs that are used to describe arbitrary and version-agnostic information about a secret.",
            "nullable": true
          },
          "delete_version_after": {
            "type": "string",
            "description": "The length of time before a version is deleted."
          },
          "max_versions": {
            "type": "integer",
            "format": "int64",
            "description": "The number of versions to keep"
          },
          "oldest_version": {
            "type": "integer",
            "format": "int64",
            "description": "The oldest version kept."
          },
          "updated_time": {
            "type": "string",
            "description": "When the secret last changed."
          },
          "versions": {
            "type": "object",
            "description": "State of each version, by version number.",
            "additionalProperties": {
              "$ref": "#/components/schemas/SecretVersionState"
            }
          }
        },
        "required": ["current_version"]
      },
      "SecretVersionState": {
        "type": "object",
        "properties": {
          "created_time": {
            "type": "string"
          },
          "deletion_time": {
            "type": "string"
          },
          "destroyed": {
            "type": "boolean"
          }
        }
      },
      "GetSecretMetadataResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SecretMetadata"
          }
        },
        "required": ["data"]
      },
      "PutSecretMetadataRequest": {
        "type": "object",
        "properties": {
          "cas_required": {
            "type": "boolean",
            "description": "If true the key will require the cas parameter to be set on all write requests. If false, the backend’s configuration will be used."
          },
          "custom_metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "User-provided key-value pairs that are used to describe arbitrary and version-agnostic information about a secret."
          },
          "delete_version_after": {
            "type": "string",
            "description": "The length of time before a version is deleted. If not set, the backend's configured delete_version_after is used. Cannot be greater than the backend's delete_version_after. A zero duration clears the current setting. A negative duration will cause an error."
          },
          "max_versions": {
            "type": "integer",
            "description": "The number of versions to keep. If not set, the backend’s configured max version is used."
          }
        }
      },
      "ListSecretsData": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The keys. Those ending in `/` are folders."
          }
        },
        "required": ["keys"]
      },
      "ListSecretsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ListSecretsData"
          }
        },
        "required": ["data"]
      }
    }
  }
}
