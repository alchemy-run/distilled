{
  "name": "@distilled.cloud/stackit",
  "version": "1.0.0-rc.18",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchemy-run/distilled",
    "directory": "packages/stackit"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "distilled-lazy": "./lib/index.lazy.js",
      "default": "./lib/index.js"
    },
    "./CloudFoundry": {
      "types": "./lib/cloud-foundry.d.ts",
      "bun": "./src/cloud-foundry.ts",
      "worker": "./src/cloud-foundry.ts",
      "default": "./lib/cloud-foundry.js"
    },
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "worker": "./src/credentials.ts",
      "default": "./lib/credentials.js"
    },
    "./Dremio": {
      "types": "./lib/dremio.d.ts",
      "bun": "./src/dremio.ts",
      "worker": "./src/dremio.ts",
      "default": "./lib/dremio.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "worker": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Forgejo": {
      "types": "./lib/forgejo.d.ts",
      "bun": "./src/forgejo.ts",
      "worker": "./src/forgejo.ts",
      "default": "./lib/forgejo.js"
    },
    "./OpenSearch": {
      "types": "./lib/opensearch.d.ts",
      "bun": "./src/opensearch.ts",
      "worker": "./src/opensearch.ts",
      "default": "./lib/opensearch.js"
    },
    "./Pagination": {
      "types": "./lib/pagination.d.ts",
      "bun": "./src/pagination.ts",
      "worker": "./src/pagination.ts",
      "default": "./lib/pagination.js"
    },
    "./Protocol": {
      "types": "./lib/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "worker": "./src/protocol.ts",
      "default": "./lib/protocol.js"
    },
    "./Retry": {
      "types": "./lib/retry.d.ts",
      "bun": "./src/retry.ts",
      "worker": "./src/retry.ts",
      "default": "./lib/retry.js"
    },
    "./Traits": {
      "types": "./lib/traits.d.ts",
      "bun": "./src/traits.ts",
      "worker": "./src/traits.ts",
      "default": "./lib/traits.js"
    },
    "./WorkflowsAirflow": {
      "types": "./lib/workflows-airflow.d.ts",
      "bun": "./src/workflows-airflow.ts",
      "worker": "./src/workflows-airflow.ts",
      "default": "./lib/workflows-airflow.js"
    },
    "./Vault": {
      "types": "./lib/vault.d.ts",
      "bun": "./src/vault.ts",
      "worker": "./src/vault.ts",
      "default": "./lib/vault.js"
    },
    "./*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "worker": "./src/services/*.ts",
      "distilled-lazy": "./lib/services.lazy/*.js",
      "default": "./lib/services/*.js"
    }
  },
  "scripts": {
    "build": "tsrs -b",
    "convert": "node --conditions=bun scripts/convert.ts",
    "generate": "node --conditions=bun scripts/generate.ts",
    "typecheck": "tsrs -p tsconfig.json",
    "specs:fetch": "git submodule update --force --init --depth=1 specs/spec-mirror-stackit",
    "specs:update": "git submodule update --remote --force --depth=1 specs/spec-mirror-stackit"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*"
  },
  "devDependencies": {
    "@distilled.cloud/dev": "workspace:*",
    "@types/node": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "distilled": {
    "generatedAt": "2026-11-01",
    "specUpdatedAt": "2026-10-30"
  }
}
