{
  "description": "Type the not-found and already-exists failures of the secret operations. Daytona's API (NestJS) throws NotFoundException (404) / ConflictException (409) with a `{ statusCode, message, error }` body; observed in the open-source daytonaio/daytona apps/api controllers/services at v0.190.0 (AGPL, archived June 2026). The OpenAPI document declares no error responses, so every failure surfaced as the generic status union. Each tag matches on status alone because every listed operation addresses exactly one resource of that kind by id or name. To be confirmed against the live API before merge.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.daytona.secret#SecretAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 409,
          "smithy.api#documentation": "A secret with that name already exists (HTTP 409).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 409
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.daytona.secret#SecretNotFound",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "smithy.api#documentation": "The secret does not exist (HTTP 404).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.daytona.secret#CreateSecret/errors",
      "before": "traits",
      "value": [
        {
          "target": "com.daytona.secret#SecretAlreadyExists"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.daytona.secret#DeleteSecret/errors",
      "before": "traits",
      "value": [
        {
          "target": "com.daytona.secret#SecretNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.daytona.secret#GetSecret/errors",
      "before": "traits",
      "value": [
        {
          "target": "com.daytona.secret#SecretNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.daytona.secret#UpdateSecret/errors",
      "before": "traits",
      "value": [
        {
          "target": "com.daytona.secret#SecretNotFound"
        }
      ]
    }
  ]
}
