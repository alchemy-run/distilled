{
  "description": "Type the not-ready rejection: startComputerUse answers HTTP 503 \"computer-use plugin is still loading or failed to initialize\" when called soon after the sandbox starts, before the desktop plugin has loaded (observed live 2026-11-06).",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.daytona.computer_use#ComputerUseNotReady",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "server",
          "smithy.api#httpError": 503,
          "smithy.api#documentation": "The sandbox's computer-use plugin is still loading, or failed to load (HTTP 503).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 503,
              "message": {
                "includes": "computer-use plugin is still loading"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.daytona.computer_use#StartComputerUse/errors",
      "value": [
        {
          "target": "com.daytona.computer_use#ComputerUseNotReady"
        }
      ]
    }
  ]
}
