{
  "description": "Type the not-found and already-exists failures of the api_keys operations. Daytona's API (NestJS) throws NotFoundException (404) / ConflictException (409) with a `{ statusCode, message, error }` body; observed in the open-source daytonaio/daytona apps/api controllers/services at v0.190.0 (AGPL, archived June 2026). The OpenAPI document declares no error responses, so every failure surfaced as the generic status union. Each tag matches on status alone because every listed operation addresses exactly one resource of that kind by id or name. To be confirmed against the live API before merge.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.daytona.api_keys#ApiKeyAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 409,
          "smithy.api#documentation": "A api key with that name already exists (HTTP 409).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 409
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.daytona.api_keys#ApiKeyNotFound",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "smithy.api#documentation": "The api key does not exist (HTTP 404).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.daytona.api_keys#CreateApiKey/errors",
      "before": "traits",
      "value": [
        {
          "target": "com.daytona.api_keys#ApiKeyAlreadyExists"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.daytona.api_keys#DeleteApiKey/errors",
      "before": "traits",
      "value": [
        {
          "target": "com.daytona.api_keys#ApiKeyNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.daytona.api_keys#DeleteApiKeyForUser/errors",
      "before": "traits",
      "value": [
        {
          "target": "com.daytona.api_keys#ApiKeyNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.daytona.api_keys#GetApiKey/errors",
      "before": "traits",
      "value": [
        {
          "target": "com.daytona.api_keys#ApiKeyNotFound"
        }
      ]
    }
  ]
}
