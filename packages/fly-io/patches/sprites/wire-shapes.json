      "value": { "type": "list", "member": { "target": "smithy.api#String" }, "traits": {} }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.sprites#SpriteEnvExecuteCommandRequestEnvList",
      "value": { "type": "list", "member": { "target": "smithy.api#String" }, "traits": {} }
    },
    {
      "op": "replace",
      "path": "/shapes/com.flyio.sprites#SpriteEnvExecuteCommandRequest/members/cmd/target",
      "value": "com.flyio.sprites#SpriteEnvExecuteCommandRequestCmdList"
