{
  "description": "Type Tigris's recently-deleted-name rejection on createAddOn. Tigris blocks a bucket name for several minutes after its delete, and Fly forwards the refusal.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.flyio.addons#TigrisBucketNameUnavailable",
      "value": {
        "type": "structure",
        "members": {
          "code": { "target": "smithy.api#Integer" },
          "message": { "target": "smithy.api#String" }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.distilled.openapi#errorMatchers": [
            {
              "message": {
                "includes": "recently deleted and unavailable for creation"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.addons#CreateAddOn/errors",
      "value": [
        {
          "target": "com.flyio.addons#TigrisBucketNameUnavailable"
        }
      ]
    }
  ]
}
