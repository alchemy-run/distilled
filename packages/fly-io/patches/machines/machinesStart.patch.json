{
  "description": "Type Conflict (409), the created-state start precondition (message-only), and the observed replacing-state start precondition (412).",
  "patches": [
    {
      "op": "add",
      "path": "/paths/~1v1~1apps~1{app_name}~1machines~1{machine_id}~1start/post/responses/409",
      "value": {
        "description": "Conflict"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#MachineStartFromCreatedState",
      "value": {
        "type": "structure",
        "members": {
          "message": { "target": "smithy.api#String" }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.distilled.openapi#errorMatchers": [
            {
              "message": "failed_precondition: unable to start machine from current state: 'created'"
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#StartMachine/errors/-",
      "value": {
        "target": "com.flyio.machines#MachineStartFromCreatedState"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#MachineReplacing",
      "value": {
        "type": "structure",
        "members": {
          "message": { "target": "smithy.api#String" }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 412,
              "message": "failed_precondition: machine getting replaced, refusing to start"
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#StartMachine/errors/-",
      "value": { "target": "com.flyio.machines#MachineReplacing" }
    }
  ]
}
