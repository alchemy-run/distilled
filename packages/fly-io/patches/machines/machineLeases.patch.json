    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#SuspendMachine/errors/-",
      "value": { "target": "com.flyio.machines#Conflict" }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#RestartMachine/errors/-",
      "value": { "target": "com.flyio.machines#Conflict" }
    }
  ]
