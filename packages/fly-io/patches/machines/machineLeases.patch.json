{
  "description": "Match fly-go lease envelopes, query TTL and native nonce headers. Native leases guard target mutations, not metadata or Machine creation.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#MachineLease",
      "value": {
        "type": "structure",
        "members": {
          "status": {
            "target": "smithy.api#String"
          },
          "data": {
            "target": "com.flyio.machines#Lease"
          }
        }
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.flyio.machines#MachinesCreateLease/output/target",
      "value": "com.flyio.machines#MachineLease"
    },
    {
      "op": "replace",
      "path": "/shapes/com.flyio.machines#MachinesShowLease/output/target",
      "value": "com.flyio.machines#MachineLease"
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#MachinesCreateLeaseRequest/members/ttl/traits/smithy.api#httpQuery",
      "value": "ttl"
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#MachinesCreateLeaseRequest/members/lease_nonce",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#httpHeader": "fly-machine-lease-nonce",
          "smithy.api#documentation": "Existing lease nonce when refreshing; omit to acquire a new lease. Keep the nonce private."
        }
      }
    },
    {
      "op": "add",
