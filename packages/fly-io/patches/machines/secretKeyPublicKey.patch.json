{
  "description": "Wire public_key is a base64 string, not an integer array. Observed on secretkeyGenerate/Get/List.",
  "patches": [
    {
      "op": "remove",
      "path": "/shapes/com.flyio.machines#SecretKeyPublicKeyList"
    },
    {
      "op": "remove",
      "path": "/shapes/com.flyio.machines#SetSecretkeyResponsePublicKeyList"
    },
    {
      "op": "replace",
      "path": "/shapes/com.flyio.machines#SecretKey/members/public_key/target",
      "value": "smithy.api#String"
    },
    {
      "op": "replace",
      "path": "/shapes/com.flyio.machines#SetSecretkeyResponse/members/public_key/target",
      "value": "smithy.api#String"
    }
  ]
}
