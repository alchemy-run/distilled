{
  "description": "Preserve the published IP assignment shapes when regenerating from the pinned spec mirror, which predates the generated egress-IP response schema.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#IPAssignment/members/egress",
      "value": { "target": "smithy.api#Boolean" }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#IPAssignmentType",
      "value": {
        "type": "enum",
        "members": {
          "V4": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "v4" }
          },
          "V6": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "v6" }
          },
          "SHARED_V4": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "shared_v4" }
          },
          "PRIVATE_V6": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "private_v6" }
          },
          "EGRESS_V4": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "egress_v4" }
          },
          "EGRESS_V6": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "egress_v6" }
          },
          "EGRESS_PAIR": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "egress_pair" }
          }
        },
        "traits": {
          "smithy.api#documentation": "Type of IP address to allocate. \"egress-pair\" allocates both v4 and v6 egress IP addresses (recommended when using egress IPs)."
        }
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.flyio.machines#CreateAppIPAssignmentRequest/members/type/target",
      "value": "com.flyio.machines#IPAssignmentType"
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#AssignIPResponse",
      "value": {
        "type": "structure",
        "members": {
          "created_at": { "target": "smithy.api#String" },
          "egress": { "target": "smithy.api#Boolean" },
          "ip": { "target": "smithy.api#String" },
          "ip_pair": {
            "target": "com.flyio.machines#IPPair",
            "traits": {
              "smithy.api#documentation": "ip_pair is returned when \"egress-pair\" IP type is requested; in this case, ip is null."
            }
          },
          "region": { "target": "smithy.api#String" },
          "service_name": { "target": "smithy.api#String" },
          "shared": { "target": "smithy.api#Boolean" }
        },
        "traits": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#IPPair",
      "value": {
        "type": "structure",
        "members": {
          "v4": { "target": "smithy.api#String" },
          "v6": { "target": "smithy.api#String" }
        },
        "traits": {}
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.flyio.machines#CreateAppIPAssignment/output/target",
      "value": "com.flyio.machines#AssignIPResponse"
    }
  ]
}
