{
  "description": "Keep the existing 408 response and type waitMachine's observed deadline_exceeded state-wait failure as MachineWaitTimeout. Match the message pattern without assuming an HTTP status.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#MachinesWait/errors/2",
      "value": {
        "target": "com.flyio.machines#GatewayTimeout"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#GatewayTimeout",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 408,
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 408
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#MachineWaitTimeout",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.distilled.openapi#errorMatchers": [
            {
              "message": {
                "matches": "^deadline_exceeded: machine failed to reach desired state, [a-z_]+, currently [a-z_]+$"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.flyio.machines#MachinesWait/errors/-",
      "value": {
        "target": "com.flyio.machines#MachineWaitTimeout"
      }
    }
  ]
}
