          "smithy.api#httpError": 404,
          "smithy.api#documentation": "Dev Center data plane: the dev box pool does not exist in the project. Azure error code: `PoolNotFound` /",
          "com.distilled.openapi#errorMatchers": [
            {
              "body": {
                "/error/code": "PoolNotFound"
              }
            }
