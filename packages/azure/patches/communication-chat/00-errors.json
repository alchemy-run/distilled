{
  "description": "Chat answers a missing thread with HTTP 404 and a forbidden one with HTTP 403 in a `{ CommunicationError: { Code, Message } }` envelope (not ARM's `error`), and a rejected user token with HTTP 401 and an empty body. Type all three per operation.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.azure.communication_chat#ChatThreadNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The service's error code."
            }
          },
          "message": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The service's error message."
            }
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "smithy.api#documentation": "The chat thread does not exist (HTTP 404 `CommunicationError.Code` `NotFound`).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404,
              "body": {
                "/CommunicationError/Code": "NotFound"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.communication_chat#ChatThreadAccessDenied",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The service's error code."
            }
          },
          "message": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The service's error message."
            }
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 403,
          "smithy.api#documentation": "The token's user is not a participant of the chat thread (HTTP 403 `CommunicationError.Code` `Forbidden`).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 403,
              "body": {
                "/CommunicationError/Code": "Forbidden"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.communication_chat#ChatUserTokenRejected",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#String",
            "traits": {
