            }
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 401,
          "smithy.api#documentation": "The user access token is missing, malformed, expired, revoked, or not a Communication Services user token (HTTP 401 with an empty body; Chat accepts no Microsoft Entra tokens).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 401
            }
          ]
        }
      }
    },
