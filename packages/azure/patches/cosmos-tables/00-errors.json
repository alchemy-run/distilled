{
  "description": "Table service errors arrive as `{\"odata.error\":{\"code\":...}}` with no `x-ms-error-code` header, so the client-level code map never sees them (404/409 surface as bare status classes, 412 as UnknownAzureError and is retried as a server error). Declare the observed codes as typed per-operation errors matched on the body code.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.azure.cosmos_tables#TableEntityNotFound",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The service's error message."
            }
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "smithy.api#documentation": "The entity does not exist (HTTP 404 `ResourceNotFound` in the `odata.error` body).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404,
              "body": {
                "/odata.error/code": "ResourceNotFound"
              }
            }
          ]
        }
      }
    },
    {
