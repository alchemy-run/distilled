      "path": "/shapes/com.azure.keyvault_certificates#CertificateNotFound",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "smithy.api#documentation": "Returned by the Key Vault certificates data plane when the certificate (or deleted certificate) does not exist. Azure error code: `CertificateNotFound` /",
          "com.distilled.openapi#errorMatchers": [
            {
              "body": {
                "/error/code": "CertificateNotFound"
              }
            }
          ],
          "distilled.errors#categories": ["NotFoundError"]
        }
      }
    },
    {
