{
  "description": "Type the Schema Registry data-plane errors callers handle: 401/403 while the caller has no Schema Registry role (or while a new role assignment propagates), and the 404 `ItemNotFound` for a missing schema, version, or group.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#SchemaRegistryAccessDenied",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The service's error message."
            }
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 401,
          "smithy.api#documentation": "The caller's Entra principal has no Schema Registry role that allows the action on this schema group or namespace (HTTP 401 `Authorization failed for specified action`, or 403). A new role assignment can take a few minutes to apply.",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 401
            },
            {
              "status": 403
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#SchemaNotFound",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The service's error message."
            }
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "smithy.api#documentation": "The schema, schema version, or schema group does not exist (HTTP 404 `ItemNotFound`). `GetSchemaPropertiesByContent` also answers it when no version of the schema has this content.",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#GetSchemaById/errors",
      "value": [
        {
          "target": "com.azure.schemaregistry_data#SchemaRegistryAccessDenied"
        },
        {
          "target": "com.azure.schemaregistry_data#SchemaNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#GetSchemaByVersion/errors",
      "value": [
        {
          "target": "com.azure.schemaregistry_data#SchemaRegistryAccessDenied"
        },
        {
          "target": "com.azure.schemaregistry_data#SchemaNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#GetSchemaPropertiesByContent/errors",
      "value": [
        {
          "target": "com.azure.schemaregistry_data#SchemaRegistryAccessDenied"
        },
        {
          "target": "com.azure.schemaregistry_data#SchemaNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#ListSchemaGroups/errors",
      "value": [
        {
          "target": "com.azure.schemaregistry_data#SchemaRegistryAccessDenied"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#ListSchemaVersions/errors",
      "value": [
