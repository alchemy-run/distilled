    },
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#GetSchemaByVersionResponse/members/schemaName",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#httpHeader": "Schema-Name",
          "smithy.api#documentation": "References a specific schema in the registry namespace."
