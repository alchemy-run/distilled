      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#GetSchemaByVersion/traits/smithy.api#http/headers",
      "value": {
        "Accept": "application/json; serialization=Avro, application/json; serialization=Json, text/plain; charset=utf-8, text/vnd.ms.protobuf, application/json"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#GetSchemaByVersionResponse/members/schemaId",
