{
  "description": "GetSchemaByVersion returns the schema as raw text (the spec's `type: file` became a parsed JSON document) with its format and identity from the response headers, and sends an Accept header listing every schema format the spec produces.",
  "patches": [
    {
      "op": "replace",
      "path": "/shapes/com.azure.schemaregistry_data#GetSchemaByVersionResponse/members/body",
      "value": {
        "target": "smithy.api#Blob",
        "traits": {
          "smithy.api#httpPayload": {},
          "smithy.api#required": {},
          "smithy.api#documentation": "The schema text, UTF-8 encoded."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#GetSchemaByVersionResponse/members/contentType",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#httpHeader": "Content-Type",
          "smithy.api#documentation": "Format of the schema: `application/json; serialization=Avro`, `application/json; serialization=Json`, `text/plain; charset=utf-8` (custom), or `text/vnd.ms.protobuf`."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.schemaregistry_data#GetSchemaByVersionResponse/members/location",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#httpHeader": "Location",
          "smithy.api#documentation": "URL location of schema, identified by schema group, schema name, and version."
