          },
          "dataDisks": {
            "target": "com.azure.devopsinfrastructure#DataDiskList",
            "traits": {
              "smithy.api#documentation": "A list of empty data disks to attach."
            }
          }
        },
        "traits": {
          "smithy.api#documentation": "The storage profile of the VMSS."
        }
      }
    },
