{
  "description": "OrganizationProfile (AzureDevOps|GitHub), AgentProfile (Stateless|Stateful), ResourcePredictionsProfile (Manual|Automatic) and FabricProfile (Vmss) are polymorphic on `kind`; the converted model keeps only `kind`, so every subtype field (organizations, permissionProfile, maxAgentLifetime, sku, images, osProfile, storageProfile, networkProfile, predictionPreference) is stripped on encode and decode and no pool can be created. Flatten the subtype members onto the base shapes. `organizations` is a Document because its element shape differs between AzureDevOps and GitHub.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.azure.devopsinfrastructure#PoolStringList",
      "value": {
        "type": "list",
        "member": {
          "target": "smithy.api#String"
        },
        "traits": {
          "smithy.api#documentation": "A list of strings."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.devopsinfrastructure#AzureDevOpsPermissionProfile",
      "value": {
        "type": "structure",
        "members": {
          "kind": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Determines who has admin permissions to the Azure DevOps pool (CreatorOnly, Inherit, SpecificAccounts).",
              "smithy.api#required": {}
            }
          },
          "users": {
            "target": "com.azure.devopsinfrastructure#PoolStringList",
            "traits": {
              "smithy.api#documentation": "User email addresses."
            }
          },
          "groups": {
            "target": "com.azure.devopsinfrastructure#PoolStringList",
            "traits": {
              "smithy.api#documentation": "Group email addresses."
            }
          }
        },
        "traits": {
          "smithy.api#documentation": "Defines the type of Azure DevOps pool permission."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.devopsinfrastructure#DevOpsAzureSku",
      "value": {
        "type": "structure",
        "members": {
          "name": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The Azure SKU name of the machines in the pool.",
              "smithy.api#required": {}
            }
          }
        },
        "traits": {
          "smithy.api#documentation": "The Azure SKU of the machines in the pool."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.devopsinfrastructure#PoolImage",
      "value": {
        "type": "structure",
        "members": {
          "resourceId": {
            "target": "smithy.api#String",
