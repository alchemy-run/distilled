            }
          },
          "wellKnownImageName": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The image to use from a well-known set of images made available to customers."
            }
          },
          "aliases": {
            "target": "com.azure.devopsinfrastructure#PoolStringList",
            "traits": {
              "smithy.api#documentation": "List of aliases to reference the image by."
            }
          },
          "buffer": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The percentage of the buffer to be allocated to this image."
            }
          },
          "ephemeralType": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The ephemeral type of the image (Automatic, CacheDisk, ResourceDisk)."
            }
          }
        },
        "traits": {
          "smithy.api#documentation": "The VM image of the machines in the pool."
        }
      }
    },
