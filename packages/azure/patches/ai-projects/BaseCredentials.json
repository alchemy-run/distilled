{
  "description": "BaseCredentials is polymorphic on `type` (ApiKeyCredentials `key`, SASCredentials `SAS`), but the converted model keeps only the discriminator, so GetConnectionWithCredentials returns no secret. Add the subtype members.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.azure.ai_projects#BaseCredentials/members/key",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "For `type: \"ApiKey\"`: the API key."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.ai_projects#BaseCredentials/members/SAS",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "For `type: \"SAS\"`: the SAS token."
        }
      }
    }
  ]
}
