{
  "description": "Azure Maps reads these array query parameters as one comma-separated value (`collectionFormat: csv`, e.g. `query=47.64,-122.13`), but the converted model sends a list as repeated parameters (`query=47.64&query=-122.13`), which Maps rejects (`Coordinate pair count in query mismatches...`). Model each as the comma-separated string Maps expects.",
  "patches": [
    {
      "op": "replace",
      "path": "/shapes/com.azure.maps_render#RenderGetMapStaticImageRequest/members/center/target",
      "value": "smithy.api#String"
    },
    {
      "op": "replace",
      "path": "/shapes/com.azure.maps_render#RenderGetMapStaticImageRequest/members/bbox/target",
      "value": "smithy.api#String"
    },
    {
      "op": "replace",
      "path": "/shapes/com.azure.maps_render#RenderGetCopyrightFromBoundingBoxRequest/members/mincoordinates/target",
      "value": "smithy.api#String"
    },
    {
      "op": "replace",
      "path": "/shapes/com.azure.maps_render#RenderGetCopyrightFromBoundingBoxRequest/members/maxcoordinates/target",
      "value": "smithy.api#String"
    },
    {
      "op": "replace",
      "path": "/shapes/com.azure.maps_render#RenderGetMapAttributionRequest/members/bounds/target",
      "value": "smithy.api#String"
    }
  ]
}
