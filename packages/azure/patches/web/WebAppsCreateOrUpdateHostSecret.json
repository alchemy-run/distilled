{
  "description": "The spec models the host-secret PUT body as a bare KeyInfo `{ name, value }`, but Microsoft.Web rejects it with 400 'Properties object is not present in the request body.'; the service expects `{ properties: { name, value } }`. Wrap the body in `properties` for the production and slot operations.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.azure.web#HostSecretProperties",
      "value": {
        "type": "structure",
        "members": {
          "name": {
            "target": "smithy.api#String",
            "traits": { "smithy.api#documentation": "Key name" }
          },
          "value": {
            "target": "smithy.api#String",
            "traits": { "smithy.api#documentation": "Key value; omit it to have Azure generate one." }
          }
        },
        "traits": { "smithy.api#documentation": "Host key to create or update." }
      }
    },
    {
      "op": "remove",
      "path": "/shapes/com.azure.web#WebAppsCreateOrUpdateHostSecretRequest/members/value"
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.web#WebAppsCreateOrUpdateHostSecretRequest/members/properties",
      "value": {
        "target": "com.azure.web#HostSecretProperties",
        "traits": { "smithy.api#documentation": "The key to create or update." }
      }
    },
    {
      "op": "remove",
      "path": "/shapes/com.azure.web#WebAppsCreateOrUpdateHostSecretSlotRequest/members/value"
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.web#WebAppsCreateOrUpdateHostSecretSlotRequest/members/properties",
      "value": {
        "target": "com.azure.web#HostSecretProperties",
        "traits": { "smithy.api#documentation": "The key to create or update." }
      }
    }
  ]
}
