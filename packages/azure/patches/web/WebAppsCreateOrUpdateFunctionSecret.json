{
  "description": "Like the host-secret PUT, the spec models the function-secret PUT body as a bare KeyInfo `{ name, value }`, but Microsoft.Web expects `{ properties: { name, value } }`. Wrap the body in `properties` for the production and slot operations.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.azure.web#FunctionSecretProperties",
      "value": {
        "type": "structure",
        "members": {
          "name": {
            "target": "smithy.api#String",
            "traits": { "smithy.api#documentation": "Key name" }
          },
          "value": {
            "target": "smithy.api#String",
            "traits": { "smithy.api#documentation": "Key value; omit it to have Azure generate one." }
          }
        },
        "traits": { "smithy.api#documentation": "Function key to create or update." }
      }
    },
    {
      "op": "remove",
      "path": "/shapes/com.azure.web#WebAppsCreateOrUpdateFunctionSecretRequest/members/value"
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.web#WebAppsCreateOrUpdateFunctionSecretRequest/members/properties",
      "value": {
        "target": "com.azure.web#FunctionSecretProperties",
        "traits": { "smithy.api#documentation": "The key to create or update." }
      }
    },
    {
      "op": "remove",
      "path": "/shapes/com.azure.web#WebAppsCreateOrUpdateFunctionSecretSlotRequest/members/value"
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.web#WebAppsCreateOrUpdateFunctionSecretSlotRequest/members/properties",
      "value": {
        "target": "com.azure.web#FunctionSecretProperties",
        "traits": { "smithy.api#documentation": "The key to create or update." }
      }
    }
  ]
}
