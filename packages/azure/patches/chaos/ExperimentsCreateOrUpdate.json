            "traits": {
              "smithy.api#required": {},
              "smithy.api#documentation": "The name of the setting for the action."
            }
          },
          "value": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#required": {},
              "smithy.api#documentation": "The value of the setting for the action."
            }
          }
        },
        "traits": { "smithy.api#documentation": "A map to describe the settings of an action." }
      }
    },
    {
      "op": "add",
