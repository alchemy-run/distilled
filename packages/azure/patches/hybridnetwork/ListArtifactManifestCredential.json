{
  "description": "ArtifactManifest credentials are polymorphic on credentialType (AzureContainerRegistryScopedToken / AzureStorageAccountToken); the converted model keeps only the discriminator, so the ACR push credential (username, acrToken, acrServerUrl, repositories, expiry) and the storage SAS (containerCredentials) are stripped. Add the ACR members so publishers can push artifacts.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ListArtifactManifestCredentialResponse/members/username",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "The username of the ACR scoped token (`AzureContainerRegistryScopedToken`)."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ListArtifactManifestCredentialResponse/members/acrToken",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "The ACR scoped token password (`AzureContainerRegistryScopedToken`).",
          "smithy.api#sensitive": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ListArtifactManifestCredentialResponse/members/acrServerUrl",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "The ACR login server URL (`AzureContainerRegistryScopedToken`)."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ListArtifactManifestCredentialResponse/members/repositories",
      "value": {
        "target": "com.azure.hybridnetwork#NetworkFunctionPropertiesFormatRoleOverrideValuesList",
        "traits": {
          "smithy.api#documentation": "The repositories the token may push to (`AzureContainerRegistryScopedToken`)."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ListArtifactManifestCredentialResponse/members/expiry",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "The UTC time when the credential expires."
        }
      }
    }
  ]
}
