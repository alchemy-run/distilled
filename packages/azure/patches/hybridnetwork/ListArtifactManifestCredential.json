{
  "description": "ArtifactManifest credentials are polymorphic on credentialType (AzureContainerRegistryScopedToken / AzureStorageAccountToken); the converted model keeps only the discriminator, so the ACR push credential (username, acrToken, acrServerUrl, repositories, expiry) and the storage SAS (containerCredentials) are stripped. Add the ACR members and the storage-account members (containerCredentials, storageAccountId) so publishers can push artifacts to either store type.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ArtifactManifestsListCredentialResponse/members/username",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "The username of the ACR scoped token (`AzureContainerRegistryScopedToken`)."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ArtifactManifestsListCredentialResponse/members/acrToken",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "The ACR scoped token password (`AzureContainerRegistryScopedToken`).",
          "smithy.api#sensitive": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ArtifactManifestsListCredentialResponse/members/acrServerUrl",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "The ACR login server URL (`AzureContainerRegistryScopedToken`)."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ArtifactManifestsListCredentialResponse/members/repositories",
      "value": {
        "target": "com.azure.hybridnetwork#NetworkFunctionPropertiesFormatRoleOverrideValuesList",
        "traits": {
          "smithy.api#documentation": "The repositories the token may push to (`AzureContainerRegistryScopedToken`)."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ArtifactManifestsListCredentialResponse/members/expiry",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "The UTC time when the credential expires."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ArtifactManifestContainerCredential",
      "value": {
        "type": "structure",
        "members": {
          "containerName": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The storage container name."
            }
          },
          "containerSasUri": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The container SAS URI.",
              "smithy.api#sensitive": {}
            }
          },
          "expiry": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The UTC time when the container SAS expires."
            }
          }
        },
        "traits": {
          "smithy.api#documentation": "A storage container push credential (`AzureStorageAccountToken`)."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ArtifactManifestContainerCredentialList",
      "value": {
        "type": "list",
        "member": {
          "target": "com.azure.hybridnetwork#ArtifactManifestContainerCredential"
        },
        "traits": {
          "smithy.api#documentation": "Storage container push credentials."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ArtifactManifestsListCredentialResponse/members/containerCredentials",
      "value": {
        "target": "com.azure.hybridnetwork#ArtifactManifestContainerCredentialList",
        "traits": {
          "smithy.api#documentation": "The container SAS credentials (`AzureStorageAccountToken`)."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.hybridnetwork#ArtifactManifestsListCredentialResponse/members/storageAccountId",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "The storage account ARM ID (`AzureStorageAccountToken`)."
        }
      }
    }
  ]
}
