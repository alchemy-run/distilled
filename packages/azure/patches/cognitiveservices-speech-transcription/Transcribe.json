{
  "description": "Transcribe is a multipart/form-data upload of `definition` (JSON TranscriptionOptions) and an optional `audio` file part; the converter drops Swagger 2 formData parameters, so the request had no body at all and the service rejected every call.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.azure.cognitiveservices_speech_transcription#TranscriptionLocalesList",
      "value": { "type": "list", "member": { "target": "smithy.api#String" }, "traits": {} }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.cognitiveservices_speech_transcription#TranscriptionChannelsList",
      "value": { "type": "list", "member": { "target": "smithy.api#Integer" }, "traits": {} }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.cognitiveservices_speech_transcription#TranscriptionPhrasesList",
      "value": { "type": "list", "member": { "target": "smithy.api#String" }, "traits": {} }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.cognitiveservices_speech_transcription#TranscriptionPromptList",
      "value": { "type": "list", "member": { "target": "smithy.api#String" }, "traits": {} }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.cognitiveservices_speech_transcription#TranscriptionDiarizationOptions",
      "value": {
        "type": "structure",
        "members": {
          "enabled": { "target": "smithy.api#Boolean" },
          "maxSpeakers": {
            "target": "smithy.api#Integer",
            "traits": {
              "smithy.api#documentation": "Hint for the maximum number of speakers (2-35)."
            }
          }
        },
        "traits": {
          "smithy.api#documentation": "Speaker diarization settings; set them to enable diarization."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.cognitiveservices_speech_transcription#PhraseListProperties",
      "value": {
        "type": "structure",
        "members": {
          "phrases": {
            "target": "com.azure.cognitiveservices_speech_transcription#TranscriptionPhrasesList"
          },
          "biasingWeight": {
            "target": "smithy.api#Float",
            "traits": { "smithy.api#documentation": "Biasing weight (0.0-2.0)." }
          }
        },
        "traits": { "smithy.api#documentation": "Phrase list properties for transcription." }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.cognitiveservices_speech_transcription#EnhancedModeProperties",
      "value": {
        "type": "structure",
        "members": {
          "enabled": { "target": "smithy.api#Boolean" },
          "task": { "target": "smithy.api#String" },
          "targetLanguage": { "target": "smithy.api#String" },
          "prompt": {
            "target": "com.azure.cognitiveservices_speech_transcription#TranscriptionPromptList"
          }
        },
        "traits": { "smithy.api#documentation": "Enhanced mode properties for transcription." }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.cognitiveservices_speech_transcription#TranscriptionOptions",
      "value": {
        "type": "structure",
        "members": {
          "audioUrl": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "URL of the audio to transcribe; send it instead of the `audio` part."
            }
          },
          "locales": {
            "target": "com.azure.cognitiveservices_speech_transcription#TranscriptionLocalesList",
            "traits": {
              "smithy.api#documentation": "Candidate locales of the audio (e.g. `en-US`); omit to detect the language."
            }
          },
          "profanityFilterMode": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "`None`, `Removed`, `Tags`, or `Masked` (default)."
            }
          },
          "diarization": {
            "target": "com.azure.cognitiveservices_speech_transcription#TranscriptionDiarizationOptions"
          },
          "channels": {
            "target": "com.azure.cognitiveservices_speech_transcription#TranscriptionChannelsList",
            "traits": {
              "smithy.api#documentation": "0-based channels to transcribe separately (at most two)."
            }
          },
          "phraseList": {
            "target": "com.azure.cognitiveservices_speech_transcription#PhraseListProperties"
          },
          "enhancedMode": {
            "target": "com.azure.cognitiveservices_speech_transcription#EnhancedModeProperties"
          }
        },
        "traits": { "smithy.api#documentation": "Metadata for a transcription request." }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.cognitiveservices_speech_transcription#TranscribeRequest/members/definition",
      "value": {
        "target": "com.azure.cognitiveservices_speech_transcription#TranscriptionOptions",
        "traits": {
          "smithy.api#required": {},
          "smithy.api#documentation": "Transcription options, sent as the JSON `definition` part."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.cognitiveservices_speech_transcription#TranscribeRequest/members/audio",
      "value": {
        "target": "smithy.api#Blob",
        "traits": {
          "smithy.api#documentation": "Audio file bytes (under 2 hours and 250 MB); optional when `definition.audioUrl` is set."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.cognitiveservices_speech_transcription#Transcribe/traits/smithy.api#http/contentType",
      "value": "multipart"
    }
  ]
}
