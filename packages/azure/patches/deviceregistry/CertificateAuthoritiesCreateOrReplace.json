{
  "description": "The swagger models an intermediate CA's `issuer` on the `IntermediateCertificateAuthorityProperties` discriminator subtype (certificateAuthorityType=ICA), which the converter drops, so ICA certificate authorities cannot be created or read. Add the `issuer` member (flattened union of the Microsoft and External issuer subtypes) to the base properties shapes.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.azure.deviceregistry#CertificateAuthorityIssuerType",
      "value": {
        "type": "enum",
        "members": {
          "MICROSOFT": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "Microsoft" }
          },
          "EXTERNAL": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "External" }
          }
        },
        "traits": {
          "smithy.api#documentation": "The issuer type for an intermediate Certificate Authority."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.deviceregistry#CertificateAuthorityStatus",
      "value": {
        "type": "enum",
        "members": {
          "PENDING_ACTIVATION": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "PendingActivation" }
          },
          "ACTIVE": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "Active" }
          },
          "ACTIVE_BUT_PENDING_RENEWAL": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "ActiveButPendingRenewal" }
          }
        },
        "traits": {
          "smithy.api#documentation": "Status of the Certificate Authority certificate lifecycle."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.deviceregistry#CertificateAuthorityIssuer",
      "value": {
        "type": "structure",
        "members": {
          "issuerType": {
            "target": "com.azure.deviceregistry#CertificateAuthorityIssuerType",
            "traits": {
              "smithy.api#documentation": "The Certificate Authority issuer type.",
              "smithy.api#required": {}
            }
          },
          "certificateAuthorityResourceId": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "The resource ID of the root issuer Certificate Authority in the same namespace (issuer type Microsoft)."
            }
          },
          "certificateSigningRequest": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Certificate Signing Request (CSR) in PEM format, generated by the service (issuer type External)."
            }
          },
          "thumbprint": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Thumbprint of the Certificate Authority certificate signed by the external issuer (issuer type External)."
            }
          },
          "status": {
            "target": "com.azure.deviceregistry#CertificateAuthorityStatus",
            "traits": {
              "smithy.api#documentation": "The status of the external issuer certificate lifecycle (issuer type External)."
            }
          }
        },
        "traits": {
          "smithy.api#documentation": "The issuer for an intermediate Certificate Authority."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.deviceregistry#CertificateAuthorityPropertiesInput/members/issuer",
      "value": {
        "target": "com.azure.deviceregistry#CertificateAuthorityIssuer",
        "traits": {
          "smithy.api#documentation": "The issuer for an intermediate Certificate Authority (certificateAuthorityType ICA only)."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.azure.deviceregistry#CertificateAuthorityProperties/members/issuer",
      "value": {
        "target": "com.azure.deviceregistry#CertificateAuthorityIssuer",
        "traits": {
          "smithy.api#documentation": "The issuer for an intermediate Certificate Authority (certificateAuthorityType ICA only)."
        }
      }
    }
  ]
}
