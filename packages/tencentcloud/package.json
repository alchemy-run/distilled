{
  "name": "@distilled.cloud/tencentcloud",
  "version": "1.0.0-rc.19",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchemy-run/distilled",
    "directory": "packages/tencentcloud"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "distilled-lazy": "./lib/index.lazy.js",
      "default": "./lib/index.js"
    },
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "worker": "./src/credentials.ts",
      "default": "./lib/credentials.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "worker": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Protocol": {
      "types": "./lib/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "worker": "./src/protocol.ts",
      "default": "./lib/protocol.js"
    },
    "./Region": {
      "types": "./lib/region.d.ts",
      "bun": "./src/region.ts",
      "worker": "./src/region.ts",
      "default": "./lib/region.js"
    },
    "./Retry": {
      "types": "./lib/retry.d.ts",
      "bun": "./src/retry.ts",
      "worker": "./src/retry.ts",
      "default": "./lib/retry.js"
    },
    "./Signer": {
      "types": "./lib/signer.d.ts",
      "bun": "./src/signer.ts",
      "worker": "./src/signer.ts",
      "default": "./lib/signer.js"
    },
    "./Traits": {
      "types": "./lib/traits.d.ts",
      "bun": "./src/traits.ts",
      "worker": "./src/traits.ts",
      "default": "./lib/traits.js"
    },
    "./*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "worker": "./src/services/*.ts",
      "distilled-lazy": "./lib/services.lazy/*.js",
      "default": "./lib/services/*.js"
    }
  },
  "scripts": {
    "build": "tsrs -b",
    "convert": "node --conditions=bun scripts/convert.ts",
    "generate": "node --conditions=bun scripts/generate.ts",
    "typecheck": "tsrs -p tsconfig.json",
    "specs:fetch": "git submodule update --force --init --depth=1 specs/spec-mirror-tencentcloud",
    "specs:update": "git submodule update --remote --force --depth=1 specs/spec-mirror-tencentcloud"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*"
  },
  "devDependencies": {
    "@distilled.cloud/dev": "workspace:*",
    "@types/node": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "distilled": {
    "generatedAt": "2026-11-10",
    "specUpdatedAt": "2026-11-10"
  }
}
