{
  "name": "@distilled.cloud/onepassword",
  "version": "1.0.0-rc.20",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchemy-run/distilled",
    "directory": "packages/onepassword"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "worker": "./src/credentials.ts",
      "default": "./lib/credentials.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "worker": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Traits": {
      "types": "./lib/traits.d.ts",
      "bun": "./src/traits.ts",
      "worker": "./src/traits.ts",
      "default": "./lib/traits.js"
    },
    "./Pagination": {
      "types": "./lib/pagination.d.ts",
      "bun": "./src/pagination.ts",
      "worker": "./src/pagination.ts",
      "default": "./lib/pagination.js"
    },
    "./Protocol": {
      "types": "./lib/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "worker": "./src/protocol.ts",
      "default": "./lib/protocol.js"
    },
    "./Retry": {
      "types": "./lib/retry.d.ts",
      "bun": "./src/retry.ts",
      "worker": "./src/retry.ts",
      "default": "./lib/retry.js"
    },
    "./SdkClient": {
      "types": "./lib/sdk-client.d.ts",
      "bun": "./src/sdk-client.ts",
      "worker": "./src/sdk-client.ts",
      "default": "./lib/sdk-client.js"
    },
    "./ItemCategories": {
      "types": "./lib/item-categories.d.ts",
      "bun": "./src/item-categories.ts",
      "worker": "./src/item-categories.ts",
      "default": "./lib/item-categories.js"
    },
    "./*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "worker": "./src/services/*.ts",
      "distilled-lazy": "./lib/services.lazy/*.js",
      "default": "./lib/services/*.js"
    }
  },
  "scripts": {
    "build": "tsrs -b",
    "convert": "node --conditions=bun scripts/convert.ts",
    "generate": "node --conditions=bun scripts/generate.ts",
    "typecheck": "tsrs -p tsconfig.json",
    "specs:fetch": "git submodule update --force --init --depth=1 specs/spec-mirror-onepassword",
    "specs:update": "git submodule update --remote --force --depth=1 specs/spec-mirror-onepassword"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*"
  },
  "devDependencies": {
    "@1password/sdk-core": "0.5.0",
    "@distilled.cloud/dev": "workspace:*",
    "@types/node": "catalog:",
    "oxc-parser": "catalog:"
  },
  "peerDependencies": {
    "@1password/sdk-core": "0.5.0",
    "effect": "catalog:"
  },
  "peerDependenciesMeta": {
    "@1password/sdk-core": {
      "optional": true
    }
  },
  "distilled": {
    "generatedAt": "2026-11-22",
    "specUpdatedAt": "2026-11-05"
  }
}
