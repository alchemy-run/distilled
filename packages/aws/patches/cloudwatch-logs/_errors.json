{
  "description": "CloudWatch Logs: Categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#ThrottlingException/traits/distilled.errors#categories",
      "value": ["ThrottlingError", "RetryableError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#OperationAbortedException/traits/distilled.errors#categories",
      "value": ["ConflictError", "RetryableError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#LimitExceededException/traits/distilled.errors#categories",
      "value": ["QuotaError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#ServiceQuotaExceededException/traits/distilled.errors#categories",
      "value": ["QuotaError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#ResourceNotFoundException/traits/distilled.errors#categories",
      "value": ["NotFoundError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#ConflictException/traits/distilled.errors#categories",
      "value": ["ConflictError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#InvalidParameterException/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#InvalidOperationException/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#ValidationException/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#MalformedQueryException/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#InvalidSequenceTokenException/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#DataAlreadyAcceptedException/traits/distilled.errors#categories",
      "value": ["ConflictError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudwatchlogs#UnrecognizedClientException/traits/distilled.errors#categories",
      "value": ["AuthError"]
    }
  ]
}
