{
  "description": "kendra: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); members the error responses carry; categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.kendra#NotAuthorizedException",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.kendra#KendraClosedToNewCustomers",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "NotAuthorizedException",
            "message": {
              "includes": "no longer accepting new customers"
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.kendra#NotAuthorizedException/members/message",
      "value": {
        "target": "smithy.api#String"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.kendra#NotAuthorizedException/traits/distilled.errors#categories",
      "value": ["AuthError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.kendra#KendraClosedToNewCustomers/traits/distilled.errors#categories",
      "value": ["AuthError"]
    }
  ]
}
