{
  "description": "Directory Service: Errors operations return that the model does not list.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.directoryservice#CreateDirectory/errors/-",
      "value": {
        "target": "com.amazonaws.directoryservice#SimpleADClosedToNewCustomers"
      }
    }
  ]
}
