{
  "description": "Directory Service: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.directoryservice#SimpleADClosedToNewCustomers",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ClientException",
            "message": {
              "includes": "Simple AD is no longer open to new customers"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.directoryservice#ClientException/members",
      "path": "/shapes/com.amazonaws.directoryservice#SimpleADClosedToNewCustomers/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.directoryservice#SimpleADClosedToNewCustomers/traits/distilled.errors#categories",
      "value": ["AuthError"]
    }
  ]
}
