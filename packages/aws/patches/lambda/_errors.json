{
  "description": "Lambda: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.lambda#LambdaInternalKmsError",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "InvalidParameterValueException",
            "message": "Internal KMS service error. Try again."
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.lambda#InvalidParameterValueException/members",
      "path": "/shapes/com.amazonaws.lambda#LambdaInternalKmsError/members"
    },
