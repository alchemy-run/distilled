      "value": {
        "target": "com.amazonaws.sqs#InvalidParameterValueException"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#SendMessage/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#MissingRequiredParameterException"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#SendMessageBatch/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#RequestLimitExceeded"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#SendMessageBatch/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#InvalidParameterValueException"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#SendMessageBatch/errors/-",
