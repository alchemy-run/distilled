{
  "description": "SQS: Errors operations return that the model does not list; per-operation retry policies.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#ReceiveMessage/traits/distilled.retry#policy",
      "value": {
        "longPoll": true
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#CancelMessageMoveTask/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#RequestLimitExceeded"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#CancelMessageMoveTask/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#InvalidParameterValueException"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#StartMessageMoveTask/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#RequestLimitExceeded"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#StartMessageMoveTask/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#CommonServiceException"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#StartMessageMoveTask/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#InvalidParameterValueException"
      }
    },
    {
      "op": "add",
