      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#CreateQueue/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#InvalidParameterValueException"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#ListMessageMoveTasks/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#RequestLimitExceeded"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#ListMessageMoveTasks/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#InvalidParameterValueException"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sqs#SendMessage/errors/-",
      "value": {
        "target": "com.amazonaws.sqs#RequestLimitExceeded"
      }
    },
    {
      "op": "add",
