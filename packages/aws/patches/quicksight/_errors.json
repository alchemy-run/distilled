{
  "description": "QuickSight: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.quicksight#QuickSightSubscriptionRequired",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ResourceNotFoundException",
            "message": {
              "includes": "Directory information"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.quicksight#ResourceNotFoundException/members",
      "path": "/shapes/com.amazonaws.quicksight#QuickSightSubscriptionRequired/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.quicksight#QuickSightSubscriptionRequired/traits/distilled.errors#categories",
      "value": ["NotFoundError"]
    }
  ]
}
