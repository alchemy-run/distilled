        "type": "structure",
        "members": {},
        "traits": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.rds#DBInstanceDeletionProtected",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "InvalidParameterCombination",
            "message": {
              "includes": "Cannot delete protected DB Instance"
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.rds#DBClusterDeletionProtected",
