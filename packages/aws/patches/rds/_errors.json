      "op": "add",
      "path": "/shapes/com.amazonaws.rds#InvalidParameterCombination",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.rds#InvalidParameterValue",
