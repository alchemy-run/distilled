{
  "description": "Kinesis Video: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.kinesisvideo#StreamNotActive",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ResourceNotFoundException",
            "message": {
              "includes": "not active"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.kinesisvideo#ResourceNotFoundException/members",
      "path": "/shapes/com.amazonaws.kinesisvideo#StreamNotActive/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.kinesisvideo#StreamNotActive/traits/distilled.errors#categories",
      "value": ["ConflictError", "RetryableError"]
    }
  ]
}
