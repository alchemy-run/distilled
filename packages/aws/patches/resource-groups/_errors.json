{
  "description": "Resource Groups: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.resourcegroups#GroupAlreadyExists",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "BadRequestException",
            "message": {
              "includes": "group already exists"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.resourcegroups#BadRequestException/members",
      "path": "/shapes/com.amazonaws.resourcegroups#GroupAlreadyExists/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.resourcegroups#GroupAlreadyExists/traits/distilled.errors#categories",
      "value": ["AlreadyExistsError"]
    }
  ]
}
