{
  "description": "deadline: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.deadline#DeadlineRoleNotAssumable",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ValidationException",
            "message": {
              "includes": "Could not sts:AssumeRole"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.deadline#ValidationException/members",
      "path": "/shapes/com.amazonaws.deadline#DeadlineRoleNotAssumable/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.deadline#InternalServerException",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.deadline#InternalServerException/traits/distilled.errors#categories",
      "value": ["ServerError", "RetryableError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.deadline#DeadlineRoleNotAssumable/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    }
  ]
}
