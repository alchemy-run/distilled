{
  "description": "DataBrew: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.databrew#TooManyRequestsException",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.databrew#DataBrewRoleNotAssumable",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ValidationException",
            "message": {
              "includes": "is not a trusted entity for the data access role"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.databrew#ValidationException/members",
      "path": "/shapes/com.amazonaws.databrew#DataBrewRoleNotAssumable/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.databrew#TooManyRequestsException/traits/distilled.errors#categories",
      "value": ["ThrottlingError", "RetryableError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.databrew#DataBrewRoleNotAssumable/traits/distilled.errors#categories",
      "value": ["BadRequestError", "RetryableError"]
    }
  ]
}
