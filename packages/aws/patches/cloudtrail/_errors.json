{
  "description": "CloudTrail: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudtrail#CloudTrailLakeOnboardingClosed",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "InvalidParameterException",
            "message": {
              "includes": "no longer accepting new customers"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.cloudtrail#InvalidParameterException/members",
      "path": "/shapes/com.amazonaws.cloudtrail#CloudTrailLakeOnboardingClosed/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.cloudtrail#CloudTrailLakeOnboardingClosed/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    }
  ]
}
