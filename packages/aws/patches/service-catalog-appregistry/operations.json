{
  "description": "Service Catalog AppRegistry: Errors operations return that the model does not list.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.servicecatalogappregistry#AssociateAttributeGroup/errors/-",
      "value": {
        "target": "com.amazonaws.servicecatalogappregistry#ThrottlingException"
      }
    }
  ]
}
