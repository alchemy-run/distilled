        "resources": {
          "fsx:RestoreVolumeFromSnapshot": "*"
        }
      }
    },
    "updateSnapshot": {
      "syntheticErrors": [
        {
          "name": "UpdateSnapshotNotFound",
          "from": "BadRequest",
          "message": {
            "includes": "the snapshot is not found"
          }
        }
      ]
    }
  },
  "errorCategories": {
    "SourceSnapshotNotFound": ["NotFoundError"],
    "SnapshotVolumeNotFound": ["NotFoundError"],
    "RestoreSnapshotNotFound": ["NotFoundError"],
    "UpdateSnapshotNotFound": ["NotFoundError"]
