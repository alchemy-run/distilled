{
  "description": "Cost and Usage Report Service: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.costandusagereportservice#ReportBucketNotVerified",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ValidationException",
            "message": {
              "matches": "[Bb]ucket"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.costandusagereportservice#ValidationException/members",
      "path": "/shapes/com.amazonaws.costandusagereportservice#ReportBucketNotVerified/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.costandusagereportservice#ReportBucketNotVerified/traits/distilled.errors#categories",
      "value": ["RetryableError"]
    }
  ]
}
