{
  "description": "ACM: Categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.acm#ThrottlingException/traits/distilled.errors#categories",
      "value": ["ThrottlingError", "RetryableError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.acm#LimitExceededException/traits/distilled.errors#categories",
      "value": ["QuotaError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.acm#RequestInProgressException/traits/distilled.errors#categories",
      "value": ["ConflictError", "RetryableError"]
    }
  ]
}
