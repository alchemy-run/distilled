{
  "description": "Application Auto Scaling: Errors operations return that the model does not list.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.applicationautoscaling#GetPredictiveScalingForecast/errors/-",
      "value": {
        "target": "com.amazonaws.applicationautoscaling#PredictiveScalingForecastNotSupported"
      }
    }
  ]
}
