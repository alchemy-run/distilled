{
  "description": "License Manager: Errors operations return that the model does not list.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.licensemanager#GetAccessToken/errors/-",
      "value": {
        "target": "com.amazonaws.licensemanager#InvalidParameterValueException"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.licensemanager#GetLicense/errors/-",
      "value": {
        "target": "com.amazonaws.licensemanager#ResourceNotFoundException"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.licensemanager#GetGrant/errors/-",
      "value": {
        "target": "com.amazonaws.licensemanager#ResourceNotFoundException"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.licensemanager#GetLicenseConfiguration/errors/-",
      "value": {
        "target": "com.amazonaws.licensemanager#LicenseConfigurationNotFound"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.licensemanager#UpdateLicenseConfiguration/errors/-",
      "value": {
        "target": "com.amazonaws.licensemanager#LicenseConfigurationNotFound"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.licensemanager#DeleteLicenseConfiguration/errors/-",
      "value": {
        "target": "com.amazonaws.licensemanager#LicenseConfigurationNotFound"
      }
    }
  ]
}
