{
  "operations": {
    "describeDBEngineVersions": {
      "errors": ["InvalidParameterCombination"]
    },
    "createDBInstance": {
      "errors": ["InvalidParameterCombination", "InvalidParameterValue"]
    },
    "modifyDBInstance": {
      "errors": ["InvalidParameterCombination", "InvalidParameterValue"]
    },
    "createDBCluster": {
      "errors": ["InvalidParameterCombination", "InvalidParameterValue"]
    },
    "modifyDBCluster": {
      "errors": ["InvalidParameterCombination", "InvalidParameterValue"]
    },
    "copyDBSnapshot": {
      "iam": {
        "reason": "rds:CopyCustomDBEngineVersion: AWS lists it for the operation, but the RDS Bindings suite calls it successfully without it.",
        "remove": ["rds:CopyCustomDBEngineVersion"]
      }
    },
    "stopDBInstance": {
      "iam": {
        "reason": "rds:AddTagsToResource: Needed only when the request names a DBSnapshotIdentifier (a snapshot taken on stop). rds:CreateDBSnapshot: Needed only when the request names a DBSnapshotIdentifier (a snapshot taken on stop).",
        "conditional": {
          "rds:AddTagsToResource": "Needed only when the request names a DBSnapshotIdentifier (a snapshot taken on stop).",
          "rds:CreateDBSnapshot": "Needed only when the request names a DBSnapshotIdentifier (a snapshot taken on stop)."
        }
      }
    }
  },
  "errors": {
    "InvalidParameterCombination": {
      "message": {
        "type": "string"
      }
    },
    "InvalidParameterValue": {
      "message": {
        "type": "string"
      }
    }
  },
  "errorCategories": {
