{
  "description": "SES: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message).",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.ses#InvalidParameterValue",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.ses#IdentityNotVerified",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "InvalidParameterValue",
            "message": {
              "includes": "Identity is not verified"
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.ses#ReceiptRuleRoleNotAssumable",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "InvalidParameterValue",
            "message": {
              "includes": "Could not assume the provided IAM Role"
            }
          }
        }
      }
    }
  ]
}
