{
  "description": "Route 53 Domains: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.route53domains#DomainNotFound",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "InvalidInput",
            "message": {
              "includes": "not found in account"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.route53domains#InvalidInput/members",
      "path": "/shapes/com.amazonaws.route53domains#DomainNotFound/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.route53domains#DomainNotFound/traits/distilled.errors#categories",
      "value": ["NotFoundError"]
    }
  ]
}
