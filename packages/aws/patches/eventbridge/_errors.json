      "value": ["ConflictError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.eventbridge#EndpointRoleNotAssumable/traits/distilled.errors#categories",
      "value": ["RetryableError"]
    }
  ]
