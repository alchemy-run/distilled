    {
      "op": "add",
      "path": "/shapes/com.amazonaws.eventbridge#ManagedRuleException/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.eventbridge#OperationDisabledException/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
