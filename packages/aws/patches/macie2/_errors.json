{
  "description": "Macie2: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.macie2#MacieNotEnabled",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "AccessDeniedException",
            "message": {
              "matches": "Macie is(n[’']t| not) enabled"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.macie2#AccessDeniedException/members",
      "path": "/shapes/com.amazonaws.macie2#MacieNotEnabled/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.macie2#MacieNotEnabled/traits/distilled.errors#categories",
      "value": ["RetryableError"]
    }
  ]
}
