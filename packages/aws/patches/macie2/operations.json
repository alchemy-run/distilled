      "path": "/shapes/com.amazonaws.macie2#CreateCustomDataIdentifier/errors/-",
      "value": {
        "target": "com.amazonaws.macie2#MacieNotEnabled"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.macie2#CreateFindingsFilter/errors/-",
      "value": {
        "target": "com.amazonaws.macie2#MacieNotEnabled"
      }
    }
  ]
