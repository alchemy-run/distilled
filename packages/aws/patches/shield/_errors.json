{
  "description": "Shield: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.shield#SubscriptionNotFound",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ResourceNotFoundException",
            "message": "The subscription does not exist."
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.shield#ResourceNotFoundException/members",
      "path": "/shapes/com.amazonaws.shield#SubscriptionNotFound/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.shield#SubscriptionNotFound/traits/distilled.errors#categories",
      "value": ["NotFoundError"]
    }
  ]
}
