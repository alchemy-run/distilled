{
  "description": "SSM Contacts: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.ssmcontacts#IncidentManagerNotOnboarded",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ValidationException",
            "message": {
              "includes": "Account not found for the request"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.ssmcontacts#ValidationException/members",
      "path": "/shapes/com.amazonaws.ssmcontacts#IncidentManagerNotOnboarded/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.ssmcontacts#InvalidRotationArn",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ValidationException",
            "message": {
              "includes": "Invalid resource Arn"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.ssmcontacts#ValidationException/members",
      "path": "/shapes/com.amazonaws.ssmcontacts#InvalidRotationArn/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.ssmcontacts#IncidentManagerNotOnboarded/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.ssmcontacts#InvalidRotationArn/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    }
  ]
}
