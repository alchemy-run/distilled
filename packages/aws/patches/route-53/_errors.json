{
  "description": "Route 53: Categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.route53#PriorRequestNotComplete/traits/distilled.errors#categories",
      "value": ["ConflictError", "RetryableError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.route53#ThrottlingException/traits/distilled.errors#categories",
      "value": ["ThrottlingError", "RetryableError"]
    }
  ]
}
