{
  "description": "chatbot: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.chatbot#SlackWorkspaceNotAuthorized",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "InvalidRequestException",
            "message": {
              "includes": "is not authorized with AWS account"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.chatbot#InvalidRequestException/members",
      "path": "/shapes/com.amazonaws.chatbot#SlackWorkspaceNotAuthorized/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.chatbot#MicrosoftTeamsTeamNotConfigured",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "InvalidRequestException",
            "message": {
              "includes": "team id you are using is not configured"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.chatbot#InvalidRequestException/members",
      "path": "/shapes/com.amazonaws.chatbot#MicrosoftTeamsTeamNotConfigured/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.chatbot#SlackWorkspaceNotAuthorized/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.chatbot#MicrosoftTeamsTeamNotConfigured/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    }
  ]
}
