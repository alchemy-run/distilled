{
  "description": "SageMaker FeatureStore Runtime: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sagemakerfeaturestoreruntime#FeatureGroupNotFound",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ValidationError",
            "message": {
              "includes": "Resource Not Found"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.sagemakerfeaturestoreruntime#ValidationError/members",
      "path": "/shapes/com.amazonaws.sagemakerfeaturestoreruntime#FeatureGroupNotFound/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.sagemakerfeaturestoreruntime#FeatureGroupNotFound/traits/distilled.errors#categories",
      "value": ["NotFoundError"]
    }
  ]
}
