{
  "description": "Kafka: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.kafka#ServerlessUnsupported",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ServerlessUnsupportedException",
            "message": {
              "includes": "not supported on serverless"
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.kafka#ServerlessUnsupported/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    }
  ]
}
