{
  "description": "AuditManager: Errors operations return that the model does not list.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.auditmanager#RegisterAccount/errors/-",
      "value": {
        "target": "com.amazonaws.auditmanager#AuditManagerMaintenanceMode"
      }
    }
  ]
}
