{
  "description": "AuditManager: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.auditmanager#AuditManagerMaintenanceMode",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "ValidationException",
            "message": {
              "includes": "maintenance mode"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.auditmanager#ValidationException/members",
      "path": "/shapes/com.amazonaws.auditmanager#AuditManagerMaintenanceMode/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.auditmanager#AuditManagerMaintenanceMode/traits/distilled.errors#categories",
      "value": ["BadRequestError"]
    }
  ]
}
