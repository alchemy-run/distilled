{
  "description": "SSM Incidents: Errors operations return that the model does not list.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.ssmincidents#CreateReplicationSet/errors/-",
      "value": {
        "target": "com.amazonaws.ssmincidents#UnsupportedOperationException"
      }
    }
  ]
}
