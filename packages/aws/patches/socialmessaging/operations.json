    {
      "op": "add",
      "path": "/shapes/com.amazonaws.socialmessaging#SendWhatsAppMessage/errors/-",
      "value": {
        "target": "com.amazonaws.socialmessaging#AccessDeniedByMetaException"
      }
    }
  ]
}
