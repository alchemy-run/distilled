{
  "description": "IoT: Error shapes the model does not declare, for the errors operations.json list (a shape with aws.codegen#synthetic matches its base wire error by message); categories (distilled.errors#categories) the error traits do not express.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.iot#TopicRuleNotFound",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "aws.codegen#synthetic": {
            "from": "UnauthorizedException",
            "message": {
              "includes": "Access to topic rule"
            }
          }
        }
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.amazonaws.iot#UnauthorizedException/members",
      "path": "/shapes/com.amazonaws.iot#TopicRuleNotFound/members"
    },
    {
      "op": "add",
      "path": "/shapes/com.amazonaws.iot#TopicRuleNotFound/traits/distilled.errors#categories",
      "value": ["NotFoundError"]
    }
  ]
}
