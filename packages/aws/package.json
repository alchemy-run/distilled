{
  "name": "@distilled.cloud/aws",
  "version": "1.0.0-rc.18",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchemy-run/distilled",
    "directory": "packages/aws"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "browser": {
    "./lib/_bundle/sdk.js": "./lib/_browser/_bundle/sdk.js",
    "./lib/auth.browser.js": "./lib/_browser/auth.browser.js",
    "./lib/endpoint.js": "./lib/_browser/endpoint.js",
    "./lib/protocols/rest-json.js": "./lib/_browser/protocols/rest-json.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "worker": "./src/services/*.ts",
      "distilled-lazy": "./lib/services.lazy/*.js",
      "default": "./lib/services/*.js"
    },
    "./Auth": {
      "types": "./lib/auth.d.ts",
      "bun": "./src/auth.ts",
      "worker": "./src/auth.ts",
      "browser": "./lib/auth.browser.js",
      "default": "./lib/auth.js"
    },
    "./Category": {
      "types": "./lib/category.d.ts",
      "bun": "./src/category.ts",
      "worker": "./src/category.ts",
      "default": "./lib/category.js"
    },
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "worker": "./src/credentials.ts",
      "browser": "./lib/credentials.browser.js",
      "default": "./lib/credentials.js"
    },
    "./Endpoint": {
      "types": "./lib/endpoint.d.ts",
      "bun": "./src/endpoint.ts",
      "worker": "./src/endpoint.ts",
      "default": "./lib/endpoint.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "worker": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Presign": {
      "types": "./lib/presign.d.ts",
      "bun": "./src/presign.ts",
      "worker": "./src/presign.ts",
      "default": "./lib/presign.js"
    },
    "./Region": {
      "types": "./lib/region.d.ts",
      "bun": "./src/region.ts",
      "worker": "./src/region.ts",
      "default": "./lib/region.js"
    },
    "./Retry": {
      "types": "./lib/retry.d.ts",
      "bun": "./src/retry.ts",
      "worker": "./src/retry.ts",
      "default": "./lib/retry.js"
    },
    "./Sensitive": {
      "types": "./lib/sensitive.d.ts",
      "bun": "./src/sensitive.ts",
      "worker": "./src/sensitive.ts",
      "default": "./lib/sensitive.js"
    },
    "./Traits": {
      "types": "./lib/traits.d.ts",
      "bun": "./src/traits.ts",
      "worker": "./src/traits.ts",
      "default": "./lib/traits.js"
    },
    "./customizations/*": {
      "types": "./lib/customizations/*.d.ts",
      "bun": "./src/customizations/*.ts",
      "worker": "./src/customizations/*.ts",
      "default": "./lib/customizations/*.js"
    },
    "./ErrorMessage": {
      "types": "./lib/error-message.d.ts",
      "bun": "./src/error-message.ts",
      "worker": "./src/error-message.ts",
      "default": "./lib/error-message.js"
    },
    "./patch/*": {
      "types": "./lib/patch/*.d.ts",
      "bun": "./src/patch/*.ts",
      "worker": "./src/patch/*.ts",
      "default": "./lib/patch/*.js"
    },
    "./Protocol": {
      "types": "./lib/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "worker": "./src/protocol.ts",
      "default": "./lib/protocol.js"
    },
    "./protocols/*": {
      "types": "./lib/protocols/*.d.ts",
      "bun": "./src/protocols/*.ts",
      "worker": "./src/protocols/*.ts",
      "default": "./lib/protocols/*.js"
    },
    "./util/*": {
      "types": "./lib/util/*.d.ts",
      "bun": "./src/util/*.ts",
      "worker": "./src/util/*.ts",
      "default": "./lib/util/*.js"
    },
    "./SigV4": {
      "types": "./lib/sigv4.d.ts",
      "bun": "./src/sigv4.ts",
      "worker": "./src/sigv4.ts",
      "default": "./lib/sigv4.js"
    }
  },
  "scripts": {
    "typecheck": "tsrs",
    "build": "tsrs -b",
    "fmt": "oxfmt --write src",
    "lint": "oxlint --fix src",
    "check": "tsrs && oxlint src && oxfmt --check src",
    "convert": "node --conditions=bun scripts/convert.ts",
    "generate": "node --conditions=bun scripts/generate.ts",
    "specs:fetch": "git submodule update --force --init --depth=1 specs/spec-mirror-aws",
    "specs:update": "git submodule update --remote --force --depth=1 specs/spec-mirror-aws"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*",
    "@distilled.cloud/s3": "workspace:*"
  },
  "devDependencies": {
    "@distilled.cloud/dev": "workspace:*",
    "@types/node": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  },
  "distilled": {
    "generatedAt": "2026-11-01",
    "specUpdatedAt": "2026-10-14"
  }
}
