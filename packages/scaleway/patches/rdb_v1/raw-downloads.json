{
  "description": "GetInstanceCertificate: Scaleway answers the file itself when the request adds `?dl=1` (scaleway-sdk-js sends it for these downloads; the Go SDK and CLI read the JSON `scaleway.std.File` instead). Each gets a `…Raw` twin that sends `dl=1` (the `rawDownload` flag on its http trait) and returns the body as bytes.",
  "patches": [
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.rdb_v1#GetInstanceCertificateRequest",
      "path": "/shapes/com.scaleway.rdb_v1#GetInstanceCertificateRawRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.rdb_v1#GetInstanceCertificateRawResponse",
      "value": {
        "type": "structure",
        "members": {
          "body": {
            "target": "smithy.api#Blob",
            "traits": {
              "com.distilled.openapi#rawResponse": {},
              "smithy.api#required": {}
            }
          }
        },
        "traits": {}
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.rdb_v1#GetInstanceCertificate",
      "path": "/shapes/com.scaleway.rdb_v1#GetInstanceCertificateRaw"
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.rdb_v1#GetInstanceCertificateRaw/input",
      "value": {
        "target": "com.scaleway.rdb_v1#GetInstanceCertificateRawRequest"
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.rdb_v1#GetInstanceCertificateRaw/output",
      "value": {
        "target": "com.scaleway.rdb_v1#GetInstanceCertificateRawResponse"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.rdb_v1#GetInstanceCertificateRaw/traits/smithy.api#http/rawDownload",
      "value": true
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.rdb_v1#GetInstanceCertificateRaw/traits/smithy.api#documentation",
      "value": "The file `getInstanceCertificate` returns, as bytes (`?dl=1`), rather than the JSON file object."
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.rdb_v1#RdbV1/operations/-",
      "value": {
        "target": "com.scaleway.rdb_v1#GetInstanceCertificateRaw"
      }
    }
  ]
}
