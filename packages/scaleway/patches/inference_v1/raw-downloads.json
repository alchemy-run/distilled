{
  "description": "GetDeploymentCertificate: Scaleway answers the file itself when the request adds `?dl=1` (scaleway-sdk-js sends it for these downloads; the Go SDK and CLI read the JSON `scaleway.std.File` instead). Each gets a `…Raw` twin that sends `dl=1` (the `rawDownload` flag on its http trait) and returns the body as bytes.",
  "patches": [
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.inference_v1#GetDeploymentCertificateRequest",
      "path": "/shapes/com.scaleway.inference_v1#GetDeploymentCertificateRawRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.inference_v1#GetDeploymentCertificateRawResponse",
      "value": {
        "type": "structure",
        "members": {
          "body": {
            "target": "smithy.api#Blob",
            "traits": {
              "com.distilled.openapi#rawResponse": {},
              "smithy.api#required": {}
            }
          }
        },
        "traits": {}
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.inference_v1#GetDeploymentCertificate",
      "path": "/shapes/com.scaleway.inference_v1#GetDeploymentCertificateRaw"
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.inference_v1#GetDeploymentCertificateRaw/input",
      "value": {
        "target": "com.scaleway.inference_v1#GetDeploymentCertificateRawRequest"
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.inference_v1#GetDeploymentCertificateRaw/output",
      "value": {
        "target": "com.scaleway.inference_v1#GetDeploymentCertificateRawResponse"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.inference_v1#GetDeploymentCertificateRaw/traits/smithy.api#http/rawDownload",
      "value": true
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.inference_v1#GetDeploymentCertificateRaw/traits/smithy.api#documentation",
      "value": "The file `getDeploymentCertificate` returns, as bytes (`?dl=1`), rather than the JSON file object."
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.inference_v1#InferenceV1/operations/-",
      "value": {
        "target": "com.scaleway.inference_v1#GetDeploymentCertificateRaw"
      }
    }
  ]
}
