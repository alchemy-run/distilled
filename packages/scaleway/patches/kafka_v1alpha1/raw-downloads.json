{
  "description": "GetClusterCertificateAuthority: Scaleway answers the file itself when the request adds `?dl=1` (scaleway-sdk-js sends it for these downloads; the Go SDK and CLI read the JSON `scaleway.std.File` instead). Each gets a `…Raw` twin that sends `dl=1` (the `rawDownload` flag on its http trait) and returns the body as bytes.",
  "patches": [
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthorityRequest",
      "path": "/shapes/com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthorityRawRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthorityRawResponse",
      "value": {
        "type": "structure",
        "members": {
          "body": {
            "target": "smithy.api#Blob",
            "traits": {
              "com.distilled.openapi#rawResponse": {},
              "smithy.api#required": {}
            }
          }
        },
        "traits": {}
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthority",
      "path": "/shapes/com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthorityRaw"
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthorityRaw/input",
      "value": {
        "target": "com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthorityRawRequest"
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthorityRaw/output",
      "value": {
        "target": "com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthorityRawResponse"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthorityRaw/traits/smithy.api#http/rawDownload",
      "value": true
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthorityRaw/traits/smithy.api#documentation",
      "value": "The file `getClusterCertificateAuthority` returns, as bytes (`?dl=1`), rather than the JSON file object."
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.kafka_v1alpha1#KafkaV1alpha1/operations/-",
      "value": {
        "target": "com.scaleway.kafka_v1alpha1#GetClusterCertificateAuthorityRaw"
      }
    }
  ]
}
