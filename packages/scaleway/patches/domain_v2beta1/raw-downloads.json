{
  "description": "ExportRawDNSZone: Scaleway answers the file itself when the request adds `?dl=1` (scaleway-sdk-js sends it for these downloads; the Go SDK and CLI read the JSON `scaleway.std.File` instead). Each gets a `…Raw` twin that sends `dl=1` (the `rawDownload` flag on its http trait) and returns the body as bytes.",
  "patches": [
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.domain_v2beta1#ExportRawDNSZoneRequest",
      "path": "/shapes/com.scaleway.domain_v2beta1#ExportRawDNSZoneRawRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.domain_v2beta1#ExportRawDNSZoneRawResponse",
      "value": {
        "type": "structure",
        "members": {
          "body": {
            "target": "smithy.api#Blob",
            "traits": {
              "com.distilled.openapi#rawResponse": {},
              "smithy.api#required": {}
            }
          }
        },
        "traits": {}
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.domain_v2beta1#ExportRawDNSZone",
      "path": "/shapes/com.scaleway.domain_v2beta1#ExportRawDNSZoneRaw"
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.domain_v2beta1#ExportRawDNSZoneRaw/input",
      "value": {
        "target": "com.scaleway.domain_v2beta1#ExportRawDNSZoneRawRequest"
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.domain_v2beta1#ExportRawDNSZoneRaw/output",
      "value": {
        "target": "com.scaleway.domain_v2beta1#ExportRawDNSZoneRawResponse"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.domain_v2beta1#ExportRawDNSZoneRaw/traits/smithy.api#http/rawDownload",
      "value": true
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.domain_v2beta1#ExportRawDNSZoneRaw/traits/smithy.api#documentation",
      "value": "The file `exportRawDNSZone` returns, as bytes (`?dl=1`), rather than the JSON file object."
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.domain_v2beta1#DomainV2beta1/operations/-",
      "value": {
        "target": "com.scaleway.domain_v2beta1#ExportRawDNSZoneRaw"
      }
    }
  ]
}
