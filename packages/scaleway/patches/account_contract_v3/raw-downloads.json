{
  "description": "DownloadContractSignature: Scaleway answers the file itself when the request adds `?dl=1` (scaleway-sdk-js sends it for these downloads; the Go SDK and CLI read the JSON `scaleway.std.File` instead). Each gets a `…Raw` twin that sends `dl=1` (the `rawDownload` flag on its http trait) and returns the body as bytes.",
  "patches": [
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.account_contract_v3#DownloadContractSignatureRequest",
      "path": "/shapes/com.scaleway.account_contract_v3#DownloadContractSignatureRawRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.account_contract_v3#DownloadContractSignatureRawResponse",
      "value": {
        "type": "structure",
        "members": {
          "body": {
            "target": "smithy.api#Blob",
            "traits": {
              "com.distilled.openapi#rawResponse": {},
              "smithy.api#required": {}
            }
          }
        },
        "traits": {}
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.account_contract_v3#DownloadContractSignature",
      "path": "/shapes/com.scaleway.account_contract_v3#DownloadContractSignatureRaw"
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.account_contract_v3#DownloadContractSignatureRaw/input",
      "value": {
        "target": "com.scaleway.account_contract_v3#DownloadContractSignatureRawRequest"
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.account_contract_v3#DownloadContractSignatureRaw/output",
      "value": {
        "target": "com.scaleway.account_contract_v3#DownloadContractSignatureRawResponse"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.account_contract_v3#DownloadContractSignatureRaw/traits/smithy.api#http/rawDownload",
      "value": true
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.account_contract_v3#DownloadContractSignatureRaw/traits/smithy.api#documentation",
      "value": "The file `downloadContractSignature` returns, as bytes (`?dl=1`), rather than the JSON file object."
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.account_contract_v3#AccountContractV3/operations/-",
      "value": {
        "target": "com.scaleway.account_contract_v3#DownloadContractSignatureRaw"
      }
    }
  ]
}
