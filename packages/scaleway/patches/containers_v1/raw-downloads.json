{
  "description": "GetPrivateEndpointCertificateAuthority: Scaleway answers the file itself when the request adds `?dl=1` (scaleway-sdk-js sends it for these downloads; the Go SDK and CLI read the JSON `scaleway.std.File` instead). Each gets a `…Raw` twin that sends `dl=1` (the `rawDownload` flag on its http trait) and returns the body as bytes.",
  "patches": [
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthorityRequest",
      "path": "/shapes/com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthorityRawRequest"
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthorityRawResponse",
      "value": {
        "type": "structure",
        "members": {
          "body": {
            "target": "smithy.api#Blob",
            "traits": {
              "com.distilled.openapi#rawResponse": {},
              "smithy.api#required": {}
            }
          }
        },
        "traits": {}
      }
    },
    {
      "op": "copy",
      "from": "/shapes/com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthority",
      "path": "/shapes/com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthorityRaw"
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthorityRaw/input",
      "value": {
        "target": "com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthorityRawRequest"
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthorityRaw/output",
      "value": {
        "target": "com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthorityRawResponse"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthorityRaw/traits/smithy.api#http/rawDownload",
      "value": true
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthorityRaw/traits/smithy.api#documentation",
      "value": "The file `getPrivateEndpointCertificateAuthority` returns, as bytes (`?dl=1`), rather than the JSON file object."
    },
    {
      "op": "add",
      "path": "/shapes/com.scaleway.containers_v1#ContainersV1/operations/-",
      "value": {
        "target": "com.scaleway.containers_v1#GetPrivateEndpointCertificateAuthorityRaw"
      }
    }
  ]
}
