    "com.scaleway.mnq_nats_v1beta1#MnqNatsV1beta1": {
      "type": "service",
      "version": "v1beta1",
      "operations": [
        {
          "target": "com.scaleway.mnq_nats_v1beta1#ListNatsAccounts"
