    "com.scaleway.reseller_v1#ResellerV1": {
      "type": "service",
      "version": "v1",
      "operations": [
        {
          "target": "com.scaleway.reseller_v1#ListConsumptions"
        }
      ],
      "traits": {
        "smithy.api#title": "Reseller API",
        "smithy.api#documentation": "As a reseller, this API allows you to create and manage Scaleway organizations (accounts) for your customers.\nAccess to this API is reserved for official Scaleway Resellers.\nAs a Scaleway Reseller, you will receive a unique `reseller_id` that allows you to create organizations.\n\n<Message type=\"important\">\n This API has been deprecated and is replaced by the [Partner API](https://www.scaleway.com/en/developers/api/partner-api).\n</Message>\n\n## Endpoint\n\nScaleway reseller API is available at `https://api.scaleway.com`\n\n## Authentication\n\nTo access this API, you need to create a unique [API secret key](https://www.scaleway.com/en/docs/iam/how-to/create-api-keys/). Ensure that you have the correct permission set: `ResellerFullAccess`. If you are the owner of the Organization and thus the creator of the API key, this permission is enabled by default.\nBe very careful as this secret key allows management access to all Scaleway organizations attached to your account.\nYou MUST pass the secret key in an `X-Auth-Token` HTTP header along with all your requests."
      }
