          "uri": "/webhosting/v1/regions/{region}/offers",
          "code": 200,
          "baseUrl": "https://api.scaleway.com"
        },
        "smithy.api#documentation": "List all available hosting offers along with their specific options.",
        "smithy.api#paginated": {
