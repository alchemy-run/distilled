{
  "description": "Mark branch credential secrets and the write-only multipart environment JSON as sensitive members; Neon lists credential secrets in a parent x-sensitive array.",
  "patches": [
    {
      "op": "add",
      "path": "/components/schemas/CreateCredentialResponse/properties/api_token/x-sensitive",
      "value": true
    },
    {
      "op": "add",
      "path": "/components/schemas/CreateCredentialResponse/properties/s3_secret_access_key/x-sensitive",
      "value": true
    },
    {
      "op": "add",
      "path": "/components/schemas/CredentialSecret/properties/api_token/x-sensitive",
      "value": true
    },
    {
      "op": "add",
      "path": "/components/schemas/CredentialSecret/properties/s3_secret_access_key/x-sensitive",
      "value": true
    },
    {
      "op": "add",
      "path": "/components/schemas/RotateCredentialResponse/properties/api_token/x-sensitive",
      "value": true
    },
    {
      "op": "add",
      "path": "/components/schemas/RotateCredentialResponse/properties/s3_secret_access_key/x-sensitive",
      "value": true
    },
    {
      "op": "add",
      "path": "/components/schemas/FunctionDeployRequest/properties/environment/x-sensitive",
      "value": true
    },
    {
      "op": "add",
      "path": "/components/schemas/PresignResponse/properties/url/x-sensitive",
      "value": true
    }
  ]
}
