{
  "description": "Allow clearing Product.shippable on update with Stripe's empty-string form value.",
  "patches": [
    {
      "op": "replace",
      "path": "/shapes/com.stripe.api#PostProductsIdRequest/members/shippable/target",
      "value": "com.stripe.api#UpdateProductRequestShippable"
    },
    {
      "op": "add",
      "path": "/shapes/com.stripe.api#UpdateProductRequestShippableCase1",
      "value": {
        "type": "enum",
        "members": {
          "VALUE": {
            "target": "smithy.api#Unit",
            "traits": {
              "smithy.api#enumValue": ""
            }
          }
        },
        "traits": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.stripe.api#UpdateProductRequestShippable",
      "value": {
        "type": "union",
        "members": {
          "Case0": {
            "target": "smithy.api#Boolean"
          },
          "Case1": {
            "target": "com.stripe.api#UpdateProductRequestShippableCase1"
          }
        },
        "traits": {
          "smithy.api#documentation": "Whether this product is shipped (i.e., physical goods)."
        }
      }
    }
  ]
}
