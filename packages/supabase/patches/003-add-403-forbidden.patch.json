{
  "description": "Add the 403 Forbidden response GET /v1/projects/available-regions omits (every other operation now declares 403 upstream)",
  "patches": [
    {
      "op": "add",
      "path": "/paths/~1v1~1projects~1available-regions/get/responses/403",
      "value": {
        "description": "Forbidden - insufficient permissions",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": ["message"]
            }
          }
        }
      }
    }
  ]
}
