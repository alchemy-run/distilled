    "com.openai.uploads#UploadComplete": {
      "type": "operation",
      "input": {
        "target": "com.openai.uploads#UploadCompleteRequest"
      },
      "output": {
        "target": "com.openai.uploads#Upload"
      },
      "errors": [
        {
          "target": "com.openai.uploads#BadRequest"
        },
        {
          "target": "com.openai.uploads#NotFound"
        },
        {
          "target": "com.openai.uploads#Gone"
        }
      ],
      "traits": {
        "smithy.api#http": {
          "method": "POST",
          "uri": "/uploads/{upload_id}/complete",
          "code": 200
        },
        "smithy.api#documentation": "Complete upload\n\nCompletes the [Upload](https://developers.openai.com/api/reference/resources/uploads).\n\nWithin the returned Upload object, there is a nested [File](https://developers.openai.com/api/reference/resources/files) object that is ready to use in the rest of the platform.\n\nYou can specify the order of the Parts by passing in an ordered list of the Part IDs.\n\nThe number of bytes uploaded upon completion must match the number of bytes initially specified when creating the Upload object. No Parts may be added after an Upload is completed.\nReturns the Upload object with status `completed`, including an additional `file` property containing the created usable File object."
      }
    },
