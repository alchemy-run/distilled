{
  "description": "Type the missing environment on VolumeList and VolumeGetOrCreate: listing or looking up a volume in an environment deleted meanwhile answers gRPC NOT_FOUND `Environment '<name>' not found`, which is more specific than VolumeNotFound.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.modal.volume#EnvironmentNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The environment doesn't exist (gRPC NOT_FOUND).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 5,
              "message": {
                "includes": "Environment"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.volume#VolumeList/errors",
      "value": [
        {
          "target": "com.modal.volume#EnvironmentNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.volume#VolumeGetOrCreate/errors/-",
      "value": {
        "target": "com.modal.volume#EnvironmentNotFound"
      }
    }
  ]
}
