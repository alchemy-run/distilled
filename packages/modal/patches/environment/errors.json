{
  "description": "Typed not-found / already-exists errors for the environment RPCs. The gRPC protocol reports a non-zero grpc-status as `code` (5 = NOT_FOUND, 6 = ALREADY_EXISTS), which these matchers key on.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The environment doesn't exist (gRPC NOT_FOUND).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 5
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "An environment with this name already exists (gRPC ALREADY_EXISTS).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 6
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentGetOrCreate/errors",
      "value": [
        {
          "target": "com.modal.environment#EnvironmentNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentDelete/errors",
      "value": [
        {
          "target": "com.modal.environment#EnvironmentNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentUpdate/errors",
      "value": [
        {
          "target": "com.modal.environment#EnvironmentNotFound"
        },
        {
          "target": "com.modal.environment#EnvironmentAlreadyExists"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentGetBudget/errors",
      "value": [
        {
          "target": "com.modal.environment#EnvironmentNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentSetBudget/errors",
      "value": [
        {
          "target": "com.modal.environment#EnvironmentNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentGetRoles/errors",
      "value": [
        {
          "target": "com.modal.environment#EnvironmentNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentRoleSet/errors",
      "value": [
        {
          "target": "com.modal.environment#EnvironmentNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentSetDefaultMemberRole/errors",
      "value": [
        {
          "target": "com.modal.environment#EnvironmentNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentSetManaged/errors",
      "value": [
        {
          "target": "com.modal.environment#EnvironmentNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentGetManaged/errors",
      "value": [
        {
          "target": "com.modal.environment#EnvironmentNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.environment#EnvironmentCreate/errors",
      "value": [
        {
          "target": "com.modal.environment#EnvironmentAlreadyExists"
        }
      ]
    }
  ]
}
