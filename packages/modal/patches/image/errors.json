{
  "description": "Typed not-found / already-exists errors for the image RPCs. The gRPC protocol reports a non-zero grpc-status as `code` (5 = NOT_FOUND, 6 = ALREADY_EXISTS), which these matchers key on.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.modal.image#ImageNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The image or image tag doesn't exist (gRPC NOT_FOUND).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 5
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.image#ImageFromId/errors",
      "value": [
        {
          "target": "com.modal.image#ImageNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.image#ImageDelete/errors",
      "value": [
        {
          "target": "com.modal.image#ImageNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.image#ImageGetByTag/errors",
      "value": [
        {
          "target": "com.modal.image#ImageNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.image#ImageJoinStreaming/errors",
      "value": [
        {
          "target": "com.modal.image#ImageNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.image#ImagePublish/errors",
      "value": [
        {
          "target": "com.modal.image#ImageNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.image#ImageBuildChainGet/errors",
      "value": [
        {
          "target": "com.modal.image#ImageNotFound"
        }
      ]
    }
  ]
}
