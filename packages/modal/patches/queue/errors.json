{
  "description": "Typed not-found / already-exists errors for the queue RPCs. The gRPC protocol reports a non-zero grpc-status as `code` (5 = NOT_FOUND, 6 = ALREADY_EXISTS), which these matchers key on.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.modal.queue#QueueNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The queue doesn't exist (gRPC NOT_FOUND).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 5
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.queue#QueueAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "A queue with this name already exists in the environment (gRPC ALREADY_EXISTS).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 6
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.queue#QueueGetOrCreate/errors",
      "value": [
        {
          "target": "com.modal.queue#QueueNotFound"
        },
        {
          "target": "com.modal.queue#QueueAlreadyExists"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.queue#QueueGetById/errors",
      "value": [
        {
          "target": "com.modal.queue#QueueNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.queue#QueueDelete/errors",
      "value": [
        {
          "target": "com.modal.queue#QueueNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.queue#QueuePut/errors",
      "value": [
        {
          "target": "com.modal.queue#QueueNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.queue#QueueNextItems/errors",
      "value": [
        {
          "target": "com.modal.queue#QueueNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.queue#QueueLen/errors",
      "value": [
        {
          "target": "com.modal.queue#QueueNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.queue#QueueClear/errors",
      "value": [
        {
          "target": "com.modal.queue#QueueNotFound"
        }
      ]
    }
  ]
}
