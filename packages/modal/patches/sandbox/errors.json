        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.sandbox#SandboxSnapshotFs/errors",
      "value": [
        {
          "target": "com.modal.sandbox#SandboxNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.sandbox#SandboxSnapshot/errors",
      "value": [
        {
