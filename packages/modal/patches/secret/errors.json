{
  "description": "Typed not-found / already-exists errors for the secret RPCs. The gRPC protocol reports a non-zero grpc-status as `code` (5 = NOT_FOUND, 6 = ALREADY_EXISTS), which these matchers key on.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.modal.secret#SecretNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The secret doesn't exist (gRPC NOT_FOUND).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 5
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.secret#SecretAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "A secret with this name already exists in the environment (gRPC ALREADY_EXISTS).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 6
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.secret#SecretGetOrCreate/errors",
      "value": [
        {
          "target": "com.modal.secret#SecretNotFound"
        },
        {
          "target": "com.modal.secret#SecretAlreadyExists"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.secret#SecretGetInfo/errors",
      "value": [
        {
          "target": "com.modal.secret#SecretNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.secret#SecretDelete/errors",
      "value": [
        {
          "target": "com.modal.secret#SecretNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.secret#SecretUpdate/errors",
      "value": [
        {
          "target": "com.modal.secret#SecretNotFound"
        }
      ]
    }
  ]
}
