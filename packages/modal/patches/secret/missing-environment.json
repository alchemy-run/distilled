{
  "description": "Type the missing environment on SecretList and SecretGetOrCreate: listing or looking up a secret in an environment deleted meanwhile answers gRPC NOT_FOUND `Environment '<name>' not found`, which is more specific than SecretNotFound.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.modal.secret#EnvironmentNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The environment doesn't exist (gRPC NOT_FOUND).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 5,
              "message": {
                "includes": "Environment"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.secret#SecretList/errors",
      "value": [
        {
          "target": "com.modal.secret#EnvironmentNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.secret#SecretGetOrCreate/errors/-",
      "value": {
        "target": "com.modal.secret#EnvironmentNotFound"
      }
    }
  ]
}
