{
  "description": "Typed errors for service user RPCs. The gRPC protocol reports a non-zero grpc-status as `code` (5 = NOT_FOUND, 6 = ALREADY_EXISTS), which these matchers key on. A Starter-plan workspace rejects ServiceUserCreate with INVALID_ARGUMENT/FAILED_PRECONDITION (HTTP 400) and 'Service users are not available on the Starter plan'.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.modal.service#ServiceUserNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The service user doesn't exist (gRPC NOT_FOUND).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 5
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.service#ServiceUserAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "A service user with this name already exists (gRPC ALREADY_EXISTS).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 6
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.service#ServiceUserInfo/errors",
      "value": [
        {
          "target": "com.modal.service#ServiceUserNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.service#ServiceUserDelete/errors",
      "value": [
        {
          "target": "com.modal.service#ServiceUserNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.service#ServiceUserCreate/errors",
      "value": [
        {
          "target": "com.modal.service#ServiceUserAlreadyExists"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.service#ServiceUsersNotAvailable",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The workspace's plan doesn't include service users (Modal's Starter plan).",
          "com.modal.protocols#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "Service users are not available"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.service#ServiceUserCreate/errors/-",
      "value": {
        "target": "com.modal.service#ServiceUsersNotAvailable"
      }
    }
  ]
}
