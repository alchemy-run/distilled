{
  "description": "Typed not-found / already-exists errors for the endpoint RPCs (gRPC status 5 / 6). EndpointCreate for an authenticated endpoint fails with HTTP 400 'Create a proxy token to require authentication for this Endpoint' until a proxy (webhook) token with access to the environment exists.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.modal.endpoint#EndpointNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The endpoint doesn't exist (gRPC NOT_FOUND).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 5
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.endpoint#EndpointAlreadyExists",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "An endpoint with this name already exists in the environment (gRPC ALREADY_EXISTS).",
          "com.modal.protocols#errorMatchers": [
            {
              "code": 6
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.endpoint#EndpointGetByName/errors",
      "value": [
        {
          "target": "com.modal.endpoint#EndpointNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.endpoint#EndpointGetInfo/errors",
      "value": [
        {
          "target": "com.modal.endpoint#EndpointNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.endpoint#EndpointGetLifecycle/errors",
      "value": [
        {
          "target": "com.modal.endpoint#EndpointNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.endpoint#EndpointStop/errors",
      "value": [
        {
          "target": "com.modal.endpoint#EndpointNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.endpoint#EndpointCreate/errors",
      "value": [
        {
          "target": "com.modal.endpoint#EndpointAlreadyExists"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.endpoint#EndpointProxyTokenRequired",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "An authenticated endpoint needs a proxy token with access to its environment to exist first.",
          "com.modal.protocols#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "Create a proxy token"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.modal.endpoint#EndpointCreate/errors/-",
      "value": {
        "target": "com.modal.endpoint#EndpointProxyTokenRequired"
      }
    }
  ]
}
