{
  "description": "Database: many spec-required fields are omitted on list/get (counts, feature flags, plan). Keep the fields that every response actually includes.",
  "patches": [
    {
      "op": "replace",
      "path": "/definitions/Database/required",
      "value": [
        "id",
        "url",
        "branches_url",
        "region",
        "html_url",
        "name",
        "state",
        "created_at",
        "updated_at",
        "kind",
        "ready"
      ]
    },
    {
      "op": "replace",
      "path": "/definitions/PaginatedDatabase/properties/data/items/required",
      "value": [
        "id",
        "url",
        "branches_url",
        "region",
        "html_url",
        "name",
        "state",
        "created_at",
        "updated_at",
        "kind",
        "ready"
      ]
    }
  ]
}
