        "private_edge_connectivity",
        "has_replicas",
        "has_read_only_replicas",
        "html_url",
        "url",
        "region",
        "parent_branch"
      ]
    },
    {
      "op": "add",
      "path": "/definitions/PaginatedDatabaseBranch/properties/data/items/properties/cluster_architecture",
      "value": {
        "type": "string"
      }
    }
  ]
}
