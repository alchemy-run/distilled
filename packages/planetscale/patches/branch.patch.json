{
  "description": "DatabaseBranch: Vitess-only fields (mysql_address, vtgate_*, shard_count, …) are not always returned (Postgres branches omit them). cluster_architecture is returned on the wire but missing from the spec.",
  "patches": [
    {
      "op": "remove",
      "path": "/shapes/com.planetscale.api#PaginatedDatabaseBranchDataItem/members/deletion_protected/traits/smithy.api#required"
    },
    {
      "op": "remove",
      "path": "/shapes/com.planetscale.api#PaginatedDatabaseBranchDataItem/members/sharded/traits/smithy.api#required"
    },
    {
      "op": "remove",
      "path": "/shapes/com.planetscale.api#PaginatedDatabaseBranchDataItem/members/keyspace_count/traits/smithy.api#required"
    },
    {
      "op": "add",
      "path": "/shapes/com.planetscale.api#PaginatedDatabaseBranchDataItem/members/cluster_architecture",
      "value": {
        "target": "smithy.api#String"
      }
    },
    {
      "op": "remove",
      "path": "/shapes/com.planetscale.api#DatabaseBranch/members/deletion_protected/traits/smithy.api#required"
    },
    {
      "op": "remove",
      "path": "/shapes/com.planetscale.api#DatabaseBranch/members/sharded/traits/smithy.api#required"
    },
    {
      "op": "remove",
      "path": "/shapes/com.planetscale.api#DatabaseBranch/members/keyspace_count/traits/smithy.api#required"
    },
    {
      "op": "add",
      "path": "/shapes/com.planetscale.api#DatabaseBranch/members/cluster_architecture",
      "value": {
        "target": "smithy.api#String"
      }
    }
  ]
}
