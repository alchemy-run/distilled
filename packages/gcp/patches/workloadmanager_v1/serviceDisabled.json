{
  "description": "Type the SERVICE_DISABLED 403 on every operation so callers can tell a disabled API from an IAM denial. Observed live 2026-09-29 on the testing project with the API disabled.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.gcp.workloadmanager_v1#ServiceDisabled",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 403,
          "smithy.api#documentation": "The API is not enabled on the project (HTTP 403 PERMISSION_DENIED, reason SERVICE_DISABLED: '\u2026 API has not been used in project \u2026 before or it is disabled.'). Enable the API; not retryable until then.",
          "com.gcp.protocols#errorMatchers": [
            {
              "status": 403,
              "message": {
                "includes": "has not been used in project"
              }
            }
          ]
        }
      }
    },
