    },
    {
      "op": "remove",
      "path": "/shapes/com.gcp.workloadmanager_v1#Pacemaker/members/sqlPacemakerSecret/traits/smithy.api#sensitive"
    },
    {
      "op": "remove",
      "path": "/shapes/com.gcp.workloadmanager_v1#Pacemaker/members/pacemakerClusterSecret/traits/smithy.api#sensitive"
    },
    {
      "op": "remove",
      "path": "/shapes/com.gcp.workloadmanager_v1#Database/members/secretManagerSecret/traits/smithy.api#sensitive"
    },
    {
      "op": "remove",
      "path": "/shapes/com.gcp.workloadmanager_v1#DatabaseDetails/members/secretManagerSecret/traits/smithy.api#sensitive"
    },
    {
      "op": "remove",
      "path": "/shapes/com.gcp.workloadmanager_v1#AppDetails/members/secretManagerSecret/traits/smithy.api#sensitive"
    }
  ]
