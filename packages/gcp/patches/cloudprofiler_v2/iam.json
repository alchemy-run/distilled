{
  "description": "What each cloudprofiler_v2 operation is authorized as (core OperationIam): the IAM permission the method checks and the smallest predefined role that holds it, as Alchemy's GCP bindings grant them and their live probe suites verify (alchemy-run/alchemy#2753). Discovery documents carry no IAM, so this is the record; correct a method here when a live call disagrees.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.gcp.cloudprofiler_v2#CreateOfflineProjectsProfiles/traits/com.distilled.iam#operation",
      "value": {
        "actions": ["cloudprofiler.profiles.update"],
        "roles": ["roles/cloudprofiler.agent"]
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.cloudprofiler_v2#CreateProjectsProfiles/traits/com.distilled.iam#operation",
      "value": {
        "actions": ["cloudprofiler.profiles.create"],
        "roles": ["roles/cloudprofiler.agent"]
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.cloudprofiler_v2#ListProjectsProfiles/traits/com.distilled.iam#operation",
      "value": {
        "actions": ["cloudprofiler.profiles.list"],
        "roles": ["roles/cloudprofiler.viewer"]
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.cloudprofiler_v2#PatchProjectsProfiles/traits/com.distilled.iam#operation",
      "value": {
        "actions": ["cloudprofiler.profiles.update"],
        "roles": ["roles/cloudprofiler.agent"]
      }
    }
  ]
}
