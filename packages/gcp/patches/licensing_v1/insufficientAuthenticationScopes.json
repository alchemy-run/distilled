{
  "description": "Type the HTTP 403 the Enterprise License Manager API returns for a token without its OAuth scope. It surfaced as a generic Forbidden, indistinguishable from a missing IAM permission.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.gcp.licensing_v1#InsufficientAuthenticationScopes",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 403,
          "smithy.api#documentation": "The credential lacks the https://www.googleapis.com/auth/apps.licensing OAuth scope (HTTP 403 'Request had insufficient authentication scopes.'). A Cloud Platform-scoped service account token cannot call the License Manager API; not retryable.",
          "com.gcp.protocols#errorMatchers": [
            {
              "status": 403,
              "message": {
                "includes": "insufficient authentication scopes"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.licensing_v1#DeleteLicenseAssignments/errors/-",
      "value": {
        "target": "com.gcp.licensing_v1#InsufficientAuthenticationScopes"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.licensing_v1#GetLicenseAssignments/errors/-",
      "value": {
        "target": "com.gcp.licensing_v1#InsufficientAuthenticationScopes"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.licensing_v1#InsertLicenseAssignments/errors/-",
      "value": {
        "target": "com.gcp.licensing_v1#InsufficientAuthenticationScopes"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.licensing_v1#ListForProductAndSkuLicenseAssignments/errors/-",
      "value": {
        "target": "com.gcp.licensing_v1#InsufficientAuthenticationScopes"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.licensing_v1#ListForProductLicenseAssignments/errors/-",
      "value": {
        "target": "com.gcp.licensing_v1#InsufficientAuthenticationScopes"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.licensing_v1#PatchLicenseAssignments/errors/-",
      "value": {
        "target": "com.gcp.licensing_v1#InsufficientAuthenticationScopes"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.licensing_v1#UpdateLicenseAssignments/errors/-",
      "value": {
        "target": "com.gcp.licensing_v1#InsufficientAuthenticationScopes"
      }
    }
  ]
}
