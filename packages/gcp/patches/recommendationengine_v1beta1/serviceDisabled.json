{
  "description": "Type calls to a project where the API is disabled. It surfaced as a plain Forbidden, so an un-enabled API was indistinguishable from a missing IAM grant.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.gcp.recommendationengine_v1beta1#ServiceDisabled",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 403,
          "smithy.api#documentation": "The API is not enabled on the project (HTTP 403 PERMISSION_DENIED, reason SERVICE_DISABLED: \"<API> has not been used in project <n> before or it is disabled.\").",
          "com.gcp.protocols#errorMatchers": [
            {
              "status": 403,
              "message": {
