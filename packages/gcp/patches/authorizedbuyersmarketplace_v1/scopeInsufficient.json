{
  "description": "Type the missing-OAuth-scope 403 on every Authorized Buyers Marketplace operation. The API requires the authorized-buyers-marketplace scope; a cloud-platform token gets 403 PERMISSION_DENIED (ACCESS_TOKEN_SCOPE_INSUFFICIENT), which surfaced as a generic Forbidden indistinguishable from an IAM denial. Observed live 2026-09-29 on getBuyersClientsUsers/createBuyersClientsUsers.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.gcp.authorizedbuyersmarketplace_v1#AuthorizedBuyersScopeInsufficient",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 403,
          "smithy.api#documentation": "The access token lacks the `https://www.googleapis.com/auth/authorized-buyers-marketplace` OAuth scope (HTTP 403 PERMISSION_DENIED, reason ACCESS_TOKEN_SCOPE_INSUFFICIENT: 'Request had insufficient authentication scopes.'). A `cloud-platform` token is not enough. Not retryable.",
          "com.gcp.protocols#errorMatchers": [
            {
              "status": 403,
              "message": {
                "includes": "insufficient authentication scopes"
              }
            }
          ]
        }
      }
    },
