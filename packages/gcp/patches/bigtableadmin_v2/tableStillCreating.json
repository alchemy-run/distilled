{
  "description": "Type Bigtable's 400 for a table that is still being created. Observed live 2026-10-27: deleting a table whose column-family change is still applying, and reading or reading the IAM policy of a table being restored by UndeleteTable, answer 400 '... is still being created' or '... is either creating or deleting, please try again'. It surfaced as an out-of-union BadRequest, so callers could not wait it out with a typed retry.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.gcp.bigtableadmin_v2#TableStillCreating",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 400,
          "smithy.api#documentation": "The table is still being created, modified, restored or deleted (HTTP 400: '... is still being created' / '... is either creating or deleting'). Retryable after a short wait.",
          "com.gcp.protocols#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "is still being created"
              }
            },
            {
              "status": 400,
              "message": {
                "includes": "is either creating or deleting"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.bigtableadmin_v2#GetProjectsInstancesTables/errors/-",
      "value": {
        "target": "com.gcp.bigtableadmin_v2#TableStillCreating"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.bigtableadmin_v2#DeleteProjectsInstancesTables/errors/-",
      "value": {
        "target": "com.gcp.bigtableadmin_v2#TableStillCreating"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.bigtableadmin_v2#UndeleteProjectsInstancesTables/errors/-",
      "value": {
        "target": "com.gcp.bigtableadmin_v2#TableStillCreating"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.bigtableadmin_v2#GetIamPolicyProjectsInstancesTables/errors/-",
      "value": {
        "target": "com.gcp.bigtableadmin_v2#TableStillCreating"
      }
    }
  ]
}
