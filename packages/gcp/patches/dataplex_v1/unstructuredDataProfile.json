        "members": {
          "globalEndpointEnabled": {
            "target": "smithy.api#Boolean",
            "traits": {
              "smithy.api#documentation": "Optional. Whether to use the global model endpoint."
            }
          },
          "semanticInferenceEnabled": {
            "target": "smithy.api#Boolean",
            "traits": {
              "smithy.api#documentation": "Optional. Specifies whether deeper semantic inference over the objects' contents using GenAI is enabled."
            }
          }
        },
        "traits": {
          "smithy.api#documentation": "Describes options for unstructured data discovery."
        }
      }
    },
