{
  "description": "Type the missing-OAuth-scope 403 on Vault matter operations; it surfaced as a generic Forbidden indistinguishable from an IAM denial. Observed live 2026-09-29 on getMatters/createMatters (and holds, exports, saved queries) with a cloud-platform token.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.gcp.vault_v1#VaultScopeInsufficient",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 403,
          "smithy.api#documentation": "The access token lacks the Vault OAuth scope (`https://www.googleapis.com/auth/ediscovery`) (HTTP 403 PERMISSION_DENIED, reason ACCESS_TOKEN_SCOPE_INSUFFICIENT: 'Request had insufficient authentication scopes.'). A `cloud-platform` token is not enough. Not retryable.",
          "com.gcp.protocols#errorMatchers": [
            {
              "status": 403,
              "message": {
                "includes": "insufficient authentication scopes"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.vault_v1#AddHeldAccountsMattersHolds/errors/-",
      "value": {
        "target": "com.gcp.vault_v1#VaultScopeInsufficient"
      }
    },
