{
  "description": "Type BigLake's 403 answer for a missing catalog/database/table. It surfaced as a plain Forbidden, so callers treated every permission error as 'gone'.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.gcp.biglake_v1#BigLakeResourceNotFound",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 403,
          "smithy.api#documentation": "BigLake answers a missing catalog, database or table with HTTP 403 PERMISSION_DENIED: \"Permission 'biglake.<kind>.get' denied on resource '...' (or it may not exist).\" \u2014 verified live with a caller that can read existing resources.",
          "com.gcp.protocols#errorMatchers": [
            {
              "status": 403,
              "message": {
                "includes": "(or it may not exist)"
              }
            }
          ]
        }
      }
    },
