{
  "description": "Type OS Login's user/credential mismatch (HTTP 403, e.g. `users/me` with a service-account token). It surfaced as the generic Forbidden, indistinguishable from a missing permission.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.gcp.oslogin_v1#UserCredentialMismatch",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 403,
          "smithy.api#documentation": "The `users/{user}` in the request is not the authenticated identity (HTTP 403: 'End user credentials must match the user specified in the request.'). Service accounts cannot use `users/me`; name the account email instead.",
          "com.gcp.protocols#errorMatchers": [
            {
              "status": 403,
              "message": {
                "includes": "credentials must match the user specified"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.oslogin_v1#CreateUsersSshPublicKeys/errors/-",
      "value": {
        "target": "com.gcp.oslogin_v1#UserCredentialMismatch"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.oslogin_v1#DeleteUsersProjects/errors/-",
      "value": {
        "target": "com.gcp.oslogin_v1#UserCredentialMismatch"
      }
    },
    {
