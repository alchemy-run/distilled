{
  "description": "What each serviceusage_v1 operation is authorized as (core OperationIam): the IAM permission the method checks and the smallest predefined role that holds it, as Alchemy's GCP bindings grant them and their live probe suites verify (alchemy-run/alchemy#2753). Discovery documents carry no IAM, so this is the record; correct a method here when a live call disagrees.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.gcp.serviceusage_v1#BatchEnableServices/traits/com.distilled.iam#operation",
      "value": {
        "actions": ["serviceusage.services.enable"],
        "roles": ["roles/serviceusage.serviceUsageAdmin"]
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.serviceusage_v1#BatchGetServices/traits/com.distilled.iam#operation",
      "value": {
        "actions": ["serviceusage.services.get"],
        "roles": ["roles/serviceusage.serviceUsageViewer"]
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.serviceusage_v1#DisableServices/traits/com.distilled.iam#operation",
      "value": {
        "actions": ["serviceusage.services.disable"],
        "roles": ["roles/serviceusage.serviceUsageAdmin"]
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.serviceusage_v1#EnableServices/traits/com.distilled.iam#operation",
      "value": {
        "actions": ["serviceusage.services.enable"],
        "roles": ["roles/serviceusage.serviceUsageAdmin"]
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.serviceusage_v1#GetServices/traits/com.distilled.iam#operation",
      "value": {
        "actions": ["serviceusage.services.get"],
        "roles": ["roles/serviceusage.serviceUsageViewer"]
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.gcp.serviceusage_v1#ListServices/traits/com.distilled.iam#operation",
      "value": {
        "actions": ["serviceusage.services.list"],
        "roles": ["roles/serviceusage.serviceUsageViewer"]
      }
    }
  ]
}
