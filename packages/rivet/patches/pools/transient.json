{
  "description": "The engine answers `400` with \"The command deadline elapsed; its outcome may be unknown.\" when a storage command times out inside a control plane that is still forming or under load (observed against rivet-engine 3.0.0-preview.4 on Fly.io, with Tigris object storage). Type it as a retryable CommandDeadlineElapsed on every operation.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.rivet.pools#CommandDeadlineElapsed",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "server",
          "smithy.api#httpError": 503,
          "smithy.api#retryable": {
            "throttling": true
          },
          "smithy.api#documentation": "A storage command timed out inside the control plane (its outcome may be unknown): answered while the control plane is still forming or under load. Retry after a short delay.",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "command deadline elapsed"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.rivet.pools#PoolsList/errors/-",
      "value": {
        "target": "com.rivet.pools#CommandDeadlineElapsed"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.rivet.pools#PoolsGet/errors/-",
      "value": {
        "target": "com.rivet.pools#CommandDeadlineElapsed"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.rivet.pools#PoolsUpsert/errors/-",
      "value": {
        "target": "com.rivet.pools#CommandDeadlineElapsed"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.rivet.pools#PoolsDelete/errors/-",
      "value": {
        "target": "com.rivet.pools#CommandDeadlineElapsed"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.rivet.pools#PoolsListNodes/errors/-",
      "value": {
        "target": "com.rivet.pools#CommandDeadlineElapsed"
      }
    }
  ]
}
