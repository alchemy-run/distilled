    "com.posthog.today#GetTodayBriefing": {
      "type": "operation",
      "input": {
        "target": "com.posthog.today#GetTodayBriefingRequest"
      },
      "output": {
        "target": "com.posthog.today#Briefing"
      },
      "traits": {
        "smithy.api#http": {
          "method": "GET",
          "uri": "/api/projects/{project_id}/today/briefing/",
          "code": 200
        },
        "smithy.api#documentation": "Get today's briefing\n\nToday's personal briefing: a short text about up to 5 items and the same items for the left bar. A new one is written every morning from 8:00 local time. Starts generating today's when there is none yet and returns it as 'collecting'. While a refresh is being written, the ready briefing is returned as 'writing', so it can stay on screen; poll again after a few seconds. 404 when the person gets no briefing: the flag is off, the organization has not approved AI data processing, or it is out of AI credits."
      }
    },
    "com.posthog.today#TodayBriefingRefreshCreateRequest": {
      "type": "structure",
      "members": {
        "project_id": {
          "target": "smithy.api#String",
