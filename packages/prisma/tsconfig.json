{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    // Ported from distilled PR #360: generated services carry explicit
    // interfaces + `as any as S.Schema<T>` casts, so checking them buys
    // nothing and costs minutes/GBs. Hand-written src files are still checked
    // via tsconfig.strict.json (`pnpm run typecheck:strict`).
    "noCheck": true,
    "paths": {
      "@distilled.cloud/core/*": ["../core/src/*"],
      "@distilled.cloud/aws4signer": ["../aws4signer/src/index.ts"],
      "@distilled.cloud/aws4signer/AwsClient": ["../aws4signer/src/client.ts"]
    }
  },
  "references": [{ "path": "../core" }, { "path": "../aws4signer" }]
}
