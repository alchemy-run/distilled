{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  // Full type checking for the hand-written src files only. src/index.ts is
  // excluded because it re-exports ./services, which would pull every
  // generated module into the checked program.
  "exclude": ["src/services", "src/index.ts"],
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@distilled.cloud/core/*": ["../core/src/*"],
      "@distilled.cloud/s3": ["../s3/src/index.ts"],
      "@distilled.cloud/s3/Credentials": ["../s3/src/credentials.ts"],
      "@distilled.cloud/s3/Endpoint": ["../s3/src/endpoint.ts"]
    }
  }
}
