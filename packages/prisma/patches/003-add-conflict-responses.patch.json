{
  "description": "Declare the 409 conflict responses that consumers already handle but the spec omits, so they land in the typed error unions as Conflict instead of the catch-all.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.prisma#PostV1Connections/errors/1",
      "value": {
        "target": "com.prisma#Conflict"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.prisma#DeleteV1ProjectsById/errors/2",
      "value": {
        "target": "com.prisma#Conflict"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.prisma#PostV1ProjectsByProjectIdDatabases/errors/3",
      "value": {
        "target": "com.prisma#Conflict"
      }
    }
  ]
}
