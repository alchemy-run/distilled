{
  "description": "Add pulls.getDiff: pulls.get under the diff/patch media types, which return the raw text. The spec documents the media types in prose but models only the JSON response.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.github.pulls#GetDiffMediaType",
      "value": {
        "type": "enum",
        "members": {
          "DIFF": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "application/vnd.github.diff" }
          },
          "PATCH": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "application/vnd.github.patch" }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.github.pulls#GetDiffRequest",
      "value": {
        "type": "structure",
        "members": {
          "owner": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#httpLabel": {},
              "smithy.api#required": {},
              "smithy.api#documentation": "The account owner of the repository. The name is not case sensitive."
            }
          },
          "repo": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#httpLabel": {},
              "smithy.api#required": {},
              "smithy.api#documentation": "The name of the repository without the `.git` extension. The name is not case sensitive."
            }
          },
          "pull_number": {
            "target": "smithy.api#Integer",
            "traits": {
              "smithy.api#httpLabel": {},
              "smithy.api#required": {},
              "smithy.api#documentation": "The number that identifies the pull request."
            }
          },
          "accept": {
            "target": "com.github.pulls#GetDiffMediaType",
            "traits": {
              "smithy.api#httpHeader": "Accept",
              "smithy.api#required": {},
              "smithy.api#documentation": "`application/vnd.github.diff` for the unified diff, `application/vnd.github.patch` for the commits as patches."
            }
          }
        },
        "traits": { "smithy.api#input": {} }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.github.pulls#GetDiffResponse",
      "value": {
        "type": "structure",
        "members": {
          "body": {
            "target": "smithy.api#String",
            "traits": { "com.distilled.openapi#rawResponse": {}, "smithy.api#required": {} }
          }
        },
        "traits": { "smithy.api#output": {} }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.github.pulls#GetDiff",
      "value": {
        "type": "operation",
        "input": { "target": "com.github.pulls#GetDiffRequest" },
        "output": { "target": "com.github.pulls#GetDiffResponse" },
        "errors": [
          { "target": "com.github.pulls#NotFound" },
          { "target": "com.github.pulls#UnprocessableEntity" }
        ],
        "traits": {
          "smithy.api#http": {
            "method": "GET",
            "uri": "/repos/{owner}/{repo}/pulls/{pull_number}",
            "code": 200
          },
          "smithy.api#documentation": "Get a pull request as a diff or patch\n\nThe text form of `pulls.get`: the unified diff (`application/vnd.github.diff`) or the commits as patches (`application/vnd.github.patch`). GitHub refuses diffs over 20,000 lines or 300 files; list them page by page with `pulls.listFiles` instead."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.github.pulls#Pulls/operations/-",
      "value": { "target": "com.github.pulls#GetDiff" }
    }
  ]
}
