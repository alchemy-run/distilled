{
  "description": "Add repos.getById: GET /repositories/{id}, which GitHub serves but the spec omits. The numeric id survives renames and transfers, so it is how a client finds a repository whose name changed.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.github.repos#GetByIdRequest",
      "value": {
        "type": "structure",
        "members": {
          "id": {
            "target": "smithy.api#Integer",
            "traits": {
              "smithy.api#httpLabel": {},
              "smithy.api#required": {},
              "smithy.api#documentation": "The unique identifier of the repository."
            }
          }
        },
        "traits": { "smithy.api#input": {} }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.github.repos#GetById",
      "value": {
        "type": "operation",
        "input": { "target": "com.github.repos#GetByIdRequest" },
        "output": { "target": "com.github.repos#FullRepository" },
        "errors": [
          { "target": "com.github.repos#Forbidden" },
          { "target": "com.github.repos#NotFound" }
        ],
        "traits": {
          "smithy.api#http": { "method": "GET", "uri": "/repositories/{id}", "code": 200 },
          "smithy.api#documentation": "Get a repository by id\n\nThe repository's numeric id is stable across renames and transfers, so this finds a repository whose name changed. Undocumented in GitHub's REST reference, but served by the API."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.github.repos#Repos/operations/-",
      "value": { "target": "com.github.repos#GetById" }
    }
  ]
}
