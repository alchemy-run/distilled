{
  "description": "Type the live-observed app/function failures. Inngest returns { errors: [{ code, message }] } with a string code, so matchers address /errors/0/code. getV2App/getV2Function answer 404 not_found for a missing app or function; syncV2App answers 422 with app_mismatch (the SDK served at the URL reports a different app id), unknown + \"We could not reach your URL\" (host unreachable), or unauthorized (the host signs with a different signing key). The spec documents the 422 body as SyncAppResponse; the wire body is the error envelope.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.inngest.api#AppNotFound",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "smithy.api#documentation": "The app does not exist in the environment (Inngest `not_found`, HTTP 404).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404,
              "body": {
                "/errors/0/code": "not_found"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.api#FunctionNotFound",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "smithy.api#documentation": "The function (or its app) does not exist in the environment (Inngest `not_found`, HTTP 404).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404,
              "body": {
                "/errors/0/code": "not_found"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.api#AppIdMismatch",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 422,
          "smithy.api#documentation": "The SDK served at the sync URL reports a different app id than the one being synced (Inngest `app_mismatch`, HTTP 422).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 422,
              "body": {
                "/errors/0/code": "app_mismatch"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.api#AppUnreachable",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 422,
          "smithy.api#documentation": "Inngest could not reach the sync URL (HTTP 422 `http_unreachable`, or \"We could not reach your URL\").",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 422,
              "body": {
                "/errors/0/code": "http_unreachable"
              }
            },
            {
              "status": 422,
              "message": {
                "includes": "could not reach your URL"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.api#AppUnauthorized",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 422,
          "smithy.api#documentation": "The app at the sync URL rejected Inngest because it signs with a different signing key (Inngest `unauthorized`, HTTP 422).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 422,
              "body": {
                "/errors/0/code": "unauthorized"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.api#V2GetApp/errors",
      "value": [
        {
          "target": "com.inngest.api#AppNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.api#V2GetFunction/errors",
      "value": [
        {
          "target": "com.inngest.api#FunctionNotFound"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.api#V2SyncApp/errors/-",
      "value": {
        "target": "com.inngest.api#AppIdMismatch"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.api#V2SyncApp/errors/-",
      "value": {
        "target": "com.inngest.api#AppUnreachable"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.api#V2SyncApp/errors/-",
      "value": {
        "target": "com.inngest.api#AppUnauthorized"
      }
    }
  ]
}
