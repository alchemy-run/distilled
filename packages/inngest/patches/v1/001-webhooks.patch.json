{
  "description": "The v1 webhook endpoints. The spec wraps the create body in { data: { id, name, url, transform } } and points every success response at #/components/responses/Webhook as if it were a schema, so the generated client sent the wrong body and decoded unknown. The wire takes the flat Webhook { name, transform } that PUT documents (both required: a transform-only PUT answers 400) and answers { data: { id, name, url, transform, created_at, updated_at } } (a list for GET /v1/webhooks). Live probes against https://api.inngest.com/v1 with a branch-environment signing key on 2026-10-07: GET, PUT and DELETE /v1/webhooks/{id} answer 404 { error: \"Webhook not found\", data: null, status: 404 } for an unknown or deleted id, and 400 { error: \"Invalid webhook ID: <id>\" } for a non-UUID id.",
  "patches": [
    {
      "op": "replace",
      "path": "/paths/~1v1~1webhooks/post/requestBody/content/application~1json/schema/$ref",
      "value": "#/components/schemas/Webhook"
    },
    {
      "op": "add",
      "path": "/components/schemas/Webhook/required",
      "value": ["name", "transform"]
    },
    {
      "op": "add",
      "path": "/components/schemas/WebhookRecord",
      "value": {
        "type": "object",
        "required": ["id", "name", "url", "transform"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the webhook endpoint"
          },
          "name": {
            "type": "string",
            "description": "A custom descripter for the webhook endpoint"
          },
          "url": {
            "type": "string",
            "format": "url",
            "description": "Unique URL endpoint"
          },
          "transform": {
            "type": "string",
            "description": "A JavaScript transform function that accepts the inbound request components and returns an object in the Inngest event payload format."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/WebhookResponse",
      "value": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/WebhookRecord"
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/components/schemas/WebhookListResponse",
      "value": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WebhookRecord"
            }
          }
        }
      }
    },
    {
      "op": "replace",
      "path": "/paths/~1v1~1webhooks/get/responses/200/content/application~1json/schema/$ref",
      "value": "#/components/schemas/WebhookListResponse"
    },
    {
      "op": "replace",
      "path": "/paths/~1v1~1webhooks/post/responses/200/content/application~1json/schema/$ref",
      "value": "#/components/schemas/WebhookResponse"
    },
    {
      "op": "replace",
      "path": "/paths/~1v1~1webhooks~1{id}/get/responses/200/content/application~1json/schema/$ref",
      "value": "#/components/schemas/WebhookResponse"
    },
    {
      "op": "replace",
      "path": "/paths/~1v1~1webhooks~1{id}/put/responses/200/content/application~1json/schema/$ref",
      "value": "#/components/schemas/WebhookResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.v1#WebhookNotFound",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 404,
          "smithy.api#documentation": "No webhook has the given id (HTTP 404 \"Webhook not found\").",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404,
              "message": {
                "includes": "Webhook not found"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.v1#InvalidWebhookId",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 400,
          "smithy.api#documentation": "The webhook id is not a UUID (HTTP 400 \"Invalid webhook ID\").",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "Invalid webhook ID"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.v1#GetWebhook/errors",
      "value": [
        {
          "target": "com.inngest.v1#WebhookNotFound"
        },
        {
          "target": "com.inngest.v1#InvalidWebhookId"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.v1#UpdateWebhook/errors",
      "value": [
        {
          "target": "com.inngest.v1#WebhookNotFound"
        },
        {
          "target": "com.inngest.v1#InvalidWebhookId"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.inngest.v1#DeleteWebhook/errors",
      "value": [
        {
          "target": "com.inngest.v1#WebhookNotFound"
        },
        {
          "target": "com.inngest.v1#InvalidWebhookId"
        }
      ]
    }
  ]
}
