{
  "description": "Mark the minted secrets sensitive so they decode as Redacted: the platform API token (createAPIToken) and the database/group SQL auth JWTs (createDatabaseToken, createGroupToken).",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.turso.api#CreateDatabaseTokenResponse/members/jwt/traits/smithy.api#sensitive",
      "value": {}
    },
    {
      "op": "add",
      "path": "/shapes/com.turso.api#CreateGroupTokenResponse/members/jwt/traits/smithy.api#sensitive",
      "value": {}
    },
    {
      "op": "add",
      "path": "/shapes/com.turso.api#CreateAPITokenResponse/members/token/traits/smithy.api#sensitive",
      "value": {}
    }
  ]
}
