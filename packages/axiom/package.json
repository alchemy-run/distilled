{
  "name": "@distilled.cloud/axiom",
  "version": "1.0.0-rc.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchemy-run/distilled",
    "directory": "packages/axiom"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "lib",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "worker": "./src/credentials.ts",
      "default": "./lib/credentials.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "worker": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Traits": {
      "types": "./lib/traits.d.ts",
      "bun": "./src/traits.ts",
      "worker": "./src/traits.ts",
      "default": "./lib/traits.js"
    },
    "./Protocol": {
      "types": "./lib/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "worker": "./src/protocol.ts",
      "default": "./lib/protocol.js"
    },
    "./Retry": {
      "types": "./lib/retry.d.ts",
      "bun": "./src/retry.ts",
      "worker": "./src/retry.ts",
      "default": "./lib/retry.js"
    },
    "./edge-ingest": {
      "types": "./lib/edge-ingest.d.ts",
      "bun": "./src/edge-ingest.ts",
      "worker": "./src/edge-ingest.ts",
      "default": "./lib/edge-ingest.js"
    },
    "./edge-query": {
      "types": "./lib/edge-query.d.ts",
      "bun": "./src/edge-query.ts",
      "worker": "./src/edge-query.ts",
      "default": "./lib/edge-query.js"
    },
    "./*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "worker": "./src/services/*.ts",
      "default": "./lib/services/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "convert": "bun scripts/convert.ts",
    "generate": "bun scripts/convert.ts && bun scripts/generate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "specs:fetch": "git submodule update --force --init --depth=1 specs/spec-mirror-axiom",
    "specs:update": "git submodule update --remote --force --depth=1 specs/spec-mirror-axiom"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@effect/platform-bun": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
