          "target": "com.axiom.api#BadRequest"
        },
        {
          "target": "com.axiom.api#NotFound"
        },
        {
          "target": "com.axiom.api#UnprocessableEntity"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.axiom.api#BadRequest",
      "before": "com.axiom.api#AxiomEdgeIngest",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 400,
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 400
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.axiom.api#NotFound",
      "before": "com.axiom.api#AxiomEdgeIngest",
      "value": {
        "type": "structure",
        "members": {},
