          "smithy.api#httpError": 404,
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.axiom.api#UnprocessableEntity",
      "before": "com.axiom.api#AxiomEdgeIngest",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 422,
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 422
            }
          ]
        }
      }
    }
  ]
