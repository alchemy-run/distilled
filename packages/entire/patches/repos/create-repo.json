{
  "description": "Type createRepo's taken-name 409 (`repo/name-in-use`) and invalid-name 400, so callers can recover a retried create from the first only.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.entire.core.repos#RepoNameInUse",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The project already has a repository with this name (HTTP 409, `repo/name-in-use`).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 409,
              "message": {
                "includes": "already exists in this project"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.entire.core.repos#RepoNameInvalid",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The name is not a valid repository name: 1\u201364 lowercase letters, digits, `.` and `-` (HTTP 400).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "invalid name"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.entire.core.repos#CreateRepo/errors",
      "value": [
        {
          "target": "com.entire.core.repos#RepoNameInUse"
        },
        {
          "target": "com.entire.core.repos#RepoNameInvalid"
        }
      ]
    }
  ]
}
