{
  "description": "Type the cell's `repo not in this region` 404 on the repository settings and secrets operations, which alchemy retries while a new repository replicates to its cell",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.entire.cell.repo_settings#RepoNotInRegion",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The repository is not in this cell (HTTP 404 `repo not in this region`). A new repository reaches its cell a few seconds after Core creates it, so this is transient right after a create; otherwise the repository lives in another region's cell.",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404,
              "message": {
                "includes": "not in this region"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.entire.cell.repo_settings#RepoSecretsList/errors",
      "value": [
        {
          "target": "com.entire.cell.repo_settings#RepoNotInRegion"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.entire.cell.repo_settings#RepoSecretSet/errors",
      "value": [
        {
          "target": "com.entire.cell.repo_settings#RepoNotInRegion"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.entire.cell.repo_settings#RepoSecretDelete/errors",
      "value": [
        {
          "target": "com.entire.cell.repo_settings#RepoNotInRegion"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.entire.cell.repo_settings#RepoRunnerSettings/errors",
      "value": [
        {
          "target": "com.entire.cell.repo_settings#RepoNotInRegion"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.entire.cell.repo_settings#RepoPublicSharing/errors",
      "value": [
        {
          "target": "com.entire.cell.repo_settings#RepoNotInRegion"
        }
      ]
    },
    {
      "op": "add",
      "path": "/shapes/com.entire.cell.repo_settings#RepoTrailSettings/errors",
      "value": [
        {
          "target": "com.entire.cell.repo_settings#RepoNotInRegion"
        }
      ]
    }
  ]
}
