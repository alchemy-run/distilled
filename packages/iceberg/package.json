{
  "name": "@distilled.cloud/iceberg",
  "version": "1.0.0-rc.13",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchemy-run/distilled",
    "directory": "packages/iceberg"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "worker": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./Credentials": {
      "types": "./lib/credentials.d.ts",
      "bun": "./src/credentials.ts",
      "worker": "./src/credentials.ts",
      "default": "./lib/credentials.js"
    },
    "./Errors": {
      "types": "./lib/errors.d.ts",
      "bun": "./src/errors.ts",
      "worker": "./src/errors.ts",
      "default": "./lib/errors.js"
    },
    "./Pagination": {
      "types": "./lib/pagination.d.ts",
      "bun": "./src/pagination.ts",
      "worker": "./src/pagination.ts",
      "default": "./lib/pagination.js"
    },
    "./Protocol": {
      "types": "./lib/protocol.d.ts",
      "bun": "./src/protocol.ts",
      "worker": "./src/protocol.ts",
      "default": "./lib/protocol.js"
    },
    "./*": {
      "types": "./lib/services/*.d.ts",
      "bun": "./src/services/*.ts",
      "worker": "./src/services/*.ts",
      "default": "./lib/services/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "convert": "node --conditions=bun scripts/convert.ts",
    "generate": "node --conditions=bun scripts/generate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "specs:fetch": "git submodule update --force --init --depth=1 specs/spec-mirror-iceberg",
    "specs:update": "git submodule update --remote --force --depth=1 specs/spec-mirror-iceberg"
  },
  "dependencies": {
    "@distilled.cloud/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
