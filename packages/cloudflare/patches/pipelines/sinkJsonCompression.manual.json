{
  "description": "Expose JSON sink compression supported by Cloudflare Pipelines create/get/list API. https://developers.cloudflare.com/api/resources/pipelines/subresources/sinks/methods/create/",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.pipelines#SinksCreateRequestFormatJson/members/compression",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "JSON output compression: uncompressed or gzip."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.pipelines#SinksCreateResponseFormatJson/members/compression",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "JSON output compression: uncompressed or gzip."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.pipelines#SinksGetResponseFormatJson/members/compression",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "JSON output compression: uncompressed or gzip."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.pipelines#SinksListResultItemFormatJson/members/compression",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "JSON output compression: uncompressed or gzip."
        }
      }
    }
  ]
}
