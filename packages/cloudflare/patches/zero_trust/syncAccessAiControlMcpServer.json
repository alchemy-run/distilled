{
  "description": "Align MCP server sync operation and its API errors",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zero_trust#AccessAiControlsMcpServersSync",
      "path": "/shapes/com.cloudflare.zero_trust#SyncAccessAiControlMcpServer"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zero_trust#AccessAiControlsMcpServersSyncRequest",
      "path": "/shapes/com.cloudflare.zero_trust#SyncAccessAiControlMcpServerRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.zero_trust#SyncAccessAiControlMcpServer/input/target",
      "value": "com.cloudflare.zero_trust#SyncAccessAiControlMcpServerRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.zero_trust#AccessAiControlsMcpServersSyncResponse",
      "path": "/shapes/com.cloudflare.zero_trust#SyncAccessAiControlMcpServerResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.zero_trust#SyncAccessAiControlMcpServer/output/target",
      "value": "com.cloudflare.zero_trust#SyncAccessAiControlMcpServerResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.zero_trust#SyncAccessAiControlMcpServer/errors",
      "value": [
        {
          "target": "com.cloudflare.zero_trust#McpServerNotFound"
        },
        {
          "target": "com.cloudflare.zero_trust#Forbidden"
        }
      ]
    }
  ]
}
