{
  "description": "Align ai#Run with distilled cloudflare/ai runAi; greedy model_name label so `@cf/org/model` keeps its slashes; type the oversized-input 400",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ai#InputTooBig",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "input too big"
              }
            }
          ]
        }
      }
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai#Run",
      "path": "/shapes/com.cloudflare.ai#RunAi"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai#RunRequest",
      "path": "/shapes/com.cloudflare.ai#RunAiRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai#RunAi/input/target",
      "value": "com.cloudflare.ai#RunAiRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.ai#RunResponse",
      "path": "/shapes/com.cloudflare.ai#RunAiResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai#RunAi/output/target",
      "value": "com.cloudflare.ai#RunAiResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.ai#RunAi/errors",
      "value": [
        {
          "target": "com.cloudflare.ai#ModelNotFound"
        },
        {
          "target": "com.cloudflare.ai#InputTooBig"
        }
      ]
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.ai#RunAi/traits/smithy.api#http/uri",
      "value": "/accounts/{account_id}/ai/run/{model_name+}"
    }
  ]
}
