{
  "description": "Align workers_for_platforms#DispatchNamespacesScriptsSettingsGet with distilled cloudflare/workers-for-platforms getDispatchNamespaceScriptSetting. The settings read also answers 404 \"This Worker has no versions, which means this Worker has no content or versioned settings.\" for a script that has no version yet, the race workers#getScriptScriptAndVersionSetting already types as WorkerHasNoVersions; observed in production on 2026-10-09 right before the first upload of a new dispatch-namespace script, where it surfaced as the untyped NotFound.",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers_for_platforms#DispatchNamespacesScriptsSettingsGet",
      "path": "/shapes/com.cloudflare.workers_for_platforms#GetDispatchNamespaceScriptSetting"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers_for_platforms#DispatchNamespacesScriptsSettingsGetRequest",
      "path": "/shapes/com.cloudflare.workers_for_platforms#GetDispatchNamespaceScriptSettingRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers_for_platforms#GetDispatchNamespaceScriptSetting/input/target",
      "value": "com.cloudflare.workers_for_platforms#GetDispatchNamespaceScriptSettingRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers_for_platforms#DispatchNamespacesScriptsSettingsGetResponse",
      "path": "/shapes/com.cloudflare.workers_for_platforms#GetDispatchNamespaceScriptSettingResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers_for_platforms#GetDispatchNamespaceScriptSetting/output/target",
      "value": "com.cloudflare.workers_for_platforms#GetDispatchNamespaceScriptSettingResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers_for_platforms#GetDispatchNamespaceScriptSetting/errors",
      "value": [
        {
          "target": "com.cloudflare.workers_for_platforms#DispatchNamespaceNotFound"
        },
        {
          "target": "com.cloudflare.workers_for_platforms#DispatchNamespaceScriptNotFound"
        },
        {
          "target": "com.cloudflare.workers_for_platforms#Forbidden"
        },
        {
          "target": "com.cloudflare.workers_for_platforms#WorkerHasNoVersions"
        }
      ]
    }
  ]
}
