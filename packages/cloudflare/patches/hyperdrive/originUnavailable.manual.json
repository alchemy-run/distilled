{
  "description": "Type the transient origin connection errors observed while creating Hyperdrive: a newly provisioned Prisma database, and a newly created Workers VPC Service that has not propagated yet (destination_not_found).",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.hyperdrive#HyperdriveOriginUnavailable",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 400,
              "message": {
                "includes": "Failed to connect to upstream database"
              }
            },
            {
              "status": 400,
              "message": {
                "includes": "destination_not_found"
              }
            },
            {
              "status": 400,
              "message": {
                "includes": "Failed to connect to the provided database"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.hyperdrive#CreateConfig/errors/-",
      "value": {
        "target": "com.cloudflare.hyperdrive#HyperdriveOriginUnavailable"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.hyperdrive#UpdateConfig/errors/-",
      "value": {
        "target": "com.cloudflare.hyperdrive#HyperdriveOriginUnavailable"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.hyperdrive#PatchConfig/errors/-",
      "value": {
        "target": "com.cloudflare.hyperdrive#HyperdriveOriginUnavailable"
      }
    }
  ]
}
