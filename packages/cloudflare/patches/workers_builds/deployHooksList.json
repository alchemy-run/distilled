{
  "description": "Since the 2026-10-30 docs, Cloudflare's docs build shows this result as `unknown`: builds_APIResponse.result became `object or array of object`, and the docs show that wrapper type in place of the operation's own result type. The API did not change. Cloudflare's OpenAPI (cloudflare/api-schemas) still types GET /accounts/{account_id}/builds/workers/{script_name}/deploy_hooks result as an array of builds_DetailedDeployHookResponse. Shapes restored from the docs as mirrored on 2026-10-29 (spec-mirror-cloudflare ff4dc733).",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers_builds#DeployHooksListResultList",
      "value": {
        "type": "list",
        "member": {
          "target": "com.cloudflare.workers_builds#DeployHooksListResultItem"
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers_builds#DeployHooksListResultItem",
      "value": {
        "type": "structure",
        "members": {
          "branch": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Git branch name."
            }
          },
          "created_on": {
            "target": "smithy.api#String"
          },
          "deploy_hook_name": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Deploy hook name (1-58 characters)."
            }
          },
          "deploy_hook_uuid": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Deploy hook UUID."
            }
          },
          "external_script_id": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "System-generated tag of the Worker. This is not the Worker name."
            }
          },
          "latest_build": {
            "target": "com.cloudflare.workers_builds#DeployHooksListResultItemLatestBuild"
          },
          "modified_on": {
            "target": "smithy.api#String"
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers_builds#DeployHooksListResultItemLatestBuild",
      "value": {
        "type": "structure",
        "members": {
          "created_on": {
            "target": "smithy.api#String"
          }
        }
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers_builds#DeployHooksListResponse/members/result/target",
      "value": "com.cloudflare.workers_builds#DeployHooksListResultList"
    }
  ]
}
