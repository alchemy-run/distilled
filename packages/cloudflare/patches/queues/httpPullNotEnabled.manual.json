{
  "description": "Type the Queue pull rejection while HTTP-pull consumer configuration has not propagated (live code 0).",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#QueueHttpPullNotEnabled",
      "value": {
        "type": "structure",
        "members": {
          "code": { "target": "smithy.api#Integer" },
          "message": { "target": "smithy.api#String" }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 0,
              "message": "messages cannot be pulled unless http_pull mode is enabled"
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.queues#PullMessage/errors/-",
      "value": { "target": "com.cloudflare.queues#QueueHttpPullNotEnabled" }
    }
  ]
}
