{
  "description": "Align mtls_certificates#Delete with distilled cloudflare/mtls-certificates deleteMtlsCertificate, and type the 400 `Certificate cannot be deleted while in use.` that the delete returns while a Cloudflare service still references the certificate. Cloudflare keeps returning it for a short while after the last Worker bound to the certificate is deleted, even once the certificate's association list is empty (observed 2026-10 on alchemy destroy; alchemy-run/alchemy#2080).",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.mtls_certificates#Delete",
      "path": "/shapes/com.cloudflare.mtls_certificates#DeleteMtlsCertificate"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.mtls_certificates#DeleteRequest",
      "path": "/shapes/com.cloudflare.mtls_certificates#DeleteMtlsCertificateRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.mtls_certificates#DeleteMtlsCertificate/input/target",
      "value": "com.cloudflare.mtls_certificates#DeleteMtlsCertificateRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.mtls_certificates#DeleteResponse",
      "path": "/shapes/com.cloudflare.mtls_certificates#DeleteMtlsCertificateResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.mtls_certificates#DeleteMtlsCertificate/output/target",
      "value": "com.cloudflare.mtls_certificates#DeleteMtlsCertificateResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.mtls_certificates#DeleteMtlsCertificate/errors",
      "value": [
        {
          "target": "com.cloudflare.mtls_certificates#CertificateNotFound"
        },
        {
          "target": "com.cloudflare.mtls_certificates#CertificateAlreadyDeleted"
        },
        {
          "target": "com.cloudflare.mtls_certificates#CertificateInUse"
        }
      ]
    }
  ]
}
