{
  "description": "Keep the SDK's name updateContainerApplication for PATCH /accounts/{account_id}/containers/applications/{application_id}. The docs list only the Durable Object configuration keys (authorized_keys, wrangler_ssh) and leave out instances, scheduling_policy and affinities; Wrangler's ModifyApplicationRequestBody takes all of them and the full deployment configuration (https://github.com/cloudflare/workers-sdk/blob/main/packages/containers-shared/src/client/models/ModifyApplicationRequestBody.ts). Return the shared ContainerApplicationItem.",
  "patches": [
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.containers#ApplicationsEditRequest/members/configuration/target",
      "value": "com.cloudflare.containers#ContainerApplicationConfiguration"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.containers#ApplicationsEditRequest/members/constraints/target",
      "value": "com.cloudflare.containers#ScheduledApplicationConstraints"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.containers#ApplicationsEditRequest/members/observability/target",
      "value": "com.cloudflare.containers#ContainerApplicationObservability"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.containers#ApplicationsEditRequest/members/instances",
      "value": {
        "target": "smithy.api#Double"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.containers#ApplicationsEditRequest/members/scheduling_policy",
      "value": {
        "target": "com.cloudflare.containers#ContainerSchedulingPolicy"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.containers#ApplicationsEditRequest/members/affinities",
      "value": {
        "target": "smithy.api#Document",
        "traits": {
          "smithy.api#documentation": "Not in the API reference. Wrangler's ModifyApplicationRequestBody has it (https://github.com/cloudflare/workers-sdk/blob/main/packages/containers-shared/src/client/models/ModifyApplicationRequestBody.ts)."
        }
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.containers#ApplicationsEditResponse/members/result/target",
      "value": "com.cloudflare.containers#ContainerApplicationItem"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.containers#ApplicationsEdit/errors",
      "before": "traits",
      "value": [
        {
          "target": "com.cloudflare.containers#InvalidRoute"
        },
        {
          "target": "com.cloudflare.containers#ContainerApplicationNotFound"
        }
      ]
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.containers#ApplicationsEdit",
      "path": "/shapes/com.cloudflare.containers#UpdateContainerApplication"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.containers#UpdateContainerApplication/input/target",
      "value": "com.cloudflare.containers#UpdateContainerApplicationRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.containers#ApplicationsEditRequest",
      "path": "/shapes/com.cloudflare.containers#UpdateContainerApplicationRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.containers#UpdateContainerApplication/output/target",
      "value": "com.cloudflare.containers#UpdateContainerApplicationResponse"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.containers#ApplicationsEditResponse",
      "path": "/shapes/com.cloudflare.containers#UpdateContainerApplicationResponse"
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.containers#ApplicationsEditRequestConfigurationAuthorizedKeysItem"
