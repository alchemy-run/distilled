{
  "description": "Keep the SDK's name createContainerRegistryCredentials for POST /accounts/{account_id}/containers/registries/{domain}/credentials.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.containers#RegistriesCredentialsGenerate/errors",
      "before": "traits",
      "value": [
        {
          "target": "com.cloudflare.containers#InvalidRoute"
        }
      ]
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.containers#RegistriesCredentialsGenerate",
      "path": "/shapes/com.cloudflare.containers#CreateContainerRegistryCredentials"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.containers#RegistriesCredentialsGenerateRequestPermissionsList/member/target",
      "value": "com.cloudflare.containers#CreateContainerRegistryCredentialsRequestPermissionsItem"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.containers#RegistriesCredentialsGenerateRequestPermissionsItem",
      "path": "/shapes/com.cloudflare.containers#CreateContainerRegistryCredentialsRequestPermissionsItem"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.containers#RegistriesCredentialsGenerateRequest/members/permissions/target",
      "value": "com.cloudflare.containers#CreateContainerRegistryCredentialsRequestPermissionsList"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.containers#RegistriesCredentialsGenerateRequestPermissionsList",
      "path": "/shapes/com.cloudflare.containers#CreateContainerRegistryCredentialsRequestPermissionsList"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.containers#CreateContainerRegistryCredentials/input/target",
      "value": "com.cloudflare.containers#CreateContainerRegistryCredentialsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.containers#RegistriesCredentialsGenerateRequest",
      "path": "/shapes/com.cloudflare.containers#CreateContainerRegistryCredentialsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.containers#CreateContainerRegistryCredentials/output/target",
      "value": "com.cloudflare.containers#CreateContainerRegistryCredentialsResponse"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.containers#RegistriesCredentialsGenerateResponse",
      "path": "/shapes/com.cloudflare.containers#CreateContainerRegistryCredentialsResponse"
    }
  ]
}
