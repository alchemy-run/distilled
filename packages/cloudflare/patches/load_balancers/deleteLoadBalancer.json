{
  "description": "Align load_balancers#Delete with distilled cloudflare/load-balancers deleteLoadBalancer: the docs now offer this endpoint under both /zones and /accounts; keep the zone-scope operation the SDK already ships and drop the account twin (its per-scope copies fold back into the shared shapes).",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#DeleteForZone",
      "path": "/shapes/com.cloudflare.load_balancers#DeleteLoadBalancer"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#DeleteForZoneRequest",
      "path": "/shapes/com.cloudflare.load_balancers#DeleteLoadBalancerRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.load_balancers#DeleteLoadBalancer/input/target",
      "value": "com.cloudflare.load_balancers#DeleteLoadBalancerRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#DeleteForZoneResponse",
      "path": "/shapes/com.cloudflare.load_balancers#DeleteLoadBalancerResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.load_balancers#DeleteLoadBalancer/output/target",
      "value": "com.cloudflare.load_balancers#DeleteLoadBalancerResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.load_balancers#DeleteLoadBalancer/errors",
      "value": [
        {
          "target": "com.cloudflare.load_balancers#LoadBalancerNotFound"
        },
        {
          "target": "com.cloudflare.load_balancers#Forbidden"
        }
      ]
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.load_balancers#DeleteForAccount"
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.load_balancers#DeleteForAccountRequest"
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.load_balancers#DeleteForAccountResponse"
    }
  ]
}
