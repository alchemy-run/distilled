{
  "description": "Align load_balancers#Update with distilled cloudflare/load-balancers updateLoadBalancer: the docs now offer this endpoint under both /zones and /accounts; keep the zone-scope operation the SDK already ships and drop the account twin (its per-scope copies fold back into the shared shapes).",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#UpdateForZone",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateLoadBalancer"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#UpdateForZoneRequest",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateLoadBalancerRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateLoadBalancer/input/target",
      "value": "com.cloudflare.load_balancers#UpdateLoadBalancerRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#UpdateForZoneResponse",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateLoadBalancerResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateLoadBalancer/output/target",
      "value": "com.cloudflare.load_balancers#UpdateLoadBalancerResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateLoadBalancer/errors",
      "value": [
        {
          "target": "com.cloudflare.load_balancers#LoadBalancerNotFound"
        },
        {
          "target": "com.cloudflare.load_balancers#LoadBalancingNotEnabledForZone"
        },
        {
          "target": "com.cloudflare.load_balancers#Forbidden"
        }
      ]
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateForAccount"
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateForAccountRequest"
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.load_balancers#UpdateForAccountResponse"
    }
  ]
}
