{
  "description": "Align load_balancers#Get with distilled cloudflare/load-balancers getLoadBalancer: the docs now offer this endpoint under both /zones and /accounts; keep the zone-scope operation the SDK already ships and drop the account twin (its per-scope copies fold back into the shared shapes).",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#GetForZone",
      "path": "/shapes/com.cloudflare.load_balancers#GetLoadBalancer"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#GetForZoneRequest",
      "path": "/shapes/com.cloudflare.load_balancers#GetLoadBalancerRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.load_balancers#GetLoadBalancer/input/target",
      "value": "com.cloudflare.load_balancers#GetLoadBalancerRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.load_balancers#GetForZoneResponse",
      "path": "/shapes/com.cloudflare.load_balancers#GetLoadBalancerResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.load_balancers#GetLoadBalancer/output/target",
      "value": "com.cloudflare.load_balancers#GetLoadBalancerResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.load_balancers#GetLoadBalancer/errors",
      "value": [
        {
          "target": "com.cloudflare.load_balancers#LoadBalancerNotFound"
        },
        {
          "target": "com.cloudflare.load_balancers#Forbidden"
        }
      ]
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.load_balancers#GetForAccount"
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.load_balancers#GetForAccountRequest"
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.load_balancers#GetForAccountResponse"
    }
  ]
}
