{
  "description": "Align accounts#SubscriptionsCreate with distilled cloudflare/accounts createSubscription: the docs now offer this endpoint under both /accounts and /zones; keep the account-scope operation the SDK already ships and drop the zone twin (its per-scope copies fold back into the shared shapes).",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#SubscriptionsCreateForAccount",
      "path": "/shapes/com.cloudflare.accounts#CreateSubscription"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#SubscriptionsCreateForAccountRequest",
      "path": "/shapes/com.cloudflare.accounts#CreateSubscriptionRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.accounts#CreateSubscription/input/target",
      "value": "com.cloudflare.accounts#CreateSubscriptionRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#SubscriptionsCreateForAccountResponse",
      "path": "/shapes/com.cloudflare.accounts#CreateSubscriptionResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.accounts#CreateSubscription/output/target",
      "value": "com.cloudflare.accounts#CreateSubscriptionResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.accounts#CreateSubscription/errors",
      "value": [
        {
          "target": "com.cloudflare.accounts#JsonDecodeFailure"
        },
        {
          "target": "com.cloudflare.accounts#InvalidRoute"
        }
      ]
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.accounts#SubscriptionsCreateForZone"
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.accounts#SubscriptionsCreateForZoneRequest"
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.accounts#SubscriptionsCreateForZoneResponse"
    }
  ]
}
