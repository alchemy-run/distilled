{
  "description": "Align accounts#SubscriptionsGet with distilled cloudflare/accounts getSubscription: the docs now offer this endpoint under both /accounts and /zones; keep the account-scope operation the SDK already ships and drop the zone twin (its per-scope copies fold back into the shared shapes).",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#SubscriptionsGetForAccount",
      "path": "/shapes/com.cloudflare.accounts#GetSubscription"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#SubscriptionsGetForAccountRequest",
      "path": "/shapes/com.cloudflare.accounts#GetSubscriptionRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.accounts#GetSubscription/input/target",
      "value": "com.cloudflare.accounts#GetSubscriptionRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.accounts#SubscriptionsGetForAccountResponse",
      "path": "/shapes/com.cloudflare.accounts#GetSubscriptionResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.accounts#GetSubscription/output/target",
      "value": "com.cloudflare.accounts#GetSubscriptionResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.accounts#GetSubscription/traits/smithy.api#paginated",
      "value": {
        "mode": "single",
        "items": "result"
      }
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.accounts#SubscriptionsGetForZone"
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.accounts#SubscriptionsGetForZoneRequest"
    },
    {
      "op": "remove",
      "path": "/shapes/com.cloudflare.accounts#SubscriptionsGetForZoneResponse"
    }
  ]
}
