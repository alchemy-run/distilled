{
  "description": "Cloudflare's Workers observability destination endpoint paginates with a `page` query but omits `result_info` (verified live 2026-10-18); mark it page-paginated and align the operation name and forbidden error.",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ObservabilityDestinationsList",
      "path": "/shapes/com.cloudflare.workers#ListObservabilityDestinations"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ObservabilityDestinationsListRequest",
      "path": "/shapes/com.cloudflare.workers#ListObservabilityDestinationsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#ListObservabilityDestinations/input/target",
      "value": "com.cloudflare.workers#ListObservabilityDestinationsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.workers#ObservabilityDestinationsListResponse",
      "path": "/shapes/com.cloudflare.workers#ListObservabilityDestinationsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.workers#ListObservabilityDestinations/output/target",
      "value": "com.cloudflare.workers#ListObservabilityDestinationsResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#ListObservabilityDestinations/traits/smithy.api#paginated",
      "value": {
        "mode": "page",
        "items": "result",
        "inputToken": "page"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#ListObservabilityDestinations/errors",
      "value": [
        {
          "target": "com.cloudflare.workers#Forbidden"
        }
      ]
    }
  ]
}
