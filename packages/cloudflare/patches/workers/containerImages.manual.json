{
  "description": "Durable Object-managed containers carry the application name and a map of named, prepared image references in Worker metadata. Preserve these fields on uploads and beta version responses, and expose containers in resources.script_runtime on script-version create/get responses. Image names are literal keys: an empty keyDictionary prevents the Workers fallback dictionary from renaming names such as class_name. Sources: https://github.com/cloudflare/workers-sdk/blob/main/packages/deploy-helpers/src/deploy/helpers/durable-object-container-applications.ts and https://github.com/cloudflare/workers-sdk/blob/main/packages/deploy-helpers/src/deploy/helpers/versions-types.ts (2026-09-30).",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#ContainerImageMap",
      "value": {
        "type": "map",
        "key": {
          "target": "smithy.api#String"
        },
        "value": {
          "target": "smithy.api#String"
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#BetaWorkersVersionsCreateRequestContainersItem/members/name",
      "value": {
        "target": "smithy.api#String"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#BetaWorkersVersionsCreateRequestContainersItem/members/images",
      "value": {
        "target": "com.cloudflare.workers#ContainerImageMap",
        "traits": {
          "com.cloudflare.protocols#keyDictionary": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#BetaWorkersVersionsCreateResponseContainersItem/members/name",
      "value": {
        "target": "smithy.api#String"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#BetaWorkersVersionsCreateResponseContainersItem/members/images",
      "value": {
        "target": "com.cloudflare.workers#ContainerImageMap",
        "traits": {
          "com.cloudflare.protocols#keyDictionary": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#BetaWorkersVersionsGetResponseContainersItem/members/name",
      "value": {
        "target": "smithy.api#String"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#BetaWorkersVersionsGetResponseContainersItem/members/images",
      "value": {
        "target": "com.cloudflare.workers#ContainerImageMap",
        "traits": {
          "com.cloudflare.protocols#keyDictionary": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#BetaWorkersVersionsListResultItemContainersItem/members/name",
      "value": {
        "target": "smithy.api#String"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#BetaWorkersVersionsListResultItemContainersItem/members/images",
      "value": {
        "target": "com.cloudflare.workers#ContainerImageMap",
        "traits": {
          "com.cloudflare.protocols#keyDictionary": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#ScriptsVersionsCreateResponseResourcesScriptRuntime/members/containers",
      "value": {
        "target": "com.cloudflare.workers#BetaWorkersVersionsCreateResponseContainersList"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.workers#ScriptsVersionsGetResponseResourcesScriptRuntime/members/containers",
      "value": {
        "target": "com.cloudflare.workers#BetaWorkersVersionsGetResponseContainersList"
      }
    }
  ]
}
