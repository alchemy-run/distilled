{
  "description": "Type the Magic WAN entitlement rejection: accounts without Magic WAN get HTTP 403 code 1101 'forbidden: feature not enabled' on every site/app operation (previously only the generic status-403 Forbidden).",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.magic_transit#MagicWanNotEnabled",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "code": 1101,
              "message": {
                "includes": "feature not enabled"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.magic_transit#CreateApp/errors/-",
      "value": {
        "target": "com.cloudflare.magic_transit#MagicWanNotEnabled"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.magic_transit#CreateSite/errors/-",
      "value": {
        "target": "com.cloudflare.magic_transit#MagicWanNotEnabled"
      }
    },
