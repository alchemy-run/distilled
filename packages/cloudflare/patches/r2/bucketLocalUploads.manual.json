            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Cloudflare account ID that owns the R2 resource.",
              "smithy.api#httpLabel": {},
              "smithy.api#required": {}
            }
          },
          "bucket_name": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#documentation": "Name of the bucket.",
              "smithy.api#httpLabel": {},
              "smithy.api#required": {}
