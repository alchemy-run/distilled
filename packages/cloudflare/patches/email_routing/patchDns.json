{
  "description": "Align email_routing#DnsEdit with distilled cloudflare/email-routing patchDns, and type the missing-subdomain error",
  "patches": [
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_routing#DnsEdit",
      "path": "/shapes/com.cloudflare.email_routing#PatchDns"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_routing#DnsEditRequest",
      "path": "/shapes/com.cloudflare.email_routing#PatchDnsRequest"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_routing#PatchDns/input/target",
      "value": "com.cloudflare.email_routing#PatchDnsRequest"
    },
    {
      "op": "move",
      "from": "/shapes/com.cloudflare.email_routing#DnsEditResponse",
      "path": "/shapes/com.cloudflare.email_routing#PatchDnsResponse"
    },
    {
      "op": "replace",
      "path": "/shapes/com.cloudflare.email_routing#PatchDns/output/target",
      "value": "com.cloudflare.email_routing#PatchDnsResponse"
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_routing#EmailRoutingSubdomainNotFound",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#Integer"
          },
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "com.cloudflare.protocols#errorMatchers": [
            {
              "status": 404,
              "message": {
                "includes": "Subdomain not found"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.cloudflare.email_routing#PatchDns/errors",
      "value": [
        {
          "target": "com.cloudflare.email_routing#EmailRoutingSubdomainNotFound"
        }
      ]
    }
  ]
}
