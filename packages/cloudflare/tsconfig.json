{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "./lib",
    "rootDir": "./src",
    "paths": {
      "@distilled.cloud/core/*": ["../core/src/*"],
      "@distilled.cloud/s3/Credentials": ["../s3/src/credentials.ts"],
      "@distilled.cloud/s3/Endpoint": ["../s3/src/endpoint.ts"],
      "@distilled.cloud/s3": ["../s3/src/index.ts"]
    },
    "lib": ["ESNext", "DOM"]
  },
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../s3"
    }
  ]
}
