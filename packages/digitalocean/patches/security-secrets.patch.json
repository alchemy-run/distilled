{
  "description": "Secrets: the `secret` member is the secret's NAME (`probe-secret-24762`) and the converter marked it sensitive by its member name, while the stored `values` were left plain; swap them. A deleted secret stays pending deletion (GET returns it with `delete_requested_at` and `values: null`), and both POST /v2/security/secrets for its name and DELETE of it again answer 409 `conflict` (live responses, alchemy DigitalOcean Secret suite); type that as SecretPendingDeletion so a reconcile restores the secret and a delete treats it as gone. Identity fields are always returned. `values` is `null` on a secret pending deletion.",
  "patches": [
    {
      "op": "remove",
      "path": "/shapes/com.digitalocean.api#Secret/members/secret/traits/smithy.api#sensitive"
    },
    {
      "op": "remove",
      "path": "/shapes/com.digitalocean.api#SecretListItem/members/secret/traits/smithy.api#sensitive"
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#Secret/members/secret/traits/smithy.api#required",
      "value": {}
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#Secret/members/region/traits/smithy.api#required",
      "value": {}
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#Secret/members/version/traits/smithy.api#required",
      "value": {}
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#SecretListItem/members/secret/traits/smithy.api#required",
      "value": {}
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#Secret/members/values/traits/com.distilled.openapi#nullable",
      "value": {}
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#SecretValuesMap/value/traits",
      "value": {
        "smithy.api#sensitive": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#SecurityCreateSecretRequestValuesMap/value/traits",
      "value": {
        "smithy.api#sensitive": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#SecurityUpdateSecretRequestValuesMap/value/traits",
      "value": {
        "smithy.api#sensitive": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#SecretPendingDeletion",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 409,
          "smithy.api#documentation": "The secret is pending deletion (409 `conflict`): restore it, or wait for it to be purged.",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 409,
              "message": {
                "includes": "conflict with the current state"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#SecurityCreateSecret/errors/-",
      "value": {
        "target": "com.digitalocean.api#SecretPendingDeletion"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#SecurityDeleteSecret/errors/-",
      "value": {
        "target": "com.digitalocean.api#SecretPendingDeletion"
      }
    }
  ]
}
