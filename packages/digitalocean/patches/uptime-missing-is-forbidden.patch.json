{
  "description": "The uptime check and alert endpoints answer a missing id with 403 `{\"id\":\"forbidden\",\"message\":\"you are not authorized to access this resource\"}` instead of 404 (live response: GET /v2/uptime/checks/00000000-0000-0000-0000-000000000000 with a full-access token). Type it as UptimeCheckNotFound so callers treat it as gone without treating every 403 as missing.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#UptimeCheckNotFound",
      "value": {
        "type": "structure",
        "members": {},
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 403,
          "smithy.api#documentation": "The uptime check (or its alert) does not exist. The uptime API answers 403 `forbidden` / `you are not authorized to access this resource` for an id it does not know, where other DigitalOcean APIs answer 404.",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 403,
              "message": {
                "includes": "not authorized to access this resource"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#UptimeGetCheck/errors/-",
      "value": {
        "target": "com.digitalocean.api#UptimeCheckNotFound"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#UptimeUpdateCheck/errors/-",
      "value": {
        "target": "com.digitalocean.api#UptimeCheckNotFound"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#UptimeDeleteCheck/errors/-",
      "value": {
        "target": "com.digitalocean.api#UptimeCheckNotFound"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#UptimeGetCheckState/errors/-",
      "value": {
        "target": "com.digitalocean.api#UptimeCheckNotFound"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.digitalocean.api#UptimeListAlerts/errors/-",
      "value": {
        "target": "com.digitalocean.api#UptimeCheckNotFound"
      }
    },
    {
