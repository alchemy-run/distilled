{
  "openapi": "3.0.3",
  "info": {
    "title": "DigitalOcean Functions (OpenWhisk)",
    "version": "v1",
    "description": "The OpenWhisk REST API each DigitalOcean Functions namespace serves at its `api_host`. Authenticate with HTTP basic auth: the namespace's `uuid` as the user and its `key` as the password, both returned by `POST /v2/functions/namespaces`. Source: https://github.com/apache/openwhisk/blob/master/core/controller/src/main/resources/apiv1swagger.json"
  },
  "servers": [
    {
      "url": "https://{api_host}"
    }
  ],
  "paths": {
    "/api/v1/namespaces/{namespace}/actions": {
      "get": {
        "operationId": "listActions",
        "summary": "List the actions in a namespace.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The namespace (`fn-<uuid>`) the API returned for the Functions namespace."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/action"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/namespaces/{namespace}/actions/{action_name}": {
      "get": {
        "operationId": "getAction",
        "summary": "Get an action, with its code.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The namespace (`fn-<uuid>`) the API returned for the Functions namespace."
          },
          {
            "name": "action_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Action name, optionally `package/name`."
          },
          {
            "name": "code",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/action"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "putAction",
        "summary": "Create or update an action.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The namespace (`fn-<uuid>`) the API returned for the Functions namespace."
          },
          {
            "name": "action_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Action name, optionally `package/name`."
          },
          {
            "name": "overwrite",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/actionPut"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/action"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "413": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteAction",
        "summary": "Delete an action.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The namespace (`fn-<uuid>`) the API returned for the Functions namespace."
          },
          {
            "name": "action_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Action name, optionally `package/name`."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/action"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "invokeAction",
        "summary": "Invoke an action. With `blocking=true` the call waits up to 60 seconds for the activation.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The namespace (`fn-<uuid>`) the API returned for the Functions namespace."
          },
          {
            "name": "action_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Action name, optionally `package/name`."
          },
          {
            "name": "blocking",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "result",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/activation"
                }
              }
            }
          },
          "202": {
            "description": "Accepted: the activation is still running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/activationId"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "502": {
            "description": "The action failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/activation"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/namespaces/{namespace}/activations": {
      "get": {
        "operationId": "listActivations",
        "summary": "List recent activations.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The namespace (`fn-<uuid>`) the API returned for the Functions namespace."
          },
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "docs",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/activation"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/namespaces/{namespace}/activations/{activation_id}": {
      "get": {
        "operationId": "getActivation",
        "summary": "Get an activation's result and logs.",
        "parameters": [
          {
            "name": "namespace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The namespace (`fn-<uuid>`) the API returned for the Functions namespace."
          },
          {
            "name": "activation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/activation"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "keyValue": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {}
        }
      },
      "exec": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "Runtime, e.g. `nodejs:18`, `python:3.11`, `go:1.20`, or `blackbox`."
          },
          "code": {
            "type": "string",
            "description": "Source, or a base64 zip when `binary` is true."
          },
          "binary": {
            "type": "boolean"
          },
          "main": {
            "type": "string",
            "description": "Entry function name. Default `main`."
          },
          "image": {
            "type": "string"
          }
        }
      },
      "limits": {
        "type": "object",
        "properties": {
          "timeout": {
            "type": "integer",
            "description": "Milliseconds."
          },
          "memory": {
            "type": "integer",
            "description": "MiB."
          },
          "logs": {
            "type": "integer",
            "description": "KiB."
          }
        }
      },
      "actionPut": {
        "type": "object",
        "required": [
          "exec"
        ],
        "properties": {
          "exec": {
            "$ref": "#/components/schemas/exec"
          },
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/keyValue"
            }
          },
          "annotations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/keyValue"
            }
          },
          "limits": {
            "$ref": "#/components/schemas/limits"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "action": {
        "type": "object",
        "required": [
          "name",
          "namespace",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "publish": {
            "type": "boolean"
          },
          "exec": {
            "$ref": "#/components/schemas/exec"
          },
          "parameters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/keyValue"
            }
          },
          "annotations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/keyValue"
            }
          },
          "limits": {
            "$ref": "#/components/schemas/limits"
          },
          "updated": {
            "type": "integer"
          }
        }
      },
      "activationId": {
        "type": "object",
        "required": [
          "activationId"
        ],
        "properties": {
          "activationId": {
            "type": "string"
          }
        }
      },
      "activationResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "statusCode": {
            "type": "integer"
          },
          "success": {
            "type": "boolean"
          },
          "result": {}
        }
      },
      "activation": {
        "type": "object",
        "properties": {
          "activationId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "namespace": {
            "type": "string"
          },
          "start": {
            "type": "integer"
          },
          "end": {
            "type": "integer"
          },
          "duration": {
            "type": "integer"
          },
          "logs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "response": {
            "$ref": "#/components/schemas/activationResponse"
          }
        }
      }
    }
  }
}