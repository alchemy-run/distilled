      "path": "/shapes/com.boat.api#SetFilePermissions/errors/-",
      "value": {
        "target": "com.boat.api#FileNotFound"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.boat.api#ReplaceInFiles/errors/-",
      "value": {
        "target": "com.boat.api#FileNotFound"
      }
    }
  ]
}
