{
  "description": "Stream attachCommand's output. GET /sandboxes/{sandboxId}/commands/{processId}/stream answers 200 application/x-ndjson with one CommandAttachFrame per line (the spec's own components.schemas.CommandAttachFrame), but the converter reads only application/json bodies, so the operation generated with an empty output. The frame shape is transcribed from that schema; the output member carries com.distilled#ndjsonStream, so the SDK delivers the lines as a Stream of CommandAttachFrame as the server writes them. @boatdev/sdk's followCommand reads the same stream.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.boat.api#CommandAttachFrameType",
      "value": {
        "type": "enum",
        "members": {
          "ATTACHED": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "attached" }
          },
          "STDOUT": { "target": "smithy.api#Unit", "traits": { "smithy.api#enumValue": "stdout" } },
          "STDERR": { "target": "smithy.api#Unit", "traits": { "smithy.api#enumValue": "stderr" } },
          "HEARTBEAT": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "heartbeat" }
          },
          "EXIT": { "target": "smithy.api#Unit", "traits": { "smithy.api#enumValue": "exit" } },
          "RECONNECT": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "reconnect" }
          },
          "ERROR": { "target": "smithy.api#Unit", "traits": { "smithy.api#enumValue": "error" } }
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.boat.api#CommandAttachFrameStatus",
      "value": {
        "type": "enum",
        "members": {
          "RUNNING": {
            "target": "smithy.api#Unit",
            "traits": { "smithy.api#enumValue": "running" }
          },
          "EXITED": { "target": "smithy.api#Unit", "traits": { "smithy.api#enumValue": "exited" } },
          "LOST": { "target": "smithy.api#Unit", "traits": { "smithy.api#enumValue": "lost" } }
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.boat.api#CommandAttachFrame",
      "value": {
        "type": "structure",
        "members": {
          "type": {
            "target": "com.boat.api#CommandAttachFrameType",
            "traits": { "smithy.api#required": {} }
          },
          "processId": { "target": "smithy.api#Integer" },
          "data": { "target": "smithy.api#String" },
          "nextOffset": { "target": "smithy.api#Integer" },
          "stdoutOffset": { "target": "smithy.api#Integer" },
          "stderrOffset": { "target": "smithy.api#Integer" },
          "status": { "target": "com.boat.api#CommandAttachFrameStatus" },
          "exitCode": {
            "target": "smithy.api#Integer",
            "traits": { "com.distilled.openapi#nullable": {} }
          },
          "signal": {
            "target": "smithy.api#String",
            "traits": { "com.distilled.openapi#nullable": {} }
          },
          "error": { "target": "smithy.api#String" },
          "message": { "target": "smithy.api#String" }
        },
        "traits": {
          "smithy.api#documentation": "One line of `GET /sandboxes/{sandboxId}/commands/{processId}/stream` (application/x-ndjson).\n- `attached`: first line. `processId`, `stdoutOffset`, `stderrOffset` (where the output starts).\n- `stdout` / `stderr`: a chunk. `data`, and `nextOffset` for that stream.\n- `heartbeat`: sent after 15 s with no other line.\n- `exit`: last line when the command ended and all its output was sent. `status`, `exitCode`, `signal`, `stdoutOffset`, `stderrOffset`.\n- `reconnect`: last line after 10 minutes. Open the stream again with its `stdoutOffset` and `stderrOffset`. Nothing is lost or repeated.\n- `error`: last line on a failure. `error`, `message`, `stdoutOffset`, `stderrOffset`."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.boat.api#AttachCommandResponse",
      "value": {
        "type": "structure",
        "members": {
          "frames": {
            "target": "com.boat.api#CommandAttachFrame",
            "traits": {
              "smithy.api#required": {},
              "smithy.api#httpPayload": {},
              "com.distilled#ndjsonStream": {},
              "smithy.api#documentation": "The output stream, one frame per line, as the command writes it. It ends after an `exit`, `reconnect` or `error` frame."
            }
          }
        }
      }
    },
    {
      "op": "replace",
      "path": "/shapes/com.boat.api#AttachCommand/output/target",
      "value": "com.boat.api#AttachCommandResponse"
    }
  ]
}
