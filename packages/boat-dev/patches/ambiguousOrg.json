{
  "description": "Type the 409 `ambiguous_org` that calls selecting an organization by name get when two of the caller's organizations share that name. The spec documents it on the shared `org` query parameter (\"Two organizations sharing the name answer `409 ambiguous_org` and need the id\"; `X-Boat-Org` is \"Same as the `org` query parameter\") and on PATCH /orgs/active's 409 response, but every failure body is the shared ErrorEnvelope, so all of them generated as one Conflict. Added to every operation that takes `org` or `X-Boat-Org`, plus setActiveOrganization. Source: spec-mirror-boat-dev 71ab00f, components.parameters.OrgId.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.boat.api#AmbiguousOrg",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 409,
          "smithy.api#documentation": "Several of the caller's organizations share the name passed as `org` / `X-Boat-Org`. Pass the organization id (`team_…`) instead.",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 409,
              "body": {
                "/code": "ambiguous_org"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.boat.api#SetActiveOrganization/errors/-",
      "value": {
        "target": "com.boat.api#AmbiguousOrg"
      }
    },
    {
