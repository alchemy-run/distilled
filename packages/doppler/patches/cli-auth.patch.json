{
  "description": "Browser login endpoints used by the official Doppler CLI (https://github.com/DopplerHQ/cli/blob/master/pkg/http/api.go and pkg/cmd/login.go). The polling code and issued token are sensitive; 409 means browser authorization is still pending.",
  "patches": [
    {
      "op": "add",
      "path": "/paths/~1v3~1auth~1cli~1generate~12",
      "value": {
        "get": {
          "operationId": "generateCliAuth",
          "description": "Doppler CLI browser authentication. Public endpoint; no bearer token required. Wire contract from DopplerHQ/cli pkg/http/api.go.",
          "security": [],
          "responses": {
            "200": {
              "description": "Success",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": ["code", "polling_code", "auth_url"],
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "polling_code": {
                        "type": "string",
                        "x-sensitive": true
                      },
                      "auth_url": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "parameters": [
            {
              "in": "query",
              "name": "hostname",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "version",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "CLI version in vMAJOR.MINOR.PATCH format. Other formats, including prerelease suffixes, are rejected."
            },
            {
              "in": "query",
              "name": "os",
              "required": true,
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "arch",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ]
        }
      }
    },
    {
      "op": "add",
      "path": "/paths/~1v3~1auth~1cli~1authorize",
      "value": {
        "post": {
          "operationId": "authorizeCliAuth",
          "description": "Doppler CLI browser authentication. Public endpoint; no bearer token required. Wire contract from DopplerHQ/cli pkg/http/api.go.",
          "security": [],
          "responses": {
            "200": {
              "description": "Success",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": ["token", "name", "dashboard_url"],
                    "properties": {
                      "token": {
                        "type": "string",
                        "x-sensitive": true
                      },
                      "name": {
                        "type": "string"
                      },
                      "dashboard_url": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "409": {
              "description": "Authorization pending browser approval",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "messages": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["code"],
                  "properties": {
                    "code": {
                      "type": "string",
                      "x-sensitive": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "op": "add",
      "path": "/paths/~1v3~1auth~1cli~1revoke",
      "value": {
        "post": {
          "operationId": "revokeCliAuth",
          "description": "Doppler CLI browser authentication. Public endpoint; no bearer token required. Wire contract from DopplerHQ/cli pkg/http/api.go.",
          "security": [],
          "responses": {
            "200": {
              "description": "Success",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "required": [],
                    "properties": {}
                  }
                }
              }
            }
          },
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["token"],
                  "properties": {
                    "token": {
                      "type": "string",
                      "x-sensitive": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
