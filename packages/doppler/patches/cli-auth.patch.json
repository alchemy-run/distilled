{
  "description": "Browser login endpoints used by the official Doppler CLI (https://github.com/DopplerHQ/cli/blob/master/pkg/http/api.go and pkg/cmd/login.go). The polling code and issued token are sensitive; 409 means browser authorization is still pending.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#Doppler/operations/-",
      "value": {
        "target": "com.doppler.api#GenerateCliAuth"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#Doppler/operations/-",
      "value": {
        "target": "com.doppler.api#AuthorizeCliAuth"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#Doppler/operations/-",
      "value": {
        "target": "com.doppler.api#RevokeCliAuth"
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#GenerateCliAuthRequest",
      "value": {
        "type": "structure",
        "members": {
          "hostname": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#httpQuery": "hostname",
              "smithy.api#required": {}
            }
          },
          "version": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#httpQuery": "version",
              "smithy.api#required": {},
              "smithy.api#documentation": "CLI version in vMAJOR.MINOR.PATCH format. Other formats, including prerelease suffixes, are rejected."
            }
          },
          "os": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#httpQuery": "os",
              "smithy.api#required": {}
            }
          },
          "arch": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#httpQuery": "arch",
              "smithy.api#required": {}
            }
          }
        },
        "traits": {
          "smithy.api#input": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#GenerateCliAuthResponse",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#required": {}
            }
          },
          "polling_code": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#required": {},
              "smithy.api#sensitive": {}
            }
          },
          "auth_url": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#required": {}
            }
          }
        },
        "traits": {
          "smithy.api#output": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#GenerateCliAuth",
      "value": {
        "type": "operation",
        "input": {
          "target": "com.doppler.api#GenerateCliAuthRequest"
        },
        "output": {
          "target": "com.doppler.api#GenerateCliAuthResponse"
        },
        "traits": {
          "smithy.api#http": {
            "method": "GET",
            "uri": "/v3/auth/cli/generate/2",
            "code": 200
          },
          "smithy.api#documentation": "Doppler CLI browser authentication. Public endpoint; no bearer token required. Wire contract from DopplerHQ/cli pkg/http/api.go."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#AuthorizeCliAuthRequest",
      "value": {
        "type": "structure",
        "members": {
          "code": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#required": {},
              "smithy.api#sensitive": {}
            }
          }
        },
        "traits": {
          "smithy.api#input": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#AuthorizeCliAuthResponse",
      "value": {
        "type": "structure",
        "members": {
          "token": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#required": {},
              "smithy.api#sensitive": {}
            }
          },
          "name": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#required": {}
            }
          },
          "dashboard_url": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#required": {}
            }
          }
        },
        "traits": {
          "smithy.api#output": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#AuthorizeCliAuth",
      "value": {
        "type": "operation",
        "input": {
          "target": "com.doppler.api#AuthorizeCliAuthRequest"
        },
        "output": {
          "target": "com.doppler.api#AuthorizeCliAuthResponse"
        },
        "errors": [
          {
            "target": "com.doppler.api#Conflict"
          }
        ],
        "traits": {
          "smithy.api#http": {
            "method": "POST",
            "uri": "/v3/auth/cli/authorize",
            "code": 200
          },
          "smithy.api#documentation": "Doppler CLI browser authentication. Public endpoint; no bearer token required. Wire contract from DopplerHQ/cli pkg/http/api.go."
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#RevokeCliAuthRequest",
      "value": {
        "type": "structure",
        "members": {
          "token": {
            "target": "smithy.api#String",
            "traits": {
              "smithy.api#required": {},
              "smithy.api#sensitive": {}
            }
          }
        },
        "traits": {
          "smithy.api#input": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#RevokeCliAuthResponse",
      "value": {
        "type": "structure",
        "members": {
          "body": {
            "target": "smithy.api#Document",
            "traits": {
              "com.distilled.openapi#rawResponse": {},
              "smithy.api#required": {}
            }
          }
        },
        "traits": {
          "smithy.api#output": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#RevokeCliAuth",
      "value": {
        "type": "operation",
        "input": {
          "target": "com.doppler.api#RevokeCliAuthRequest"
        },
        "output": {
          "target": "com.doppler.api#RevokeCliAuthResponse"
        },
        "traits": {
          "smithy.api#http": {
            "method": "POST",
            "uri": "/v3/auth/cli/revoke",
            "code": 200
          },
          "smithy.api#documentation": "Doppler CLI browser authentication. Public endpoint; no bearer token required. Wire contract from DopplerHQ/cli pkg/http/api.go."
        }
      }
    }
  ]
}
