{
  "description": "A service account API token's `last_seen_at` is null until the token is first used: the create response's example is null, which left the property with no type, and GET /v3/me returned `\"last_seen_at\": null` live on 2026-10-13. `expires_at` is optional on create, and the spec's own description of that request field (POST /v3/workplace/service_accounts/service_account/{service_account}/tokens) says a token created without it remains valid indefinitely unless manually revoked, so the token has no expiry to report.",
  "patches": [
    {
      "op": "replace",
      "path": "/shapes/com.doppler.api#ServiceAccountTokensCreateResponseApiToken/members/last_seen_at",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "com.distilled.openapi#nullable": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#ServiceAccountTokensListResponseApiTokensItem/members/last_seen_at/traits",
      "value": {
        "com.distilled.openapi#nullable": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#ServiceAccountTokensGetResponseApiToken/members/last_seen_at/traits",
      "value": {
        "com.distilled.openapi#nullable": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#ServiceAccountTokensCreateResponseApiToken/members/expires_at/traits",
      "value": {
        "com.distilled.openapi#nullable": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#ServiceAccountTokensListResponseApiTokensItem/members/expires_at/traits",
      "value": {
        "com.distilled.openapi#nullable": {}
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.doppler.api#ServiceAccountTokensGetResponseApiToken/members/expires_at/traits",
      "value": {
        "com.distilled.openapi#nullable": {}
      }
    }
  ]
}
