{
  "description": "The secrets list (GET /v3/configs/config/secrets) declares each secret's rawVisibility and computedVisibility as an object with a `type` property, but its own example is the string \"masked\", and the single-secret endpoint (GET /v3/configs/config/secret) in the same spec declares them as a string (rawVisibility: enum unmasked/masked/restricted). Both endpoints return the same secret object (https://docs.doppler.com/reference/secrets-list), so the list copies get the single-secret schema.",
  "patches": [
    {
      "op": "replace",
      "path": "/paths/~1v3~1configs~1config~1secrets/get/responses/200/content/application~1json/schema/properties/secrets/properties/STRIPE/properties/rawVisibility",
      "value": {
        "type": "string",
        "enum": ["unmasked", "masked", "restricted"],
        "example": "masked"
      }
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1configs~1config~1secrets/get/responses/200/content/application~1json/schema/properties/secrets/properties/STRIPE/properties/computedVisibility",
      "value": {
        "type": "string",
        "example": "masked"
      }
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1configs~1config~1secrets/get/responses/200/content/application~1json/schema/properties/secrets/properties/ALGOLIA/properties/rawVisibility",
      "value": {
        "type": "string",
        "enum": ["unmasked", "masked", "restricted"],
        "example": "masked"
      }
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1configs~1config~1secrets/get/responses/200/content/application~1json/schema/properties/secrets/properties/ALGOLIA/properties/computedVisibility",
      "value": {
        "type": "string",
        "example": "masked"
      }
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1configs~1config~1secrets/get/responses/200/content/application~1json/schema/properties/secrets/properties/DATABASE/properties/rawVisibility",
      "value": {
        "type": "string",
        "enum": ["unmasked", "masked", "restricted"],
        "example": "masked"
      }
    },
    {
