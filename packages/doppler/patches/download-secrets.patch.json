{
  "description": "The download endpoint accepts a config-scoped Service Token without project/config query parameters, as documented at https://docs.doppler.com/reference/secrets-download. Its default JSON response is a dictionary of secret names to string values, not a structure limited to the four example keys in the upstream schema.",
  "patches": [
    {
      "op": "test",
      "path": "/paths/~1v3~1configs~1config~1secrets~1download/get/parameters/0/name",
      "value": "project"
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1configs~1config~1secrets~1download/get/parameters/0/required",
      "value": false
    },
    {
      "op": "test",
      "path": "/paths/~1v3~1configs~1config~1secrets~1download/get/parameters/1/name",
      "value": "config"
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1configs~1config~1secrets~1download/get/parameters/1/required",
      "value": false
    },
    {
      "op": "replace",
      "path": "/paths/~1v3~1configs~1config~1secrets~1download/get/responses/200/content/application~1json/schema",
      "value": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    }
  ]
}
