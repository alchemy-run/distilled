{
  "name": "@distilled.cloud/celld",
  "version": "1.0.0-rc.12",
  "repository": {
    "type": "git",
    "url": "https://github.com/alchemy-run/distilled",
    "directory": "packages/celld"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "module": "src/index.ts",
  "files": ["lib", "src"],
  "exports": {
    ".": { "types": "./lib/index.d.ts", "bun": "./src/index.ts", "worker": "./src/index.ts", "default": "./lib/index.js" },
    "./Endpoint": { "types": "./lib/endpoint.d.ts", "bun": "./src/endpoint.ts", "worker": "./src/endpoint.ts", "default": "./lib/endpoint.js" },
    "./Protocol": { "types": "./lib/protocol.d.ts", "bun": "./src/protocol.ts", "worker": "./src/protocol.ts", "default": "./lib/protocol.js" },
    "./Errors": { "types": "./lib/errors.d.ts", "bun": "./src/errors.ts", "worker": "./src/errors.ts", "default": "./lib/errors.js" },
    "./Services": { "types": "./lib/services/index.d.ts", "bun": "./src/services/index.ts", "worker": "./src/services/index.ts", "default": "./lib/services/index.js" },
    "./*": { "types": "./lib/services/*.d.ts", "bun": "./src/services/*.ts", "worker": "./src/services/*.ts", "default": "./lib/services/*.js" }
  },
  "scripts": {
    "build": "tsc -b",
    "convert": "bun scripts/convert.ts",
    "generate": "bun scripts/generate.ts",
    "typecheck": "tsc -p tsconfig.json --noCheck false",
    "test": "bun test test"
  },
  "dependencies": { "@distilled.cloud/core": "workspace:*" },
  "devDependencies": { "@types/bun": "catalog:", "@types/node": "catalog:", "@effect/platform-bun": "catalog:", "@distilled.cloud/aws": "workspace:*" },
  "peerDependencies": { "effect": "catalog:" }
}
