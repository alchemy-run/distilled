          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#httpError": 403,
          "smithy.api#documentation": "The feature is not available to this organization or service: its plan does not include it, it is not enabled for the organization, or it is not set up. The message says which.",
