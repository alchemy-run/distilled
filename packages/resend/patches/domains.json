{
  "description": "Domains and domain claims. createDomain carries `object: \"domain\"` (live). Response members are narrowed to what Resend returns: required where resend-node, the maintained official SDK, declares them non-optional and every live response (2026-10-29) carried them, and nullable where resend-node allows null or a live response held null. Domain claims follow resend-node alone, without a live check: a claim needs the domain held by a second team, a paid feature. A domain with no claim answers 404 \"Domain claim not found\", typed DomainClaimNotFound. Errors on these operations match Resend's error `name` and status; the classes shared with other areas are in shared.json.",
  "patches": [
    {
      "op": "add",
      "path": "/shapes/com.resend.api#CreateDomainResponse/members/object",
      "value": {
        "target": "smithy.api#String",
        "traits": {
          "smithy.api#documentation": "The object type, `domain`.",
          "smithy.api#required": {}
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.resend.api#DomainAlreadyRegistered",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The domain is registered to a Resend team already, maybe another one (403).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 403,
              "body": {
                "/name": "validation_error"
              },
              "message": {
                "includes": "has been registered already"
              }
            }
          ],
          "smithy.api#httpError": 403
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.resend.api#FreePublicDomain",
      "value": {
        "type": "structure",
        "members": {
          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "Resend refuses domains under free subdomain services (422 \"We don't allow free public domains\").",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 422,
              "body": {
                "/name": "validation_error"
              },
              "message": {
                "includes": "don't allow free public domains"
              }
            }
          ],
          "smithy.api#httpError": 422
        }
      }
    },
    {
      "op": "add",
      "path": "/shapes/com.resend.api#DomainNotFound",
      "value": {
        "type": "structure",
