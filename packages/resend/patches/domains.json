          "message": {
            "target": "smithy.api#String"
          }
        },
        "traits": {
          "smithy.api#error": "client",
          "smithy.api#documentation": "The domain does not exist (404 `not_found`).",
          "com.distilled.openapi#errorMatchers": [
            {
              "status": 404,
              "body": {
                "/name": "not_found"
              }
            },
            {
              "status": 404,
              "body": {
                "/name": "not_found"
              },
              "message": {
                "includes": "Domain not found"
              }
            }
