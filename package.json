{
  "name": "distilled-v1",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "generate": "node --conditions=bun scripts/generate-all.ts",
    "specs:sync": "git submodule sync && git submodule update --force --init --depth=1",
    "specs:local": "node --conditions=bun scripts/specs.ts local",
    "specs:link": "node --conditions=bun scripts/specs.ts link",
    "specs:check": "node --conditions=bun scripts/specs.ts check",
    "patches:audit": "node --conditions=bun scripts/patches.ts audit",
    "typecheck": "tsc -b",
    "bench": "pnpm bench:runtime && pnpm bench:bundle && pnpm bench:typecheck",
    "bench:runtime": "node --conditions=bun benches/runtime/run.ts",
    "bench:runtime:record": "node --conditions=bun benches/runtime/run.ts --record",
    "bench:bundle": "node --conditions=bun benches/bundle/run.ts",
    "bench:typecheck": "node --conditions=bun benches/typecheck/run.ts",
    "bench:typecheck:record": "node --conditions=bun benches/typecheck/run.ts --record",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint -c oxlint.config.ts",
    "prepare": "husky",
    "publish:packages": "pnpm publish --recursive --filter './packages/*' --access public",
    "typecheck:ci": "tsc -b --noCheck false"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "changelogithub": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "24",
        "onFail": "warn"
      }
    ]
  },
  "packageManager": "pnpm@12.9.1"
}
