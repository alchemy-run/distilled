{
  "name": "distilled-v1",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "generate": "node scripts/generate-all.ts",
    "specs:sync": "git submodule sync && git submodule update --force --init --depth=1",
    "specs:local": "node scripts/specs.ts local",
    "specs:link": "node scripts/specs.ts link",
    "specs:check": "node scripts/specs.ts check",
    "patches:audit": "node scripts/patches.ts audit",
    "typecheck": "tsc -b",
    "bench": "pnpm bench:runtime && pnpm bench:bundle && pnpm bench:typecheck",
    "bench:runtime": "node --conditions=bun benches/runtime/run.ts",
    "bench:runtime:record": "node --conditions=bun benches/runtime/run.ts --record",
    "bench:bundle": "node benches/bundle/run.ts",
    "bench:typecheck": "node benches/typecheck/run.ts",
    "bench:typecheck:record": "node benches/typecheck/run.ts --record",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint -c oxlint.config.ts",
    "prepare": "husky",
    "typecheck:ci": "tsc -b --noCheck false",
    "validate:publish-packages": "node scripts/validate-publish-packages.ts"
  },
  "devDependencies": {
    "@alchemy.run/pkg": "2.0.0-beta.81",
    "@effect/platform-node": "catalog:",
    "@types/node": "catalog:",
    "changelogithub": "catalog:",
    "effect": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "node",
        "version": "24",
        "onFail": "warn"
      }
    ]
  },
  "packageManager": "pnpm@12.9.1"
}
