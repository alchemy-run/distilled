{
  "name": "distilled-v1",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "generate": "bun scripts/generate-all.ts",
    "specs:sync": "git submodule sync && git submodule update --force --init --depth=1",
    "specs:local": "bun scripts/specs.ts local",
    "specs:link": "bun scripts/specs.ts link",
    "specs:check": "bun scripts/specs.ts check",
    "typecheck": "tsc -b",
    "bench": "pnpm bench:runtime && pnpm bench:bundle && pnpm bench:typecheck",
    "bench:runtime": "bun benches/runtime/run.ts",
    "bench:runtime:record": "bun benches/runtime/run.ts --record",
    "bench:bundle": "bun benches/bundle/run.ts",
    "bench:typecheck": "bun benches/typecheck/run.ts",
    "bench:typecheck:record": "bun benches/typecheck/run.ts --record",
    "format": "oxfmt '.'",
    "format:check": "oxfmt '.' --check",
    "lint": "oxlint",
    "prepare": "husky",
    "publish:packages": "pnpm publish --recursive --filter './packages/*' --access public",
    "typecheck:ci": "tsc -b --noCheck false"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "changelogithub": "catalog:"
  },
  "packageManager": "pnpm@11.21.0",
  "devEngines": {
    "runtime": [
      {
        "name": "bun",
        "version": "1.3.13",
        "onFail": "warn"
      },
      {
        "name": "node",
        "version": "24",
        "onFail": "warn"
      }
    ]
  }
}
